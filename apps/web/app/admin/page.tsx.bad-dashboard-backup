"use client";

import { useEffect, useMemo, useState } from "react";
import SiteHeader from "../../components/SiteHeader";
import AdminSidebar from "./components/AdminSidebar";
import {
  Activity,
  ArrowUpRight,
  BookOpen,
  CalendarClock,
  CheckCircle2,
  Clock3,
  Database,
  FilePlus2,
  RefreshCw,
  ShieldCheck,
  Users,
} from "lucide-react";
import { apiFetch } from "../lib/api";

type Loan = {
  id: number;
  status?: string;
  borrowedAt?: string;
  dueDate?: string;
  returnedAt?: string;
  createdAt?: string;
  user?: {
    fullName?: string;
    email?: string;
  };
  bookCopy?: {
    barcode?: string;
    book?: {
      title?: string;
      isbn?: string;
    };
  };
  book?: {
    title?: string;
  };
};

type Reservation = {
  id: number;
  status?: string;
  createdAt?: string;
  user?: {
    fullName?: string;
  };
  book?: {
    title?: string;
  };
};

type DashboardData = {
  totalBooks: number;
  totalMembers: number;
  activeLoans: number;
  pendingLoans: number;
  overdueLoans: number;
  returnedLoans: number;
  totalLoans: number;
  loans: Loan[];
  reservations: Reservation[];
};

const emptyData: DashboardData = {
  totalBooks: 0,
  totalMembers: 0,
  activeLoans: 0,
  pendingLoans: 0,
  overdueLoans: 0,
  returnedLoans: 0,
  totalLoans: 0,
  loans: [],
  reservations: [],
};

function formatNumber(value: number) {
  return new Intl.NumberFormat("id-ID").format(value);
}

function formatDate(value?: string) {
  if (!value) return "—";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "—";
  }

  return new Intl.DateTimeFormat("id-ID", {
    day: "numeric",
    month: "short",
    year: "numeric",
  }).format(date);
}

function relativeDate(value?: string) {
  if (!value) return "";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "";
  }

  const diff =
    Math.floor(
      (Date.now() - date.getTime()) /
        (1000 * 60 * 60 * 24),
    );

  if (diff <= 0) return "Hari ini";
  if (diff === 1) return "Kemarin";
  if (diff < 7) return `${diff} hari lalu`;

  return formatDate(value);
}

function getBookTitle(loan: Loan) {
  return (
    loan.bookCopy?.book?.title ??
    loan.book?.title ??
    "Buku"
  );
}

function getUserName(loan: Loan) {
  return loan.user?.fullName ?? "Pengguna";
}

function getReservationTitle(reservation: Reservation) {
  return reservation.book?.title ?? "Buku";
}

function statusLabel(status?: string) {
  switch (status) {
    case "ACTIVE":
      return "Aktif";
    case "OVERDUE":
      return "Terlambat";
    case "RETURNED":
      return "Dikembalikan";
    case "PENDING":
      return "Menunggu";
    case "CANCELLED":
      return "Dibatalkan";
    case "REJECTED":
      return "Ditolak";
    case "PICKED_UP":
      return "Diambil";
    case "APPROVED":
      return "Disetujui";
    default:
      return status ?? "—";
  }
}

function statusClass(status?: string) {
  switch (status) {
    case "ACTIVE":
      return "blue";
    case "OVERDUE":
      return "red";
    case "RETURNED":
      return "green";
    case "PENDING":
      return "amber";
    default:
      return "gray";
  }
}

export default function AdminDashboardPage() {
  const [data, setData] =
    useState<DashboardData>(emptyData);

  const [loading, setLoading] =
    useState(true);

  const [error, setError] =
    useState("");

  async function loadDashboard() {
    setLoading(true);
    setError("");

    try {
      const [
        booksResponse,
        membersResponse,
        statisticsResponse,
        loansResponse,
        reservationsResponse,
      ] = await Promise.all([
        apiFetch("/books?limit=1&page=1"),
        apiFetch("/members"),
        apiFetch("/loans/statistics"),
        apiFetch("/loans?limit=10&page=1&sortBy=createdAt&order=desc"),
        apiFetch("/reservations"),
      ]);

      if (
        !booksResponse.ok ||
        !membersResponse.ok ||
        !statisticsResponse.ok ||
        !loansResponse.ok ||
        !reservationsResponse.ok
      ) {
        throw new Error(
          "Sebagian data dashboard gagal dimuat.",
        );
      }

      const booksJson =
        await booksResponse.json();

      const membersJson =
        await membersResponse.json();

      const statisticsJson =
        await statisticsResponse.json();

      const loansJson =
        await loansResponse.json();

      const reservationsJson =
        await reservationsResponse.json();

      const loans =
        Array.isArray(loansJson)
          ? loansJson
          : Array.isArray(loansJson?.data)
            ? loansJson.data
            : [];

      const reservations =
        Array.isArray(reservationsJson)
          ? reservationsJson
          : Array.isArray(reservationsJson?.data)
            ? reservationsJson.data
            : [];

      setData({
        totalBooks:
          booksJson?.pagination?.total ??
          booksJson?.total ??
          0,

        totalMembers:
          Array.isArray(membersJson)
            ? membersJson.length
            : membersJson?.pagination?.total ??
              membersJson?.total ??
              0,

        activeLoans:
          statisticsJson?.active ?? 0,

        pendingLoans:
          statisticsJson?.pending ?? 0,

        overdueLoans:
          statisticsJson?.overdue ?? 0,

        returnedLoans:
          statisticsJson?.returned ?? 0,

        totalLoans:
          statisticsJson?.total ?? 0,

        loans,

        reservations:
          reservations.slice(0, 6),
      });
    } catch (err) {
      console.error(
        "Admin dashboard error:",
        err,
      );

      setError(
        err instanceof Error
          ? err.message
          : "Gagal memuat dashboard.",
      );
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadDashboard();
  }, []);

  const chart = useMemo(() => {
    const now = new Date();

    const days = Array.from(
      { length: 7 },
      (_, index) => {
        const date = new Date(now);

        date.setHours(0, 0, 0, 0);
        date.setDate(
          now.getDate() -
            (6 - index),
        );

        const key =
          date.toISOString().slice(0, 10);

        const count =
          data.loans.filter((loan) => {
            const source =
              loan.createdAt ??
              loan.borrowedAt;

            if (!source) return false;

            const loanDate =
              new Date(source)
                .toISOString()
                .slice(0, 10);

            return loanDate === key;
          }).length;

        return {
          key,
          count,
          label:
            new Intl.DateTimeFormat(
              "id-ID",
              {
                weekday: "short",
              },
            ).format(date),
        };
      },
    );

    const max = Math.max(
      ...days.map((day) => day.count),
      1,
    );

    return {
      days,
      max,
      total: days.reduce(
        (sum, day) =>
          sum + day.count,
        0,
      ),
    };
