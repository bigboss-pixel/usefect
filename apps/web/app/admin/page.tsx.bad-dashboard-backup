    const width = 700;
    const height = 150;

    return chart.days.map(
      (day, index) => {
        const x =
          chart.days.length === 1
            ? width / 2
            : (index /
                (chart.days.length - 1)) *
              width;

        const y =
          height -
          15 -
          (day.count /
            chart.max) *
            (height - 35);

        return {
          ...day,
          x,
          y,
        };
      },
    );
  }, [chart]);

