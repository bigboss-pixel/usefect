                />
                {refreshing ? "Memuat..." : "Refresh"}
              </button>
            </section>

            {error && (
              <div className="admin-dashboard-alert">
                <AlertTriangle size={17} />
                <span>{error}</span>
              </div>
            )}

            <section className="admin-dashboard-kpi-grid">
              <article className="admin-dashboard-kpi">
                <div className="admin-dashboard-kpi-icon blue">
                  <BookOpen size={21} />
                </div>

                <div className="admin-dashboard-kpi-body">
                  <span>Total Koleksi</span>
                  <strong>
                    {loading
                      ? "—"
                      : formatNumber(data.totalBooks)}
                  </strong>
                  <small>Judul buku terdaftar</small>
                </div>

                <ArrowUpRight size={17} />
              </article>

              <article className="admin-dashboard-kpi">
                <div className="admin-dashboard-kpi-icon violet">
                  <Users size={21} />
                </div>

                <div className="admin-dashboard-kpi-body">
                  <span>Total Anggota</span>
                  <strong>
                    {loading
                      ? "—"
                      : formatNumber(data.totalMembers)}
                  </strong>
                  <small>Anggota non-administratif</small>
                </div>

                <ArrowUpRight size={17} />
              </article>

              <article className="admin-dashboard-kpi">
                <div className="admin-dashboard-kpi-icon green">
                  <ClipboardList size={21} />
                </div>

                <div className="admin-dashboard-kpi-body">
                  <span>Peminjaman Aktif</span>
                  <strong>
                    {loading
                      ? "—"
                      : formatNumber(data.activeLoans)}
                  </strong>
                  <small>
                    {formatNumber(data.overdueLoans)} terlambat
                  </small>
                </div>

                <ArrowUpRight size={17} />
              </article>

              <article className="admin-dashboard-kpi">
                <div className="admin-dashboard-kpi-icon orange">
                  <CalendarClock size={21} />
                </div>

                <div className="admin-dashboard-kpi-body">
                  <span>Reservasi</span>
                  <strong>
                    {loading
                      ? "—"
                      : formatNumber(data.reservations)}
                  </strong>
                  <small>
                    {formatNumber(data.pendingReservations)} menunggu
                  </small>
                </div>

                <ArrowUpRight size={17} />
              </article>
            </section>

            <section className="admin-dashboard-main-grid">
              <article className="admin-dashboard-panel admin-dashboard-loan-panel">
                <div className="admin-dashboard-panel-heading">
                  <div>
                    <span className="admin-dashboard-panel-label">
                      TRANSACTION OVERVIEW
                    </span>
                    <h2>Statistik Peminjaman</h2>
                    <p>
                      Ringkasan status transaksi perpustakaan.
                    </p>
                  </div>

                  <div className="admin-dashboard-panel-icon">
                    <Activity size={19} />
                  </div>
                </div>

                <div className="admin-dashboard-trend-clean">
                  <div className="admin-dashboard-chart-meta">
                    <div>
                      <strong>
                        {loading
                          ? "—"
                          : formatNumber(loanTrend.total)}
                      </strong>
                      <span>transaksi dalam 7 hari terakhir</span>
                    </div>

                    <div className="admin-dashboard-chart-peak">
                      <span>Puncak aktivitas</span>
                      <strong>
                        {loading
                          ? "—"
                          : `${loanTrend.peak.label} · ${loanTrend.peak.count}`}
                      </strong>
                    </div>
                  </div>

                  <div className="admin-dashboard-line-chart">
                    <div className="admin-dashboard-chart-grid-line line-1" />
                    <div className="admin-dashboard-chart-grid-line line-2" />
                    <div className="admin-dashboard-chart-grid-line line-3" />
                    <div className="admin-dashboard-chart-grid-line line-4" />

                    <svg
                      viewBox="0 0 720 190"
                      preserveAspectRatio="none"
                      className="admin-dashboard-chart-svg"
                      aria-label="Tren peminjaman 7 hari terakhir"
                    >
                      <defs>
                        <linearGradient
                          id="loanAreaGradient"
                          x1="0"
                          y1="0"
                          x2="0"
                          y2="1"
                        >
                          <stop
                            offset="0%"
                            stopColor="#2563eb"
                            stopOpacity="0.18"
                          />
                          <stop
                            offset="100%"
                            stopColor="#2563eb"
                            stopOpacity="0"
                          />
                        </linearGradient>
                      </defs>

                      <path
                        d={loanAreaPath}
                        fill="url(#loanAreaGradient)"
                      />

                      <path
                        d={loanLinePath}
                        fill="none"
                        stroke="#2563eb"
                        strokeWidth="3"
                        strokeLinecap="round"
                        strokeLinejoin="round"
                      />

                      {loanChartPoints.map((point) => (
                        <circle
                          key={point.key}
                          cx={point.x}
                          cy={point.y}
                          r="4.5"
                          fill="#ffffff"
                          stroke="#2563eb"
                          strokeWidth="2.5"
                        />
                      ))}
                    </svg>

                    <div className="admin-dashboard-chart-labels">
                      {loanChartPoints.map((point) => (
                        <span key={point.key}>
                          {point.label}
                        </span>
                      ))}
                    </div>
                  </div>

                  <div className="admin-dashboard-trend-stats">
                    <div>
                      <span>
                        <i className="dot active" />
                        Aktif
                      </span>
                      <strong>{data.activeLoans}</strong>
                    </div>

                    <div>
                      <span>
                        <i className="dot overdue" />
                        Terlambat
                      </span>
                      <strong>{data.overdueLoans}</strong>
                    </div>

                    <div>
                      <span>
                        <i className="dot pending" />
                        Pending
                      </span>
                      <strong>{data.pendingLoans}</strong>
                    </div>

                    <div>
                      <span>
                        <i className="dot returned" />
                        Dikembalikan
                      </span>
                      <strong>{data.returnedLoans}</strong>
                    </div>
                  </div>
                </div>
              </article>

              <article className="admin-dashboard-panel">
                <div className="admin-dashboard-panel-heading">
                  <div>
                    <span className="admin-dashboard-panel-label">
                      COLLECTION
                    </span>
                    <h2>Status Transaksi</h2>
                    <p>
                      Distribusi transaksi berdasarkan status.
                    </p>
                  </div>

                  <div className="admin-dashboard-panel-icon">
                    <BookOpen size={19} />
                  </div>
                </div>

                <div className="admin-dashboard-progress-list">
                  <div>
                    <div>
                      <span>Aktif</span>
                      <strong>
                        {collectionStatus.activePercent}%
                      </strong>
                    </div>

                    <div className="admin-dashboard-progress-track">
                      <span
                        style={{
                          width: `${collectionStatus.activePercent}%`,
                        }}
                      />
                    </div>
                  </div>

                  <div>
                    <div>
                      <span>Dikembalikan</span>
                      <strong>
                        {collectionStatus.returnedPercent}%
                      </strong>
                    </div>

                    <div className="admin-dashboard-progress-track returned">
                      <span
                        style={{
                          width: `${collectionStatus.returnedPercent}%`,
                        }}
                      />
                    </div>
                  </div>

                  <div className="admin-dashboard-mini-grid">
                    <div>
                      <small>Pending</small>
                      <strong>{data.pendingLoans}</strong>
                    </div>

                    <div>
                      <small>Overdue</small>
                      <strong>{data.overdueLoans}</strong>
                    </div>

                    <div>
                      <small>Returned</small>
                      <strong>{data.returnedLoans}</strong>
                    </div>
                  </div>
                </div>
              </article>
            </section>

            <section className="admin-dashboard-lower-grid">
              <article className="admin-dashboard-panel admin-dashboard-activity-panel">
                <div className="admin-dashboard-panel-heading">
                  <div>
                    <span className="admin-dashboard-panel-label">
                      RECENT ACTIVITY
                    </span>
                    <h2>Aktivitas Terbaru</h2>
                    <p>
                      Transaksi peminjaman terakhir di sistem.
                    </p>
                  </div>

                  <a href="/admin/peminjaman/kelola">
                    Lihat semua
                    <ArrowUpRight size={15} />
                  </a>
                </div>

                <div className="admin-dashboard-activity-list">
                  {loading ? (
                    <div className="admin-dashboard-empty">
                      Memuat aktivitas...
                    </div>
                  ) : data.recentLoans.length === 0 ? (
                    <div className="admin-dashboard-empty">
                      Belum ada aktivitas peminjaman.
                    </div>
                  ) : (
                    data.recentLoans.map((loan, index) => (
                      <div
                        className="admin-dashboard-activity-item"
                        key={loan.id ?? index}
                      >
                        <div className="admin-dashboard-activity-icon">
                          <ClipboardList size={17} />
                        </div>

                        <div className="admin-dashboard-activity-main">
                          <strong>
                            {getLoanTitle(loan)}
                          </strong>
                          <span>
                            {getLoanUser(loan)} ·{" "}
                            {statusLabel(loan.status)}
                          </span>
                        </div>

                        <time>
                          {formatRelativeDate(loan.createdAt)}
                        </time>
                      </div>
                    ))
                  )}
                </div>
              </article>

              <article className="admin-dashboard-panel">
                <div className="admin-dashboard-panel-heading">
                  <div>
                    <span className="admin-dashboard-panel-label">
                      RESERVATIONS
                    </span>
                    <h2>Reservasi Terbaru</h2>
                    <p>
                      Antrean reservasi yang tercatat.
                    </p>
                  </div>

                  <a href="/admin/reservasi">
                    Kelola
                    <ArrowUpRight size={15} />
                  </a>
                </div>

                <div className="admin-dashboard-reservation-list">
                  {loading ? (
                    <div className="admin-dashboard-empty">
                      Memuat reservasi...
                    </div>
                  ) : data.recentReservations.length === 0 ? (
                    <div className="admin-dashboard-empty">
                      Belum ada reservasi.
                    </div>
                  ) : (
                    data.recentReservations.map(
                      (reservation, index) => (
                        <div
                          className="admin-dashboard-reservation"
                          key={
                            reservation.id ?? index
                          }
                        >
                          <div className="admin-dashboard-reservation-icon">
                            <CalendarClock size={16} />
                          </div>

                          <div>
                            <strong>
                              {getReservationTitle(
                                reservation,
                              )}
                            </strong>
                            <span>
                              {getReservationUser(
                                reservation,
                              )}
                            </span>
                          </div>

                          <small>
                            {statusLabel(
                              reservation.status,
                            )}
                          </small>
                        </div>
                      ),
                    )
                  )}
                </div>
              </article>
            </section>

            <section className="admin-dashboard-bottom-grid">
              <article className="admin-dashboard-panel">
                <div className="admin-dashboard-panel-heading">
                  <div>
                    <span className="admin-dashboard-panel-label">
                      QUICK ACTIONS
                    </span>
                    <h2>Akses Cepat</h2>
                  </div>
                </div>

                <div className="admin-dashboard-actions">
                  <a href="/admin/buku">
                    <FilePlus2 size={18} />
                    <span>
                      <strong>Tambah Buku</strong>
                      <small>Tambah koleksi baru</small>
                    </span>
                    <ArrowUpRight size={15} />
                  </a>

                  <a href="/admin/anggota">
                    <UserPlus size={18} />
                    <span>
                      <strong>Tambah Anggota</strong>
                      <small>Kelola anggota USEFECT</small>
                    </span>
                    <ArrowUpRight size={15} />
                  </a>

                  <a href="/admin/peminjaman/kelola">
                    <ClipboardList size={18} />
                    <span>
                      <strong>Kelola Peminjaman</strong>
                      <small>Transaksi dan pengembalian</small>
                    </span>
                    <ArrowUpRight size={15} />
                  </a>
                </div>
              </article>

              <article className="admin-dashboard-panel">
                <div className="admin-dashboard-panel-heading">
                  <div>
                    <span className="admin-dashboard-panel-label">
                      SYSTEM HEALTH
                    </span>
                    <h2>Status Sistem</h2>
                  </div>

                  <div className="admin-dashboard-health-badge">
                    <CircleDot size={14} />
                    {systemHealthy ? "Operational" : "Checking"}
                  </div>
                </div>

                <div className="admin-dashboard-health-list">
                  <div>
                    <span>
                      <Database size={16} />
                      API Service
                    </span>
                    <strong>
                      <CheckCircle2 size={15} />
                      Online
                    </strong>
                  </div>

                  <div>
                    <span>
                      <Database size={16} />
                      Data Service
                    </span>
                    <strong>
                      <CheckCircle2 size={15} />
                      Available
                    </strong>
                  </div>

                  <div>
                    <span>
                      <ShieldCheck size={16} />
                      Authentication
                    </span>
                    <strong>
                      <CheckCircle2 size={15} />
                      Active
                    </strong>
                  </div>

                  <div>
                    <span>
                      <Clock3 size={16} />
                      Dashboard
                    </span>
                    <strong>
                      <CheckCircle2 size={15} />
                      Live Data
                    </strong>
                  </div>
                </div>
              </article>
            </section>
          </div>
        </main>
      </div>
    </>
  );
}
