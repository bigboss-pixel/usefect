"use client";

import { useEffect, useMemo, useState } from "react";
import SiteHeader from "../../components/SiteHeader";
import AdminSidebar from "./components/AdminSidebar";
import {
  Activity,
  ArrowUpRight,
  BookOpen,
  CalendarClock,
  CheckCircle2,
  ClipboardList,
  Clock3,
  Database,
  FilePlus2,
  RefreshCw,
  ShieldCheck,
  UserPlus,
  Users,
  AlertTriangle,
  CircleDot,
} from "lucide-react";
import { apiFetch } from "../lib/api";

type LoanStatistics = {
  total?: number;
  pending?: number;
  active?: number;
  overdue?: number;
  returned?: number;
  cancelled?: number;
  rejected?: number;
};

type DashboardLoan = {
  id?: number;
  status?: string;
  createdAt?: string;
  dueDate?: string;
  returnedAt?: string;
  user?: {
    fullName?: string;
  };
  bookCopy?: {
    book?: {
      title?: string;
    };
  };
  book?: {
    title?: string;
  };
};

type DashboardReservation = {
  id?: number;
  status?: string;
  createdAt?: string;
  user?: {
    fullName?: string;
  };
  book?: {
    title?: string;
  };
};

type DashboardData = {
  totalBooks: number;
  totalMembers: number;
  totalLoans: number;
  activeLoans: number;
  overdueLoans: number;
  returnedLoans: number;
  pendingLoans: number;
  reservations: number;
  pendingReservations: number;
  recentLoans: DashboardLoan[];
  recentReservations: DashboardReservation[];
};

const emptyDashboard: DashboardData = {
  totalBooks: 0,
  totalMembers: 0,
  totalLoans: 0,
  activeLoans: 0,
  overdueLoans: 0,
  returnedLoans: 0,
  pendingLoans: 0,
  reservations: 0,
  pendingReservations: 0,
  recentLoans: [],
  recentReservations: [],
};

function formatNumber(value: number) {
  return new Intl.NumberFormat("id-ID").format(value);
}

function formatRelativeDate(value?: string) {
  if (!value) return "Baru saja";

  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return "Baru saja";
  }

  const diff = Date.now() - date.getTime();
  const minutes = Math.floor(diff / 60000);

  if (minutes < 1) return "Baru saja";
  if (minutes < 60) return `${minutes} menit lalu`;

  const hours = Math.floor(minutes / 60);

  if (hours < 24) return `${hours} jam lalu`;

  const days = Math.floor(hours / 24);

  if (days < 7) return `${days} hari lalu`;

  return date.toLocaleDateString("id-ID", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function getLoanTitle(loan: DashboardLoan) {
  return (
    loan.bookCopy?.book?.title ??
    loan.book?.title ??
    "Transaksi peminjaman"
  );
}

function getLoanUser(loan: DashboardLoan) {
  return loan.user?.fullName ?? "Anggota";
}

function getReservationTitle(reservation: DashboardReservation) {
  return reservation.book?.title ?? "Reservasi buku";
}

function getReservationUser(reservation: DashboardReservation) {
  return reservation.user?.fullName ?? "Anggota";
}

function statusLabel(status?: string) {
  switch (status) {
    case "ACTIVE":
      return "Aktif";
    case "OVERDUE":
      return "Terlambat";
    case "PENDING":
      return "Menunggu";
    case "RETURNED":
      return "Dikembalikan";
    case "CANCELLED":
      return "Dibatalkan";
    case "REJECTED":
      return "Ditolak";
    case "APPROVED":
      return "Disetujui";
    case "READY":
      return "Siap diambil";
    default:
      return status ?? "Aktivitas";
  }
}

export default function AdminDashboardPage() {
  const [data, setData] = useState<DashboardData>(emptyDashboard);
  const [loading, setLoading] = useState(true);
  const [refreshing, setRefreshing] = useState(false);
  const [error, setError] = useState("");

  async function loadDashboard(showRefresh = false) {
    if (showRefresh) {
      setRefreshing(true);
    } else {
      setLoading(true);
    }

    setError("");

    try {
      const [
        booksResponse,
        membersResponse,
        statisticsResponse,
        loansResponse,
        reservationsResponse,
      ] = await Promise.all([
        apiFetch("/books?limit=1"),
        apiFetch("/members"),
        apiFetch("/loans/statistics"),
        apiFetch("/loans?limit=100&sortBy=createdAt&order=desc"),
        apiFetch("/reservations"),
      ]);

      const [
        booksJson,
        membersJson,
        statisticsJson,
        loansJson,
        reservationsJson,
      ] = await Promise.all([
        booksResponse.ok ? booksResponse.json() : null,
        membersResponse.ok ? membersResponse.json() : null,
        statisticsResponse.ok ? statisticsResponse.json() : null,
        loansResponse.ok ? loansResponse.json() : null,
        reservationsResponse.ok ? reservationsResponse.json() : null,
      ]);

      const statistics: LoanStatistics =
        statisticsJson ?? {};

      const recentLoans = Array.isArray(loansJson)
        ? loansJson
        : Array.isArray(loansJson?.data)
          ? loansJson.data
          : [];

      const reservations = Array.isArray(reservationsJson)
        ? reservationsJson
        : Array.isArray(reservationsJson?.data)
          ? reservationsJson.data
          : [];

      const totalBooks =
        Number(booksJson?.pagination?.total ?? 0);

      const totalMembers =
        Array.isArray(membersJson)
          ? membersJson.length
          : Array.isArray(membersJson?.data)
            ? membersJson.data.length
            : 0;

      const totalReservations =
        reservations.length;

      const pendingReservations =
        reservations.filter((item: DashboardReservation) =>
          ["PENDING", "WAITING"].includes(
            item.status ?? "",
          ),
        ).length;

      setData({
        totalBooks,
        totalMembers,
        totalLoans: Number(statistics.total ?? 0),
        activeLoans: Number(statistics.active ?? 0),
        overdueLoans: Number(statistics.overdue ?? 0),
        returnedLoans: Number(statistics.returned ?? 0),
        pendingLoans: Number(statistics.pending ?? 0),
        reservations: totalReservations,
        pendingReservations,
        recentLoans,
        recentReservations: reservations.slice(0, 5),
      });
    } catch (err) {
      console.error("Gagal memuat dashboard:", err);
      setError(
        "Sebagian data dashboard belum dapat dimuat. Silakan coba refresh.",
      );
    } finally {
      setLoading(false);
      setRefreshing(false);
    }
  }

  useEffect(() => {
    loadDashboard();
  }, []);

  const collectionStatus = useMemo(() => {
    const total =
      data.activeLoans +
      data.overdueLoans +
      data.returnedLoans;

    const active =
      data.activeLoans +
      data.overdueLoans;

    const returned =
      data.returnedLoans;

    const activePercent =
      total > 0
        ? Math.round((active / total) * 100)
        : 0;

    const returnedPercent =
      total > 0
        ? Math.round((returned / total) * 100)
        : 0;

    return {
      active,
      returned,
      activePercent,
      returnedPercent,
    };
  }, [
    data.activeLoans,
    data.overdueLoans,
    data.returnedLoans,
  ]);

  const loanTrend = useMemo(() => {
    const now = new Date();
    const days = [];

    for (let offset = 6; offset >= 0; offset--) {
      const date = new Date(now);
      date.setHours(0, 0, 0, 0);
      date.setDate(date.getDate() - offset);

      days.push({
        key: [
          date.getFullYear(),
          String(date.getMonth() + 1).padStart(2, "0"),
          String(date.getDate()).padStart(2, "0"),
        ].join("-"),
        label: date.toLocaleDateString("id-ID", {
          weekday: "short",
        }),
        dateLabel: date.toLocaleDateString("id-ID", {
          day: "2-digit",
          month: "short",
        }),
        count: 0,
      });
    }

    for (const loan of data.recentLoans) {
      if (!loan.createdAt) continue;

      const date = new Date(loan.createdAt);

      if (Number.isNaN(date.getTime())) continue;

      const key = [
        date.getFullYear(),
        String(date.getMonth() + 1).padStart(2, "0"),
        String(date.getDate()).padStart(2, "0"),
      ].join("-");

      const day = days.find((item) => item.key === key);

      if (day) {
        day.count++;
      }
    }

    const max = Math.max(
      ...days.map((day) => day.count),
      1,
    );

    const total = days.reduce(
      (sum, day) => sum + day.count,
      0,
    );

    const peak = days.reduce(
      (highest, day) =>
        day.count > highest.count
          ? day
          : highest,
      days[0],
    );

    return {
      days,
      max,
      total,
      peak,
    };
  }, [data.recentLoans]);

  const loanChartPoints = useMemo(() => {
    const width = 720;
    const height = 190;
    const max = Math.max(loanTrend.max, 1);

    return loanTrend.days.map((day, index) => {
      const x =
        loanTrend.days.length === 1
          ? width / 2
          : (index / (loanTrend.days.length - 1)) * width;

      const y =
        height -
        22 -
        (day.count / max) * (height - 48);

      return {
        ...day,
        x,
        y,
      };
    });
  }, [loanTrend]);

  const loanLinePath =
    loanChartPoints.length > 0
      ? loanChartPoints
          .map(
            (point, index) =>
              `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`,
          )
          .join(" ")
      : "";

  const loanAreaPath =
    loanChartPoints.length > 0
      ? `${loanLinePath} L 720 190 L 0 190 Z`
      : "";

  const systemHealthy =
    !loading && !error;

  return (
    <>
      <SiteHeader />

      <div className="admin-dashboard-shell">
        <AdminSidebar />

        <main className="admin-dashboard-main">
          <div className="admin-dashboard-content">
            <section className="admin-dashboard-header">
              <div>
                <div className="admin-dashboard-eyebrow">
                  USEFECT · ADMIN WORKSPACE
                </div>

                <h1>
                  Administration
                  <span>Dashboard</span>
                </h1>

                <p>
                  Overview operasional, koleksi, transaksi,
                  pengguna, dan aktivitas sistem USEFECT.
                </p>
              </div>

              <button
                type="button"
                className="admin-dashboard-refresh"
                onClick={() => loadDashboard(true)}
                disabled={loading || refreshing}
              >
                <RefreshCw
                  size={16}
                  className={
                    refreshing
                      ? "admin-dashboard-spin"
                      : ""
