@import "tailwindcss";

:root {
  --navy: #071a52;
  --blue: #0758e8;
  --blue-light: #eaf2ff;
  --text: #0b1b4b;
  --muted: #63739a;
  --border: #dce7f8;
  --green: #16b978;
  --background: #f7faff;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--background);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
}

button,
input {
  font: inherit;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

a {
  color: inherit;
  text-decoration: none;
}

/* ================= HEADER ================= */

.library-page {
  min-height: 100vh;
  overflow-x: hidden;
}

.top-header {
  height: 66px;
  padding: 0 3.2%;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(215, 226, 245, 0.8);
  position: relative;
  z-index: 20;
}

.brand-area {
  display: flex;
  align-items: center;
  gap: 13px;
  min-width: 380px;
}

.uma-logo {
  width: 43px;
  height: 43px;
  border-radius: 50%;
  border: 2px solid #155ce6;
  color: #155ce6;
  display: grid;
  place-items: center;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 0.5px;
}

.university-name {
  color: #10245d;
  font-size: 12px;
  line-height: 1.08;
  font-weight: 900;
}

.brand-divider {
  height: 38px;
  width: 1px;
  background: #d9e2f0;
  margin: 0 3px;
}

.library-brand {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.library-brand strong {
  font-size: 15px;
  color: #10245d;
}

.library-brand small {
  font-size: 8px;
  color: #63739a;
}

.desktop-nav {
  display: flex;
  align-items: center;
  gap: 21px;
}

.desktop-nav a {
  height: 66px;
  display: flex;
  align-items: center;
  gap: 6px;
  position: relative;
  font-size: 12px;
  font-weight: 600;
  color: #233662;
  transition: 0.25s ease;
}

.desktop-nav a:hover,
.desktop-nav a.active {
  color: var(--blue);
}

.desktop-nav a.active::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  border-radius: 5px 5px 0 0;
  background: var(--blue);
}

.desktop-nav a span {
  font-size: 16px;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.icon-button {
  width: 40px;
  height: 40px;
  border: 0;
  background: transparent;
  color: #092b75;
  font-size: 27px;
  cursor: pointer;
}

.notification {
  position: relative;
}

.notification span {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  right: 8px;
  top: 8px;
  border: 1px solid white;
}

.profile-mini {
  border: 0;
  background: #eef4fd;
  border-radius: 24px;
  padding: 5px 10px 5px 6px;
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 178px;
  cursor: pointer;
  text-align: left;
}

.avatar,
.large-avatar {
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, #102c73, #2677ed);
  color: white;
  font-weight: 800;
}

.avatar {
  width: 34px;
  height: 34px;
  font-size: 10px;
}

.profile-text {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.profile-text strong {
  font-size: 11px;
}

.profile-text small {
  font-size: 9px;
  color: #68799d;
  margin-top: 2px;
}

.profile-mini b {
  font-size: 17px;
}

/* ================= HERO ================= */

.hero {
  position: relative;
  min-height: 500px;
  background:
    radial-gradient(
      circle at 20% 20%,
      #ffffff 0,
      rgba(255,255,255,.9) 25%,
      transparent 45%
    ),
    linear-gradient(
      110deg,
      #eaf3ff,
      #f9fcff 60%,
      #dcecff
    );
}

.hero-background {
  position: absolute;
  inset: 0;
  overflow: hidden;
}

.building-image {
  object-fit: cover;
  object-position: center 40%;
  opacity: 0.95;
}

.hero-image-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      90deg,
      rgba(245,250,255,1) 0%,
      rgba(245,250,255,.94) 27%,
      rgba(245,250,255,.52) 45%,
      rgba(245,250,255,.08) 68%,
      rgba(230,241,255,.08) 100%
    );
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 1440px;
  margin: auto;
  min-height: 390px;
  padding: 54px 3.2% 120px;
  display: flex;
  justify-content: space-between;
}

.hero-copy {
  width: 57%;
}

.eyebrow {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 16px;
  color: #64748b;
  font-size: 10px;
  line-height: 1.2;
  letter-spacing: 4px;
  font-weight: 800;
}

.eyebrow span {
  color: #173f98;
}

 .hero h1 {
  max-width: 620px;
  margin: 8px 0 14px;
  font-size: clamp(46px, 4.2vw, 62px);
  line-height: .98;
  letter-spacing: -2.8px;
  color: #06184d;
  font-weight: 900;
  text-shadow:
    0 1px 0 rgba(255,255,255,.95),
    0 3px 0 rgba(7,31,82,.10),
    0 7px 16px rgba(7,31,82,.12);
  transform: translateZ(24px);
}

.hero h1 em {
  display: block;
  color: #075eea;
  font-style: normal;
  text-shadow:
    0 1px 0 rgba(255,255,255,.95),
    0 3px 0 rgba(5,73,180,.14),
    0 7px 16px rgba(7,94,234,.16);
}

.hero-copy > p {
  max-width: 540px;
  color: #405782;
  font-size: 16px;
  line-height: 1.5;
  letter-spacing: 0;
  font-weight: 500;
  margin: 0;
  text-shadow:
    0 1px 0 rgba(255,255,255,.8),
    0 2px 7px rgba(15,39,91,.10);
  transform: translateZ(14px);
}

.hero-stats {
  display: flex;
  gap: 31px;
  margin-top: 30px;
}

.hero-stats div {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.hero-stats strong {
  color: #0b286b;
  font-size: 17px;
}

.hero-stats span {
  color: #63739a;
  font-size: 10px;
}

.hero-card {
  width: 225px;
  height: 225px;
  margin-top: 8px;
  border: 1px solid rgba(255,255,255,.65);
  border-radius: 25px;
  background:
    linear-gradient(
      135deg,
      rgba(16,79,170,.82),
      rgba(6,34,105,.7)
    );
  backdrop-filter: blur(16px);
  box-shadow: 0 25px 70px rgba(15,56,126,.25);
  padding: 25px;
  color: white;
  position: relative;
  overflow: hidden;
}

.hero-card-glow {
  position: absolute;
  width: 160px;
  height: 160px;
  right: -50px;
  top: -55px;
  border-radius: 50%;
  background: rgba(90,190,255,.3);
  filter: blur(12px);
}

.hero-card-label {
  font-size: 8px;
  letter-spacing: 2px;
  opacity: .7;
}

.hero-card strong {
  position: relative;
  display: block;
  font-size: 25px;
  line-height: 1.02;
  margin-top: 22px;
}

.hero-card p {
  font-size: 10px;
  line-height: 1.5;
  opacity: .75;
}

.hero-card button {
  border: 1px solid rgba(255,255,255,.4);
  background: rgba(255,255,255,.12);
  color: white;
  border-radius: 20px;
  padding: 8px 13px;
  font-size: 10px;
  cursor: pointer;
}

/* ================= SEARCH ================= */

.search-wrapper {
  position: absolute;
  z-index: 5;
  left: 3.2%;
  right: 3.2%;
  bottom: 15px;
}

.search-box {
  height: 52px;
  background: rgba(255,255,255,.96);
  border: 1px solid #cbdcf7;
  border-radius: 17px;
  box-shadow: 0 12px 35px rgba(32,83,151,.12);
  display: flex;
  align-items: center;
  padding: 5px 6px 5px 17px;
}

.search-icon {
  font-size: 28px;
  color: #095de8;
  margin-right: 11px;
}

.search-box input {
  flex: 1;
  border: 0;
  outline: 0;
  color: #13285b;
  font-size: 13px;
  background: transparent;
}

.search-box input::placeholder {
  color: #8290aa;
}

.collection-select {
  border: 0;
  background: #f1f6fd;
  border-radius: 20px;
  height: 40px;
  padding: 0 16px;
  color: #152b62;
  font-size: 11px;
  cursor: pointer;
}

.collection-select span {
  margin-left: 18px;
}

.search-button {
  height: 40px;
  margin-left: 8px;
  border: 0;
  border-radius: 21px;
  background: linear-gradient(135deg, #1265ed, #0751d6);
  color: white;
  min-width: 120px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 7px 17px rgba(8,86,225,.24);
}

.arrow {
  margin-left: 8px;
  font-size: 17px;
}

.popular-search {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 0 0;
  flex-wrap: wrap;
}

.popular-search strong {
  font-size: 10px;
  color: #142c65;
}

.popular-search button {
  border: 0;
  background: #edf4fd;
  color: #183a7c;
  border-radius: 15px;
  padding: 5px 11px;
  font-size: 9px;
  cursor: pointer;
  transition: .2s ease;
}

.popular-search button:hover {
  background: #dceaff;
  transform: translateY(-1px);
}

/* ================= CONTENT ================= */

.content-container {
  max-width: 1440px;
  margin: auto;
  padding: 28px 3.2% 45px;
}

.quick-services {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 9px;
  margin-bottom: 22px;
}

.service-card {
  min-height: 100px;
  background: rgba(255,255,255,.88);
  border: 1px solid #dce7f7;
  border-radius: 13px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 5px;
  transition: .25s ease;
  box-shadow: 0 6px 22px rgba(35,81,143,.04);
}

.service-card:hover {
  transform: translateY(-4px);
  border-color: #b9d3ff;
  box-shadow: 0 15px 30px rgba(26,90,178,.11);
}

.service-icon {
  color: #075ce4;
  font-size: 27px;
  line-height: 1;
}

.service-card:nth-child(3) .service-icon,
.service-card:nth-child(2) .service-icon {
  color: #16a765;
}

.service-card strong {
  font-size: 12px;
}

.service-card span {
  font-size: 9px;
  color: #6a7b9e;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 25px;
}

.main-column {
  min-width: 0;
}

.collection-section {
  background: transparent;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 13px;
}

.section-heading h2 {
  margin: 0 0 13px;
  font-size: 22px;
  letter-spacing: -.7px;
}

.section-heading > a,
.agenda-heading > a {
  color: #075ce6;
  font-size: 10px;
  font-weight: 700;
}

.category-tabs {
  display: flex;
  align-items: center;
  gap: 22px;
  overflow-x: auto;
  scrollbar-width: none;
}

.category-tabs::-webkit-scrollbar {
  display: none;
}

.category-tabs button {
  border: 0;
  background: transparent;
  padding: 0 0 8px;
  color: #58709e;
  font-size: 10px;
  white-space: nowrap;
  cursor: pointer;
  position: relative;
}

.category-tabs button.selected {
  color: #075ce4;
  font-weight: 800;
}

.category-tabs button.selected::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  border-radius: 2px;
  background: #075ce4;
}

.books-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 11px;
}

.book-card {
  background: rgba(255,255,255,.92);
  border: 1px solid #dce6f5;
  border-radius: 13px;
  padding: 10px;
  transition: .25s ease;
}

.book-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 35px rgba(20,65,126,.1);
}

.book-cover {
  height: 175px;
  border-radius: 7px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  color: white;
  overflow: hidden;
  box-shadow: 0 8px 16px rgba(16,49,103,.16);
}

.book-cover small {
  font-size: 6px;
  letter-spacing: .5px;
  opacity: .75;
}

.book-cover strong {
  font-size: 18px;
  line-height: 1.02;
  max-width: 130px;
}

.book-cover span {
  font-size: 6px;
  opacity: .7;
}

.cover-operations {
  background: linear-gradient(145deg, #071b57, #1474db);
}

.cover-lean {
  background: linear-gradient(145deg, #101217, #2e3036);
}

.cover-supply {
  background: radial-gradient(circle at 70% 45%, #1e7fff, #061b52 68%);
}

.cover-industrial {
  background: linear-gradient(145deg, #06276c, #1581d7);
}

.cover-production {
  background: linear-gradient(145deg, #2b6519, #7ab83e);
}

.book-card h3 {
  font-size: 12px;
  line-height: 1.15;
  margin: 8px 2px 3px;
}

.book-card p {
  color: #71809d;
  font-size: 9px;
  margin: 0 2px;
}

.book-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 10px 2px 1px;
}

.available {
  color: #12a86f;
  font-size: 9px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.available i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #16b978;
}

.book-bottom button {
  border: 0;
  background: transparent;
  color: #075ce4;
  font-size: 21px;
  cursor: pointer;
}

/* ================= SIDEBAR ================= */

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 13px;
}

.student-card,
.agenda-card {
  background: rgba(255,255,255,.91);
  border: 1px solid #dce7f7;
  border-radius: 16px;
  box-shadow: 0 8px 25px rgba(26,69,125,.05);
}

.student-card {
  padding: 11px;
}

.student-profile {
  min-height: 65px;
  background: linear-gradient(120deg, #edf4fd, #f8fbff);
  border-radius: 12px;
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 9px;
}

.large-avatar {
  width: 47px;
  height: 47px;
  font-size: 12px;
}

.student-profile > div:nth-child(2) {
  flex: 1;
}

.student-profile strong {
  display: block;
  font-size: 14px;
}

.student-profile span {
  display: block;
  color: #63769d;
  font-size: 9px;
  margin-top: 4px;
}

.student-profile > b {
  color: #0c52ce;
  font-size: 22px;
}

.student-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin-top: 11px;
}

.student-stats div {
  min-height: 70px;
  border-right: 1px solid #e5edf8;
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
}

.student-stats div:last-child {
  border: 0;
}

.student-stats span {
  color: #075ce4;
  font-size: 17px;
}

.student-stats div:nth-child(3) span {
  color: #16a765;
}

.student-stats small {
  color: #63739a;
  font-size: 7px;
  margin-top: 3px;
}

.student-stats strong {
  font-size: 17px;
  margin-top: 3px;
}

.agenda-card {
  padding: 17px 13px;
}

.agenda-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 3px 8px;
}

.agenda-heading h2 {
  margin: 0;
  font-size: 15px;
}

.agenda-item {
  min-height: 64px;
  border-top: 1px solid #e5edf7;
  display: flex;
  align-items: center;
  gap: 9px;
  position: relative;
}

.agenda-icon {
  width: 31px;
  height: 31px;
  border-radius: 9px;
  background: #edf4ff;
  color: #075ce4;
  display: grid;
  place-items: center;
  font-size: 14px;
  flex: 0 0 auto;
}

.agenda-0 {
  color: #18a86e;
  background: #e9f9f1;
}

.agenda-3 {
  color: #ef771c;
  background: #fff3e8;
}

.agenda-item > div:nth-child(2) {
  padding-right: 30px;
}

.agenda-item strong {
  display: block;
  font-size: 10px;
  line-height: 1.25;
}

.agenda-item span {
  display: block;
  color: #7382a1;
  font-size: 8px;
  margin-top: 4px;
}

.agenda-item > b {
  position: absolute;
  right: 0;
  top: 12px;
  background: #ffe6e9;
  color: #e4495b;
  border-radius: 10px;
  font-size: 7px;
  padding: 4px 7px;
}

/* ================= PROMO ================= */

.promo-grid {
  display: grid;
  grid-template-columns: 1.35fr 1.35fr 1.35fr;
  gap: 11px;
  margin-top: 14px;
}

.promo {
  min-height: 145px;
  border-radius: 13px;
  overflow: hidden;
  position: relative;
  padding: 20px;
  display: flex;
  align-items: center;
}

.promo::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .2;
  background:
    radial-gradient(
      circle at 80% 40%,
      white 0,
      transparent 35%
    ),
    linear-gradient(
      135deg,
      transparent,
      rgba(255,255,255,.4)
    );
}

.promo > div {
  position: relative;
  z-index: 2;
}

.promo small {
  font-size: 7px;
  letter-spacing: 1.5px;
  font-weight: 800;
  opacity: .75;
}

.promo h3 {
  font-size: 20px;
  line-height: 1.05;
  margin: 6px 0;
}

.promo p {
  font-size: 9px;
  line-height: 1.45;
  max-width: 220px;
  opacity: .82;
}

.promo button {
  margin-top: 5px;
  border: 1px solid currentColor;
  background: rgba(255,255,255,.13);
  border-radius: 20px;
  padding: 7px 13px;
  font-size: 8px;
  color: inherit;
  cursor: pointer;
}

.reading-room {
  color: white;
  background:
    linear-gradient(
      100deg,
      rgba(2,25,76,.98),
      rgba(5,88,193,.82)
    ),
    #08245d;
}

.mobile-app {
  color: #0b286b;
  background: linear-gradient(
    120deg,
    #dcecff,
    #f4f9ff
  );
}

.mobile-app button,
.ai-library button {
  background: white;
  color: #075ce4;
  border-color: #bcd4f8;
}

.ai-library {
  color: #09286d;
  background: linear-gradient(
    120deg,
    #e7f5ff,
    #f5fbff
  );
}

.robot {
  width: 80px;
  height: 80px;
  border-radius: 50%;
  margin-right: 13px;
  background:
    radial-gradient(
      circle at 40% 38%,
      #62e5ff 0 7%,
      transparent 8%
    ),
    radial-gradient(
      circle at 65% 38%,
      #62e5ff 0 7%,
      transparent 8%
    ),
    linear-gradient(
      145deg,
      #0d65d7,
      #8dddf8
    );
  border: 7px solid rgba(255,255,255,.75);
  box-shadow: 0 12px 25px rgba(25,113,190,.2);
  color: transparent;
}

/* ================= RESPONSIVE ================= */

@media (max-width: 1250px) {
  .desktop-nav {
    gap: 11px;
  }

  .desktop-nav a {
    font-size: 10px;
  }

  .brand-area {
    min-width: 320px;
  }

  .quick-services {
    grid-template-columns: repeat(4, 1fr);
  }

  .books-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .book-card:nth-child(5) {
    display: none;
  }
}

@media (max-width: 1000px) {
  .desktop-nav {
    display: none;
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .sidebar {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .hero-copy {
    width: 70%;
  }

  .hero-card {
    width: 190px;
  }
}

@media (max-width: 700px) {
  .top-header {
    height: 60px;
    padding: 0 15px;
  }

  .brand-area {
    min-width: auto;
  }

  .brand-divider,
  .library-brand small,
  .university-name {
    display: none;
  }

  .library-brand strong {
    font-size: 13px;
  }

  .header-actions {
    gap: 1px;
  }

  .icon-button {
    width: 34px;
  }

  .profile-mini {
    min-width: auto;
    padding-right: 6px;
  }

  .profile-text,
  .profile-mini b {
    display: none;
  }

  .hero {
    min-height: 640px;
  }

  .hero-image-overlay {
    background:
      linear-gradient(
        180deg,
        rgba(247,251,255,.98) 0%,
        rgba(247,251,255,.88) 42%,
        rgba(247,251,255,.25) 72%,
        rgba(247,251,255,.2) 100%
      );
  }

  .hero-content {
    padding: 38px 20px 190px;
    min-height: 520px;
    display: block;
  }

  .hero-copy {
    width: 100%;
  }

  .hero h1 {
    max-width: 100%;
    font-size: 42px;
    line-height: 1;
    letter-spacing: -1.8px;
  }

  .hero-copy > p {
    font-size: 14px;
    line-height: 1.5;
  }

  .hero-stats {
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-stats div {
    min-width: 105px;
  }

  .hero-card {
    display: none;
  }

  .search-wrapper {
    left: 15px;
    right: 15px;
    bottom: 20px;
  }

  .search-box {
    height: auto;
    min-height: 52px;
    flex-wrap: wrap;
    padding: 8px;
  }

  .search-icon {
    margin-left: 5px;
  }

  .search-box input {
    min-width: 0;
  }

  .collection-select {
    display: none;
  }

  .search-button {
    min-width: 80px;
  }

  .popular-search {
    max-height: 45px;
    overflow: hidden;
  }

  .content-container {
    padding: 20px 15px 35px;
  }

  .quick-services {
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .service-card {
    min-height: 88px;
  }

  .service-card span {
    display: none;
  }

  .service-icon {
    font-size: 23px;
  }

  .books-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .book-card:nth-child(5) {
    display: block;
  }

  .book-cover {
    height: 180px;
  }

  .section-heading {
    align-items: start;
  }

  .section-heading > a {
    display: none;
  }

  .category-tabs {
    gap: 15px;
  }

  .sidebar {
    display: flex;
  }

  .promo-grid {
    grid-template-columns: 1fr;
  }

  .promo {
    min-height: 155px;
  }
}

@media (max-width: 420px) {
  .hero h1 {
    font-size: 37px;
  }

  .hero-stats {
    gap: 10px;
  }

  .hero-stats strong {
    font-size: 14px;
  }

  .quick-services {
    grid-template-columns: repeat(2, 1fr);
  }

  .book-cover {
    height: 190px;
  }
}

  /* =========================================================
   PROFESSIONAL LUCIDE ICONS
========================================================= */

.service-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.service-icon svg {
  flex-shrink: 0;
}

.desktop-nav a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.desktop-nav a svg {
  flex-shrink: 0;
}

.icon-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.search-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.collection-select {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.search-button,
.promo button,
.hero-card button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}

.category-tabs button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
}

.book-bottom button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.student-stats span {
  display: flex;
  align-items: center;
  justify-content: center;
}

.student-profile > b,
.student-profile > svg {
  flex-shrink: 0;
}

.agenda-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.agenda-heading a {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.robot {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* =========================================================
   OPAC / KATALOG
========================================================= */

.catalog-page {
  min-height: 100vh;
  background: #f7f9fc;
  color: #172033;
}

.catalog-header {
  height: 76px;
  padding: 0 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  background: rgba(255, 255, 255, 0.96);
  border-bottom: 1px solid #e7ebf2;
  position: sticky;
  top: 0;
  z-index: 50;
  backdrop-filter: blur(18px);
}

.catalog-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  white-space: nowrap;
}

.catalog-logo {
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #0c5bd9;
  color: white;
  font-weight: 800;
  font-size: 13px;
  text-decoration: none;
  box-shadow: 0 7px 18px rgba(12, 91, 217, 0.2);
}

.catalog-brand-divider {
  height: 31px;
  width: 1px;
  background: #dfe4ec;
}

.catalog-brand strong {
  display: block;
  font-size: 14px;
  color: #152039;
}

.catalog-brand span {
  display: block;
  margin-top: 3px;
  font-size: 11px;
  color: #7b8495;
}

.catalog-nav {
  display: flex;
  align-items: center;
  gap: 23px;
}

.catalog-nav a {
  color: #697386;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition: 0.2s ease;
}

.catalog-nav a:hover,
.catalog-nav a.active {
  color: #0c5bd9;
}

.catalog-user {
  display: flex;
  align-items: center;
  gap: 9px;
}

.catalog-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #0c5bd9, #4f8ff7);
  color: white;
  font-size: 11px;
  font-weight: 800;
}

.catalog-user strong {
  display: block;
  font-size: 12px;
}

.catalog-user span {
  display: block;
  font-size: 10px;
  color: #8790a0;
  margin-top: 2px;
}


/* HERO */

.catalog-hero {
  position: relative;
  overflow: hidden;
  padding: 68px 8% 76px;
  background:
    radial-gradient(
      circle at 78% 32%,
      rgba(7, 94, 234, 0.10),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f7faff 55%,
      #eef5ff 100%
    );
  border-bottom: 1px solid rgba(229, 234, 241, 0.9);
  perspective: 1200px;
}

.catalog-hero::before {
  content: "";
  position: absolute;
  width: 520px;
  height: 520px;
  right: -180px;
  top: -240px;
  border-radius: 50%;
  background: radial-gradient(
    circle,
    rgba(57, 213, 255, 0.10),
    transparent 68%
  );
  pointer-events: none;
}

.catalog-hero > div {
  position: relative;
  z-index: 1;
  max-width: 820px;
  transform: translateZ(12px);
}

.catalog-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #64748b;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 3px;
  text-transform: uppercase;
}

.catalog-eyebrow svg {
  color: #075eea;
  filter: drop-shadow(0 2px 5px rgba(7, 94, 234, 0.16));
}

.catalog-hero h1 {
  margin: 13px 0 15px;
  max-width: 720px;
  color: #06184d;
  font-size: clamp(46px, 5vw, 66px);
  line-height: .98;
  letter-spacing: -3px;
  font-weight: 900;
  text-shadow: 0 3px 14px rgba(15, 39, 91, 0.08);
}

.catalog-hero h1 em {
  display: block;
  color: #075eea;
  font-style: normal;
}

.catalog-hero p {
  max-width: 600px;
  margin: 0;
  color: #405782;
  font-size: 16px;
  line-height: 1.5;
  font-weight: 500;
  text-shadow: 0 1px 5px rgba(15, 39, 91, 0.05);
}

/* SEARCH */

.catalog-search-section {
  padding: 0 8%;
  margin-top: -28px;
  position: relative;
  z-index: 5;
}

.catalog-search-box {
  height: 68px;
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 7px 8px 7px 22px;
  background: white;
  border: 1px solid #e0e6ef;
  border-radius: 17px;
  box-shadow: 0 18px 45px rgba(30, 48, 78, 0.11);
}

.catalog-search-box > svg {
  color: #718096;
  flex-shrink: 0;
}

.catalog-search-box input {
  flex: 1;
  min-width: 0;
  border: none;
  outline: none;
  color: #172033;
  font-size: 14px;
  background: transparent;
}

.catalog-search-box input::placeholder {
  color: #9ba4b2;
}

.catalog-search-box button {
  height: 52px;
  padding: 0 28px;
  border: none;
  border-radius: 12px;
  background: #0c5bd9;
  color: white;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.catalog-search-box button:hover {
  background: #084caf;
  transform: translateY(-1px);
}


/* CONTENT */

.catalog-content {
  max-width: 1450px;
  margin: 0 auto;
  padding: 55px 5% 90px;
  display: grid;
  grid-template-columns: 255px minmax(0, 1fr);
  gap: 45px;
}


/* FILTER */

.catalog-filter {
  align-self: start;
  padding: 23px;
  background: white;
  border: 1px solid #e5e9f0;
  border-radius: 17px;
  box-shadow: 0 8px 28px rgba(27, 43, 67, 0.04);
}

.filter-heading {
  display: flex;
  align-items: center;
  gap: 9px;
  padding-bottom: 20px;
  border-bottom: 1px solid #edf0f5;
  color: #172033;
}

.filter-heading svg {
  color: #0c5bd9;
}

.filter-group {
  padding: 21px 0;
  border-bottom: 1px solid #edf0f5;
}

.filter-group label {
  display: block;
  margin-bottom: 10px;
  font-size: 12px;
  font-weight: 700;
  color: #3d4759;
}

.filter-select {
  position: relative;
}

.filter-select select {
  width: 100%;
  height: 42px;
  padding: 0 35px 0 12px;
  appearance: none;
  border: 1px solid #dfe4ec;
  border-radius: 9px;
  background: white;
  color: #5e6879;
  outline: none;
  font-size: 12px;
  cursor: pointer;
}

.filter-select svg {
  position: absolute;
  right: 12px;
  top: 13px;
  pointer-events: none;
  color: #7d8797;
}

.availability-check {
  display: flex !important;
  align-items: center;
  gap: 8px;
  cursor: pointer;
  font-weight: 500 !important;
}

.availability-check input {
  accent-color: #0c5bd9;
}

.filter-info {
  display: flex;
  gap: 10px;
  margin-top: 21px;
  padding: 14px;
  border-radius: 11px;
  background: #f2f7ff;
}

.filter-info svg {
  color: #0c5bd9;
  flex-shrink: 0;
}

.filter-info strong {
  display: block;
  font-size: 11px;
}

.filter-info span {
  display: block;
  margin-top: 4px;
  color: #7c8799;
  font-size: 10px;
  line-height: 1.5;
}


/* RESULTS */

.results-header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 20px;
  margin-bottom: 24px;
}

.results-header > div:first-child > span {
  color: #0c5bd9;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1.4px;
}

.results-header h2 {
  margin: 6px 0 4px;
  font-size: 25px;
  letter-spacing: -0.6px;
}

.results-header p {
  margin: 0;
  color: #8992a2;
  font-size: 12px;
}

.sort-box {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #8790a0;
  font-size: 11px;
  position: relative;
}

.sort-box select {
  appearance: none;
  border: 1px solid #dfe4ec;
  background: white;
  border-radius: 8px;
  height: 36px;
  padding: 0 28px 0 11px;
  color: #4c5668;
  font-size: 11px;
}

.sort-box svg {
  margin-left: -25px;
  pointer-events: none;
}


/* BOOK CARD */

.catalog-books {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.catalog-book-card {
  display: grid;
  grid-template-columns: 145px minmax(0, 1fr);
  gap: 23px;
  padding: 18px;
  background: white;
  border: 1px solid #e4e8ef;
  border-radius: 16px;
  transition: 0.25s ease;
}

.catalog-book-card:hover {
  transform: translateY(-2px);
  border-color: #cbd8eb;
  box-shadow: 0 13px 35px rgba(28, 48, 78, 0.08);
}

.catalog-book-cover {
  min-height: 190px;
  padding: 18px 13px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-radius: 10px;
  color: white;
  box-shadow: 0 10px 22px rgba(22, 35, 55, 0.13);
}

.catalog-book-cover small {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 0.5px;
}

.catalog-book-cover strong {
  font-size: 17px;
  line-height: 1.12;
}

.catalog-book-cover span {
  font-size: 7px;
  opacity: 0.8;
}

.cover-1 {
  background: linear-gradient(145deg, #183c75, #0d6ac9);
}

.cover-2 {
  background: linear-gradient(145deg, #172f59, #2979d8);
}

.cover-3 {
  background: linear-gradient(145deg, #234f39, #51a16c);
}

.cover-4 {
  background: linear-gradient(145deg, #63372c, #bc7657);
}

.cover-5 {
  background: linear-gradient(145deg, #56345f, #9c62aa);
}

.cover-6 {
  background: linear-gradient(145deg, #283c50, #607d98);
}

.catalog-book-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.catalog-book-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.book-category {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 6px;
  background: #eef5ff;
  color: #0c5bd9;
  font-size: 9px;
  font-weight: 800;
}

.catalog-book-top h3 {
  margin: 9px 0 4px;
  color: #182136;
  font-size: 18px;
}

.book-author {
  margin: 0;
  color: #758093;
  font-size: 12px;
  white-space: pre-line;
  line-height: 1.5;
}

.favorite-button {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid #e2e7ee;
  border-radius: 9px;
  background: white;
  color: #8a94a4;
  cursor: pointer;
}

.favorite-button:hover {
  color: #e34f68;
  border-color: #f2c6ce;
}

.book-meta {
  display: flex;
  gap: 22px;
  margin-top: 18px;
  padding-top: 13px;
  border-top: 1px solid #edf0f4;
  color: #8a94a3;
  font-size: 10px;
}

.book-availability {
  display: flex;
  gap: 35px;
  margin-top: 17px;
}

.book-availability div span {
  display: block;
  color: #9aa2b0;
  font-size: 9px;
}

.book-availability div strong {
  display: block;
  margin-top: 3px;
  font-size: 14px;
  color: #29344a;
}

.catalog-book-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  margin-top: auto;
  padding-top: 15px;
}

.book-status {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 10px;
  font-weight: 700;
}

.book-status.available {
  color: #19935a;
}

.book-status.unavailable {
  color: #d45c61;
}

.detail-button {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #0c5bd9;
  text-decoration: none;
  font-size: 11px;
  font-weight: 700;
}

.detail-button:hover {
  gap: 8px;
}


/* EMPTY */

.catalog-empty {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: white;
  border: 1px solid #e4e8ef;
  border-radius: 16px;
  color: #8a94a4;
}

.catalog-empty svg {
  margin-bottom: 12px;
  color: #0c5bd9;
}

.catalog-empty h3 {
  margin: 0;
  color: #263149;
}

.catalog-empty p {
  margin: 6px 0 0;
  font-size: 12px;
}


/* PAGINATION */

.catalog-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 28px;
}

.catalog-pagination button {
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid #e0e5ec;
  border-radius: 8px;
  background: white;
  color: #687386;
  cursor: pointer;
}

.catalog-pagination button:hover,
.catalog-pagination button.selected {
  background: #0c5bd9;
  color: white;
  border-color: #0c5bd9;
}

.catalog-pagination span {
  color: #8d96a5;
}


/* RESPONSIVE */

@media (max-width: 1100px) {
  .catalog-nav {
    display: none;
  }

  .catalog-content {
    grid-template-columns: 220px minmax(0, 1fr);
  }
}

@media (max-width: 760px) {

  .catalog-header {
    padding: 0 18px;
  }

  .catalog-brand-divider,
  .catalog-brand > div:last-child span,
  .catalog-user > div:nth-child(2),
  .catalog-user > svg {
    display: none;
  }

  .catalog-hero {
    padding: 45px 22px 60px;
  }

  .catalog-search-section {
    padding: 0 18px;
  }

  .catalog-search-box {
    height: auto;
    padding: 10px;
    flex-wrap: wrap;
  }

  .catalog-search-box input {
    height: 42px;
  }

  .catalog-search-box button {
    width: 100%;
  }

  .catalog-content {
    display: block;
    padding: 35px 18px 70px;
  }

  .catalog-filter {
    margin-bottom: 30px;
  }

  .results-header {
    align-items: start;
    flex-direction: column;
  }

  .catalog-book-card {
    grid-template-columns: 105px minmax(0, 1fr);
    gap: 15px;
    padding: 13px;
  }

  .catalog-book-cover {
    min-height: 155px;
    padding: 13px 10px;
  }

  .catalog-book-cover strong {
    font-size: 13px;
  }

  .book-availability {
    gap: 18px;
  }
}

/* =========================
   BOOK DETAIL
   ========================= */

.catalog-detail-content {
  display: block;
  padding: 0;
}

.book-detail-wrapper {
  width: min(1100px, calc(100% - 48px));
  max-width: 1100px;
  margin: 0 auto;
}

.book-detail {
  width: 100%;
  margin: 0;
  padding: 42px 0 90px;

  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 64px;
  align-items: start;
}

.catalog-back-button {
  position: relative;

  display: inline-flex;
  align-items: center;
  gap: 9px;

  margin: 28px 0 0;
  padding: 11px 18px;

  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(241, 245, 249, 0.92)
    );

  color: #475569;

  font-size: 14px;
  font-weight: 600;

  box-shadow:
    0 8px 18px rgba(15, 23, 42, 0.08),
    0 3px 6px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  cursor: pointer;

  transform: translateY(0);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.catalog-back-button::before {
  content: "";

  position: absolute;
  inset: 1px;

  border-radius: 11px;

  background:
    linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.06),
      transparent 50%,
      rgba(139, 92, 246, 0.05)
    );

  pointer-events: none;
}

.catalog-back-button svg {
  position: relative;
  z-index: 1;

  transition:
    transform 0.2s ease;
}

.catalog-back-button:hover {
  transform: translateY(-3px);

  border-color: rgba(59, 130, 246, 0.28);

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f1f5f9
    );

  box-shadow:
    0 14px 28px rgba(15, 23, 42, 0.12),
    0 5px 10px rgba(59, 130, 246, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.catalog-back-button:hover svg {
  transform: translateX(-3px);
}

.catalog-back-button:active {
  transform: translateY(1px);

  box-shadow:
    0 4px 8px rgba(15, 23, 42, 0.10),
    inset 0 2px 4px rgba(15, 23, 42, 0.06);
}

.catalog-back-button:hover {
  background: #f9fafb;
  border-color: #d1d5db;
}

.book-detail-cover {
  position: relative;

  width: 320px;
  height: 440px;

  display: flex;
  align-items: center;
  justify-content: center;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.95),
      rgba(241, 245, 249, 0.9)
    );

  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 18px;

  color: #64748b;

  box-shadow:
    0 30px 60px rgba(15, 23, 42, 0.12),
    0 10px 20px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);

  transform: perspective(1000px) rotateY(-3deg);

  transition:
    transform 0.35s ease,
    box-shadow 0.35s ease;
}

.book-detail-cover::before {
  content: "";

  position: absolute;
  inset: 0;

  border-radius: 18px;

  background:
    linear-gradient(
      135deg,
      rgba(59, 130, 246, 0.10),
      transparent 35%,
      rgba(139, 92, 246, 0.08)
    );

  pointer-events: none;
}

.book-detail-cover::after {
  content: "";

  position: absolute;

  width: 180px;
  height: 180px;

  top: -60px;
  right: -60px;

  background: rgba(59, 130, 246, 0.10);

  filter: blur(45px);

  border-radius: 50%;

  pointer-events: none;
}

.book-detail-cover:hover {
  transform:
    perspective(1000px)
    rotateY(0deg)
    translateY(-8px);

  box-shadow:
    0 40px 80px rgba(15, 23, 42, 0.16),
    0 15px 30px rgba(59, 130, 246, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.book-detail-cover svg {
  position: relative;
  z-index: 2;

  filter:
    drop-shadow(0 8px 10px rgba(15, 23, 42, 0.12));

  transition: transform 0.35s ease;
}

.book-detail-cover:hover svg {
  transform: scale(1.08);
}

.book-detail-info {
  min-width: 0;
}

.book-detail-category {
  display: inline-block;
  padding: 6px 11px;
  border-radius: 999px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 14px;
}

.book-detail-info h1 {
  margin: 0;
  color: #111827;
  font-size: 34px;
  line-height: 1.2;
  font-weight: 700;
}

.book-detail-author {
  margin: 10px 0 30px;
  color: #6b7280;
  font-size: 17px;
}

.book-detail-meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
  margin-bottom: 24px;
}

.book-detail-meta > div {
  min-width: 0;

  padding: 17px;

  border: 1px solid rgba(148, 163, 184, 0.20);
  border-radius: 14px;

  background: rgba(255, 255, 255, 0.72);

  box-shadow:
    0 8px 24px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);

  backdrop-filter: blur(10px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.book-detail-meta > div:hover {
  transform: translateY(-3px);

  border-color: rgba(59, 130, 246, 0.25);

  box-shadow:
    0 14px 30px rgba(15, 23, 42, 0.08),
    0 0 20px rgba(59, 130, 246, 0.05);
}

.book-detail-meta > div {
  padding: 16px;
  border: 1px solid #e5e7eb;
  border-radius: 10px;
  background: #ffffff;
}

.book-detail-meta span {
  display: block;
  margin-bottom: 7px;
  color: #6b7280;
  font-size: 12px;
}

.book-detail-meta strong {
  display: block;
  color: #111827;
  font-size: 14px;
  line-height: 1.4;
  word-break: break-word;
}

.book-detail-availability {
  position: relative;

  display: flex;
  flex-direction: column;
  gap: 6px;

  padding: 19px 20px;
  margin-bottom: 18px;

  border: 1px solid rgba(34, 197, 94, 0.18);
  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      rgba(240, 253, 244, 0.95),
      rgba(255, 255, 255, 0.85)
    );

  box-shadow:
    0 10px 25px rgba(22, 163, 74, 0.06);

  overflow: hidden;
}

.book-detail-availability::before {
  content: "";

  position: absolute;
  width: 100px;
  height: 100px;

  right: -30px;
  top: -45px;

  background: rgba(34, 197, 94, 0.10);

  filter: blur(25px);
  border-radius: 50%;
}

.book-detail-availability strong {
  position: relative;
  z-index: 1;

  color: #15803d;
  font-size: 16px;
}

.book-detail-availability span {
  position: relative;
  z-index: 1;

  color: #6b7280;
  font-size: 14px;
}

.book-detail-availability strong {
  color: #15803d;
  font-size: 16px;
}

.book-detail-availability span {
  color: #6b7280;
  font-size: 14px;
}

.book-detail-location {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  color: #4b5563;
  font-size: 14px;
}

.book-detail-location svg {
  flex-shrink: 0;
}

.book-detail-description {
  padding-top: 24px;
  border-top: 1px solid #e5e7eb;
}

.book-detail-description h2 {
  margin: 0 0 10px;
  color: #111827;
  font-size: 20px;
}

.book-detail-description p {
  margin: 0;
  color: #4b5563;
  font-size: 15px;
  line-height: 1.8;
}

/* =========================
   RESPONSIVE DETAIL
   ========================= */

@media (max-width: 800px) {
  .book-detail-wrapper {
    width: min(100% - 36px, 600px);
  }

  .book-detail {
    grid-template-columns: 1fr;
    gap: 34px;
    padding: 32px 0 60px;
  }

  .book-detail-cover {
    width: 240px;
    height: 330px;
    margin: 0 auto;

    transform: none;
  }

  .book-detail-cover:hover {
    transform: translateY(-6px);
  }

  .book-detail-info h1 {
    font-size: 30px;
  }

  .book-detail-meta {
    grid-template-columns: 1fr;
  }

  .catalog-back-button {
    margin-left: 0;
  }
}

/* =========================================================
   CATALOG 3D / WEB3 — FOUNDATION
   ========================================================= */

.catalog-page {
  position: relative;
  min-height: 100vh;

  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(59, 130, 246, 0.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 15%,
      rgba(139, 92, 246, 0.07),
      transparent 30%
    ),
    linear-gradient(
      180deg,
      #f8fafc 0%,
      #ffffff 45%,
      #f8fafc 100%
    );

  overflow: hidden;
}

/* =========================================================
   HEADER
   ========================================================= */

.catalog-header {
  position: relative;
  z-index: 10;

  background: rgba(255, 255, 255, 0.78);

  border-bottom: 1px solid rgba(148, 163, 184, 0.16);

  box-shadow:
    0 6px 20px rgba(15, 23, 42, 0.04),
    inset 0 -1px 0 rgba(255, 255, 255, 0.9);

  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

/* =========================================================
   LOGO
   ========================================================= */

.catalog-logo {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 42px;
  height: 42px;

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #3b82f6,
      #2563eb
    );

  color: #ffffff;

  box-shadow:
    0 10px 20px rgba(37, 99, 235, 0.20),
    0 4px 8px rgba(15, 23, 42, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.35);

  transform: translateY(0);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.catalog-logo:hover {
  transform: translateY(-3px);

  box-shadow:
    0 15px 28px rgba(37, 99, 235, 0.25),
    0 6px 12px rgba(15, 23, 42, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.4);
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.catalog-nav a {
  position: relative;

  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.catalog-nav a:hover {
  color: #2563eb;

  transform: translateY(-2px);
}

.catalog-nav a::after {
  content: "";

  position: absolute;

  left: 50%;
  bottom: -8px;

  width: 0;
  height: 2px;

  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      #3b82f6,
      #8b5cf6
    );

  transform: translateX(-50%);

  transition: width 0.25s ease;
}

.catalog-nav a:hover::after {
  width: 70%;
}

/* =========================================================
   HERO
   ========================================================= */

.catalog-hero {
  position: relative;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 75% 30%,
      rgba(59, 130, 246, 0.10),
      transparent 28%
    ),
    radial-gradient(
      circle at 25% 80%,
      rgba(139, 92, 246, 0.07),
      transparent 25%
    );
}

.catalog-hero::before {
  content: "";

  position: absolute;

  width: 320px;
  height: 320px;

  right: -100px;
  top: -130px;

  border-radius: 50%;

  background: rgba(59, 130, 246, 0.08);

  filter: blur(60px);

  pointer-events: none;
}

.catalog-hero::after {
  content: "";

  position: absolute;

  width: 260px;
  height: 260px;

  left: -120px;
  bottom: -140px;

  border-radius: 50%;

  background: rgba(139, 92, 246, 0.06);

  filter: blur(55px);

  pointer-events: none;
}

/* =========================================================
   HERO TITLE
   ========================================================= */

.catalog-hero h1 {
  position: relative;
  z-index: 1;

  letter-spacing: -0.035em;

  text-shadow:
    0 2px 10px rgba(15, 23, 42, 0.05);
}

/* =========================================================
   SEARCH
   ========================================================= */

.catalog-search-section {
  position: relative;
  z-index: 5;
}

.catalog-search-box {
  position: relative;

  border: 1px solid rgba(148, 163, 184, 0.20);

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(248, 250, 252, 0.88)
    );

  border-radius: 16px;

  box-shadow:
    0 18px 40px rgba(15, 23, 42, 0.08),
    0 5px 12px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  transition:
    box-shadow 0.25s ease,
    transform 0.25s ease,
    border-color 0.25s ease;
}

.catalog-search-box:focus-within {
  transform: translateY(-2px);

  border-color: rgba(59, 130, 246, 0.28);

  box-shadow:
    0 22px 45px rgba(15, 23, 42, 0.10),
    0 0 25px rgba(59, 130, 246, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.catalog-search-box input {
  background: transparent;

  outline: none;
}

.catalog-search-box input:focus {
  outline: none;
}

/* =========================================================
   SEARCH BUTTON
   ========================================================= */

.catalog-search-box button {
  position: relative;

  border: 1px solid rgba(37, 99, 235, 0.35);

  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      #3b82f6,
      #2563eb
    );

  color: #ffffff;

  font-weight: 600;

  box-shadow:
    0 10px 20px rgba(37, 99, 235, 0.22),
    0 4px 8px rgba(15, 23, 42, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);

  transform: translateY(0);

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    filter 0.18s ease;
}

.catalog-search-box button:hover {
  transform: translateY(-3px);

  filter: brightness(1.04);

  box-shadow:
    0 15px 28px rgba(37, 99, 235, 0.27),
    0 6px 12px rgba(15, 23, 42, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

.catalog-search-box button:active {
  transform: translateY(1px);

  box-shadow:
    0 5px 10px rgba(37, 99, 235, 0.18),
    inset 0 2px 5px rgba(15, 23, 42, 0.16);
}

/* =========================================================
   CATALOG 3D / WEB3 — FILTER & SORTING
   ========================================================= */

/* FILTER PANEL */

.catalog-filter {
  position: relative;

  padding: 22px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(248, 250, 252, 0.90)
    );

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;

  box-shadow:
    0 20px 40px rgba(15, 23, 42, 0.07),
    0 5px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.catalog-filter:hover {
  transform: translateY(-2px);

  box-shadow:
    0 25px 50px rgba(15, 23, 42, 0.09),
    0 8px 16px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* FILTER TITLE */

.catalog-filter h2,
.catalog-filter h3 {
  color: #1e293b;
}

/* FILTER LABEL */

.catalog-filter label {
  color: #64748b;
}

/* FILTER SELECT */

.catalog-filter select {
  width: 100%;

  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f8fafc
    );

  color: #334155;

  box-shadow:
    0 5px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
}

.catalog-filter select:hover {
  transform: translateY(-1px);

  border-color: rgba(59, 130, 246, 0.25);

  box-shadow:
    0 8px 16px rgba(15, 23, 42, 0.06);
}

.catalog-filter select:focus {
  outline: none;

  border-color: rgba(59, 130, 246, 0.40);

  box-shadow:
    0 0 0 3px rgba(59, 130, 246, 0.08),
    0 8px 18px rgba(15, 23, 42, 0.06);
}

/* AVAILABILITY CHECKBOX AREA */

.catalog-filter input[type="checkbox"] {
  accent-color: #2563eb;
}

.catalog-filter input[type="checkbox"] + span {
  transition: color 0.2s ease;
}

/* =========================================================
   RESULTS HEADER
   ========================================================= */

.results-header {
  position: relative;

  margin-bottom: 20px;
}

/* SORTING */

.results-header select {
  min-width: 145px;

  padding: 10px 14px;

  border: 1px solid rgba(148, 163, 184, 0.20);
  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(248, 250, 252, 0.92)
    );

  color: #475569;

  box-shadow:
    0 7px 16px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  cursor: pointer;

  transition:
    transform 0.2s ease,
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.results-header select:hover {
  transform: translateY(-2px);

  border-color: rgba(59, 130, 246, 0.25);

  box-shadow:
    0 11px 22px rgba(15, 23, 42, 0.07);
}

.results-header select:focus {
  outline: none;

  border-color: rgba(59, 130, 246, 0.40);

  box-shadow:
    0 0 0 3px rgba(59, 130, 246, 0.08),
    0 10px 20px rgba(15, 23, 42, 0.06);
}

/* =========================================================
   CATALOG 3D / WEB3 — BOOK CARDS
   ========================================================= */

.catalog-book-card {
  position: relative;

  overflow: hidden;

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.97),
      rgba(248, 250, 252, 0.92)
    );

  box-shadow:
    0 18px 35px rgba(15, 23, 42, 0.07),
    0 5px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;

  transform: translateY(0);
}

.catalog-book-card::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 5% 50%,
      rgba(59, 130, 246, 0.08),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.35),
      transparent 45%
    );

  pointer-events: none;
}

.catalog-book-card:hover {
  transform: translateY(-6px);

  border-color: rgba(59, 130, 246, 0.24);

  box-shadow:
    0 28px 55px rgba(15, 23, 42, 0.11),
    0 10px 20px rgba(37, 99, 235, 0.07),
    0 0 30px rgba(59, 130, 246, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* =========================================================
   BOOK COVER
   ========================================================= */

.catalog-book-cover {
  position: relative;

  overflow: hidden;

  border-radius: 14px;

  box-shadow:
    0 15px 25px rgba(15, 23, 42, 0.14),
    0 5px 10px rgba(15, 23, 42, 0.08);

  transform:
    perspective(900px)
    rotateY(-3deg);

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.catalog-book-card:hover .catalog-book-cover {
  transform:
    perspective(900px)
    rotateY(0deg)
    translateY(-3px);

  box-shadow:
    0 20px 35px rgba(15, 23, 42, 0.18),
    0 8px 14px rgba(37, 99, 235, 0.08);
}

.catalog-book-cover::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      110deg,
      rgba(255, 255, 255, 0.20),
      transparent 35%,
      transparent 65%,
      rgba(255, 255, 255, 0.06)
    );

  pointer-events: none;
}

/* =========================================================
   BOOK INFORMATION
   ========================================================= */

.catalog-book-card .book-info,
.catalog-book-card .book-details {
  position: relative;
  z-index: 2;
}

.catalog-book-card h3 {
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.catalog-book-card:hover h3 {
  color: #2563eb;

  transform: translateX(2px);
}

/* =========================================================
   CATEGORY BADGE
   ========================================================= */

.catalog-book-card .book-category {
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.catalog-book-card:hover .book-category {
  transform: translateY(-2px);

  box-shadow:
    0 6px 14px rgba(37, 99, 235, 0.10);
}

/* =========================================================
   AVAILABILITY
   ========================================================= */

.catalog-book-card .book-availability {
  position: relative;
  z-index: 2;
}

.catalog-book-card .book-availability span {
  transition:
    transform 0.2s ease;
}

.catalog-book-card:hover .book-availability span {
  transform: translateX(2px);
}

/* =========================================================
   DETAIL BUTTON
   ========================================================= */

.catalog-book-card a {
  transition:
    transform 0.2s ease,
    color 0.2s ease;
}

.catalog-book-card a:hover {
  transform: translateX(3px);

  color: #2563eb;
}

/* =========================================================
   FAVORITE BUTTON
   ========================================================= */

.catalog-book-card button {
  position: relative;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.catalog-book-card button:hover {
  transform:
    translateY(-3px)
    scale(1.05);

  box-shadow:
    0 8px 18px rgba(15, 23, 42, 0.10);
}

.catalog-book-card button:active {
  transform:
    translateY(1px)
    scale(0.98);
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .catalog-book-card:hover {
    transform: translateY(-3px);
  }

  .catalog-book-cover {
    transform: none;
  }

  .catalog-book-card:hover .catalog-book-cover {
    transform: translateY(-2px);
  }
}

/* =========================================================
   CATALOG — BOOK CARD DEPTH UPGRADE
   ========================================================= */

.catalog-book-card {
  isolation: isolate;
  transform-style: preserve-3d;
  will-change: transform;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(246, 249, 253, 0.94)
    );

  box-shadow:
    0 2px 0 rgba(255, 255, 255, 0.9) inset,
    0 18px 30px rgba(15, 23, 42, 0.07),
    0 5px 10px rgba(15, 23, 42, 0.04);
}

.catalog-book-card:hover {
  transform:
    translateY(-8px)
    perspective(1200px)
    rotateX(1deg);

  box-shadow:
    0 2px 0 rgba(255, 255, 255, 1) inset,
    0 32px 55px rgba(15, 23, 42, 0.13),
    0 12px 24px rgba(37, 99, 235, 0.08),
    0 0 35px rgba(99, 102, 241, 0.06);
}

/* ---------------------------------------------------------
   COVER DEPTH
   --------------------------------------------------------- */

.catalog-book-cover {
  transform-style: preserve-3d;

  box-shadow:
    8px 12px 22px rgba(15, 23, 42, 0.15),
    2px 4px 8px rgba(15, 23, 42, 0.08);
}

.catalog-book-card:hover .catalog-book-cover {
  transform:
    perspective(900px)
    rotateY(-1deg)
    translateY(-7px)
    translateZ(12px);

  box-shadow:
    12px 20px 30px rgba(15, 23, 42, 0.19),
    3px 6px 10px rgba(37, 99, 235, 0.08);
}

/* ---------------------------------------------------------
   BOOK INFORMATION
   --------------------------------------------------------- */

.catalog-book-card h3 {
  transition:
    color 0.25s ease,
    transform 0.25s ease,
    text-shadow 0.25s ease;
}

.catalog-book-card:hover h3 {
  color: #2563eb;

  transform:
    translateX(3px)
    translateZ(5px);

  text-shadow:
    0 4px 12px rgba(37, 99, 235, 0.10);
}

/* ---------------------------------------------------------
   FAVORITE BUTTON — FLOATING
   --------------------------------------------------------- */

.catalog-book-card button {
  border: 1px solid rgba(148, 163, 184, 0.20);

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(241, 245, 249, 0.90)
    );

  box-shadow:
    0 7px 14px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.catalog-book-card button:hover {
  transform:
    translateY(-4px)
    scale(1.06);

  border-color: rgba(99, 102, 241, 0.25);

  box-shadow:
    0 12px 22px rgba(15, 23, 42, 0.12),
    0 0 18px rgba(99, 102, 241, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* ---------------------------------------------------------
   DETAIL LINK
   --------------------------------------------------------- */

.catalog-book-card a {
  position: relative;

  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 7px 10px;

  border-radius: 9px;

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.catalog-book-card a:hover {
  transform: translateY(-3px);

  background:
    rgba(59, 130, 246, 0.06);

  box-shadow:
    0 7px 15px rgba(37, 99, 235, 0.08);
}

.catalog-book-card a:active {
  transform: translateY(1px);

  box-shadow:
    inset 0 2px 4px rgba(15, 23, 42, 0.08);
}

/* ---------------------------------------------------------
   AVAILABILITY STATUS
   --------------------------------------------------------- */

.catalog-book-card .book-availability {
  transition:
    transform 0.25s ease,
    filter 0.25s ease;
}

.catalog-book-card:hover .book-availability {
  transform: translateX(3px);
}

/* ---------------------------------------------------------
   MOBILE
   --------------------------------------------------------- */

@media (max-width: 800px) {
  .catalog-book-card:hover {
    transform: translateY(-4px);
  }

  .catalog-book-card:hover .catalog-book-cover {
    transform: translateY(-4px);
  }
}

/* =========================================================
   CATALOG — CARD STATUS & PAGINATION
   ========================================================= */

/* STATUS TERSEDIA */

.catalog-book-card .book-availability {
  display: inline-flex;
  align-items: center;
  gap: 7px;

  width: fit-content;

  margin-top: 12px;
  padding: 7px 11px;

  border: 1px solid rgba(34, 197, 94, 0.18);
  border-radius: 999px;

  background:
    linear-gradient(
      145deg,
      rgba(240, 253, 244, 0.95),
      rgba(255, 255, 255, 0.90)
    );

  box-shadow:
    0 5px 12px rgba(22, 163, 74, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.catalog-book-card:hover .book-availability {
  transform: translateY(-2px);

  box-shadow:
    0 8px 16px rgba(22, 163, 74, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.catalog-book-card .book-availability span {
  color: #15803d;
  font-weight: 600;
}


/* =========================================================
   FAVORITE BUTTON
   ========================================================= */

.catalog-book-card button {
  width: 38px;
  height: 38px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border-radius: 11px;

  cursor: pointer;
}

.catalog-book-card button svg {
  transition:
    transform 0.2s ease,
    filter 0.2s ease;
}

.catalog-book-card button:hover svg {
  transform: scale(1.10);

  filter:
    drop-shadow(
      0 3px 5px rgba(99, 102, 241, 0.18)
    );
}


/* =========================================================
   PAGINATION
   ========================================================= */

.catalog-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  margin-top: 34px;
}

.catalog-pagination button {
  position: relative;

  min-width: 40px;
  height: 40px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: 0 12px;

  border: 1px solid rgba(148, 163, 184, 0.20);
  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.97),
      rgba(241, 245, 249, 0.92)
    );

  color: #475569;

  font-size: 14px;
  font-weight: 600;

  box-shadow:
    0 7px 15px rgba(15, 23, 42, 0.06),
    0 2px 4px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  cursor: pointer;

  transform: translateY(0);

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease;
}

.catalog-pagination button:hover:not(:disabled) {
  transform: translateY(-3px);

  border-color: rgba(59, 130, 246, 0.28);

  color: #2563eb;

  box-shadow:
    0 12px 22px rgba(15, 23, 42, 0.09),
    0 4px 9px rgba(37, 99, 235, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.catalog-pagination button:active:not(:disabled) {
  transform: translateY(1px);

  box-shadow:
    0 4px 8px rgba(15, 23, 42, 0.08),
    inset 0 2px 5px rgba(15, 23, 42, 0.07);
}

.catalog-pagination button:disabled {
  opacity: 0.45;

  cursor: not-allowed;

  box-shadow:
    0 3px 7px rgba(15, 23, 42, 0.04);
}


/* =========================================================
   EMPTY STATE
   ========================================================= */

.catalog-results-empty {
  padding: 55px 30px;

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(248, 250, 252, 0.90)
    );

  text-align: center;

  box-shadow:
    0 18px 35px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}


/* =========================================================
   LOADING
   ========================================================= */

.catalog-loading {
  padding: 50px;

  text-align: center;

  color: #64748b;
}

/* =========================================================
   CATALOG — FINAL RESPONSIVE POLISH
   ========================================================= */

@media (max-width: 800px) {
  .catalog-page {
    overflow-x: hidden;
  }

  /* SEARCH */

  .catalog-search-box {
    border-radius: 14px;

    box-shadow:
      0 14px 28px rgba(15, 23, 42, 0.07),
      0 4px 9px rgba(15, 23, 42, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .catalog-search-box:focus-within {
    transform: none;
  }

  /* FILTER */

  .catalog-filter {
    border-radius: 16px;

    box-shadow:
      0 15px 30px rgba(15, 23, 42, 0.07),
      0 4px 10px rgba(15, 23, 42, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .catalog-filter:hover {
    transform: none;
  }

  /* BOOK CARD */

  .catalog-book-card {
    border-radius: 16px;

    box-shadow:
      0 14px 28px rgba(15, 23, 42, 0.07),
      0 4px 9px rgba(15, 23, 42, 0.04),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .catalog-book-card:hover {
    transform: translateY(-4px);
  }

  .catalog-book-cover {
    border-radius: 12px;

    box-shadow:
      6px 10px 18px rgba(15, 23, 42, 0.13),
      2px 4px 7px rgba(15, 23, 42, 0.07);
  }

  .catalog-book-card:hover .catalog-book-cover {
    transform:
      translateY(-4px)
      translateZ(5px);
  }

  /* PAGINATION */

  .catalog-pagination {
    gap: 7px;
    margin-top: 28px;
  }

  .catalog-pagination button {
    min-width: 38px;
    height: 38px;

    border-radius: 10px;

    box-shadow:
      0 6px 13px rgba(15, 23, 42, 0.06),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  .catalog-pagination button:hover:not(:disabled) {
    transform: translateY(-2px);
  }
}


/* =========================================================
   EXTRA SMALL SCREEN
   ========================================================= */

@media (max-width: 480px) {
  .catalog-book-card {
    border-radius: 14px;
  }

  .catalog-book-cover {
    border-radius: 11px;
  }

  .catalog-pagination {
    gap: 5px;
  }

  .catalog-pagination button {
    min-width: 36px;
    height: 36px;

    padding: 0 9px;

    font-size: 13px;
  }
}

/* =========================================================
   UMA HOMEPAGE — PREMIUM 3D DEPTH SYSTEM
   ========================================================= */

/* =========================
   GLOBAL DEPTH
   ========================= */

.library-page {
  perspective: 1400px;
}

.library-page button,
.library-page a,
.library-page article,
.library-page .service-card,
.library-page .student-card,
.library-page .agenda-card,
.library-page .promo {
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease,
    background 0.25s ease;
}


/* =========================
   HEADER
   ========================= */

.top-header {
  position: relative;
  z-index: 20;
  box-shadow:
    0 1px 0 rgba(15, 23, 42, 0.04),
    0 8px 24px rgba(15, 23, 42, 0.035);
}


/* =========================
   HERO
   ========================= */

.hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

.hero-background {
  transform: translateZ(-1px);
}

.hero-content {
  position: relative;
  z-index: 3;
}

.hero-copy {
  transform: translateZ(20px);
}

.hero-card {
  transform:
    perspective(1000px)
    rotateY(-4deg)
    rotateX(2deg)
    translateZ(35px);

  box-shadow:
    0 24px 55px rgba(15, 23, 42, 0.16),
    0 8px 20px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.28);

  border: 1px solid rgba(255, 255, 255, 0.28);
}

.hero-card:hover {
  transform:
    perspective(1000px)
    rotateY(-2deg)
    rotateX(1deg)
    translateY(-5px)
    translateZ(45px);

  box-shadow:
    0 32px 70px rgba(15, 23, 42, 0.2),
    0 12px 25px rgba(15, 23, 42, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.32);
}

.hero-stats > div {
  transform: translateZ(15px);
}


/* =========================
   SEARCH
   ========================= */

.search-wrapper {
  position: relative;
  z-index: 10;
}

.search-box {
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.11),
    0 5px 14px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.75);
}

.search-box:focus-within {
  transform: translateY(-2px);

  box-shadow:
    0 22px 50px rgba(15, 23, 42, 0.14),
    0 7px 18px rgba(15, 23, 42, 0.07);
}

.search-button {
  box-shadow:
    0 7px 16px rgba(37, 99, 235, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

.search-button:hover {
  transform: translateY(-2px);
  box-shadow:
    0 10px 20px rgba(37, 99, 235, 0.28);
}

.search-button:active {
  transform: translateY(0);
}


/* =========================
   QUICK SERVICES
   ========================= */

.service-card {
  position: relative;

  box-shadow:
    0 10px 25px rgba(15, 23, 42, 0.06),
    0 2px 7px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.7);

  border: 1px solid rgba(226, 232, 240, 0.8);
}

.service-card:hover {
  transform:
    translateY(-6px)
    translateZ(12px);

  box-shadow:
    0 20px 40px rgba(15, 23, 42, 0.11),
    0 5px 12px rgba(15, 23, 42, 0.06);
}

.service-icon {
  box-shadow:
    0 7px 16px rgba(37, 99, 235, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}


/* =========================
   BOOK CARDS
   ========================= */

.book-card {
  position: relative;

  box-shadow:
    0 12px 28px rgba(15, 23, 42, 0.07),
    0 3px 8px rgba(15, 23, 42, 0.04);
}

.book-card:hover {
  transform:
    translateY(-7px)
    rotateX(1deg);

  box-shadow:
    0 24px 45px rgba(15, 23, 42, 0.12),
    0 7px 16px rgba(15, 23, 42, 0.06);
}

.book-cover {
  box-shadow:
    0 12px 25px rgba(15, 23, 42, 0.15),
    3px 4px 0 rgba(15, 23, 42, 0.035);
  transform: translateZ(10px);
}

.book-card:hover .book-cover {
  transform:
    translateY(-3px)
    translateZ(18px);
}


/* =========================
   FAVORITE
   ========================= */

.book-bottom button,
.favorite-button {
  box-shadow:
    0 5px 12px rgba(15, 23, 42, 0.06);
}

.book-bottom button:hover,
.favorite-button:hover {
  transform: translateY(-2px) scale(1.04);
}


/* =========================
   STUDENT CARD
   ========================= */

.student-card {
  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.08),
    0 4px 10px rgba(15, 23, 42, 0.04);
}

.student-card:hover {
  transform: translateY(-4px);

  box-shadow:
    0 24px 45px rgba(15, 23, 42, 0.11),
    0 7px 15px rgba(15, 23, 42, 0.05);
}

.large-avatar {
  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.student-stats > div {
  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.student-stats > div:hover {
  transform: translateY(-3px);
}


/* =========================
   AGENDA
   ========================= */

.agenda-card {
  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.07),
    0 4px 10px rgba(15, 23, 42, 0.035);
}

.agenda-card:hover {
  transform: translateY(-3px);

  box-shadow:
    0 22px 42px rgba(15, 23, 42, 0.09);
}

.agenda-item {
  transition:
    transform 0.2s ease,
    background 0.2s ease;
}

.agenda-item:hover {
  transform: translateX(4px);
}

.agenda-icon {
  box-shadow:
    0 5px 12px rgba(15, 23, 42, 0.06);
}


/* =========================
   PROMO CARDS
   ========================= */

.promo {
  position: relative;

  box-shadow:
    0 14px 30px rgba(15, 23, 42, 0.08),
    0 4px 10px rgba(15, 23, 42, 0.04);
}

.promo:hover {
  transform:
    translateY(-6px)
    translateZ(12px);

  box-shadow:
    0 24px 48px rgba(15, 23, 42, 0.13),
    0 7px 15px rgba(15, 23, 42, 0.06);
}

.promo button {
  box-shadow:
    0 7px 16px rgba(15, 23, 42, 0.1);
}

.promo button:hover {
  transform: translateY(-2px);
}


/* =========================
   ROBOT / AI
   ========================= */

.robot {
  box-shadow:
    0 12px 25px rgba(14, 165, 233, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.45);
}


/* =========================
   CATEGORY TABS
   ========================= */

.category-tabs button {
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    color 0.2s ease;
}

.category-tabs button:hover {
  transform: translateY(-2px);
}


/* =========================
   REDUCE MOTION
   ========================= */

@media (prefers-reduced-motion: reduce) {
  .library-page *,
  .library-page *::before,
  .library-page *::after {
    transition: none !important;
    animation: none !important;
    transform: none !important;
  }
}


/* =========================
   MOBILE
   ========================= */

@media (max-width: 800px) {
  .hero-card {
    transform: none;
  }

  .hero-card:hover {
    transform: translateY(-3px);
  }

  .book-card:hover,
  .service-card:hover,
  .promo:hover {
    transform: translateY(-3px);
  }
}

/* =========================================================
   HOMEPAGE — QUICK SERVICES 3D
   ========================================================= */

.quick-services {
  perspective: 1200px;
}

.service-card {
  position: relative;
  overflow: hidden;

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 250, 252, 0.94)
    );

  box-shadow:
    0 12px 25px rgba(15, 23, 42, 0.06),
    0 4px 9px rgba(15, 23, 42, 0.035),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transform:
    translateZ(0);

  will-change: transform, box-shadow;
}

/* lapisan cahaya halus */

.service-card::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.65),
      transparent 45%
    );

  pointer-events: none;
}

/* garis highlight bagian atas */

.service-card::after {
  content: "";

  position: absolute;
  left: 12%;
  right: 12%;
  top: 0;

  height: 1px;

  background: rgba(255, 255, 255, 0.95);

  pointer-events: none;
}

.service-card:hover {
  transform:
    translateY(-7px)
    translateZ(14px);

  border-color: rgba(59, 130, 246, 0.20);

  box-shadow:
    0 24px 45px rgba(15, 23, 42, 0.11),
    0 8px 17px rgba(37, 99, 235, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* =========================================================
   ICON
   ========================================================= */

.service-icon {
  position: relative;
  z-index: 1;

  border: 1px solid rgba(59, 130, 246, 0.10);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(239, 246, 255, 0.95),
      rgba(255, 255, 255, 0.92)
    );

  box-shadow:
    0 8px 17px rgba(37, 99, 235, 0.08),
    0 2px 5px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 1);

  transform:
    translateZ(12px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.service-card:hover .service-icon {
  transform:
    translateY(-3px)
    translateZ(20px)
    rotate(-2deg);

  box-shadow:
    0 13px 25px rgba(37, 99, 235, 0.13),
    0 4px 8px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* =========================================================
   TEXT
   ========================================================= */

.service-card strong,
.service-card span {
  position: relative;
  z-index: 1;
}

.service-card strong {
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.service-card:hover strong {
  color: #2563eb;
  transform: translateY(-1px);
}

.service-card span {
  color: #64748b;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .service-card:hover {
    transform: translateY(-4px);
  }

  .service-card:hover .service-icon {
    transform: translateY(-2px) translateZ(10px);
  }
}

/* =========================================================
   HOMEPAGE — QUICK SERVICES 3D
   ========================================================= */

.quick-services {
  perspective: 1200px;
}

.service-card {
  position: relative;
  overflow: hidden;

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 250, 252, 0.94)
    );

  box-shadow:
    0 12px 25px rgba(15, 23, 42, 0.06),
    0 4px 9px rgba(15, 23, 42, 0.035),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transform:
    translateZ(0);

  will-change: transform, box-shadow;
}

/* lapisan cahaya halus */

.service-card::before {
  content: "";

