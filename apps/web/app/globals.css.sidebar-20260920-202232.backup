.service-card::after {
  content: "";

  position: absolute;
  left: 12%;
  right: 12%;
  top: 0;

  height: 1px;

  background: rgba(255, 255, 255, 0.95);

  pointer-events: none;
}

.service-card:hover {
  transform:
    translateY(-7px)
    translateZ(14px);

  border-color: rgba(59, 130, 246, 0.20);

  box-shadow:
    0 24px 45px rgba(15, 23, 42, 0.11),
    0 8px 17px rgba(37, 99, 235, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* =========================================================
   ICON
   ========================================================= */

.service-icon {
  position: relative;
  z-index: 1;

  border: 1px solid rgba(59, 130, 246, 0.10);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      rgba(239, 246, 255, 0.95),
      rgba(255, 255, 255, 0.92)
    );

  box-shadow:
    0 8px 17px rgba(37, 99, 235, 0.08),
    0 2px 5px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 1);

  transform:
    translateZ(12px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.service-card:hover .service-icon {
  transform:
    translateY(-3px)
    translateZ(20px)
    rotate(-2deg);

  box-shadow:
    0 13px 25px rgba(37, 99, 235, 0.13),
    0 4px 8px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

/* =========================================================
   TEXT
   ========================================================= */

.service-card strong,
.service-card span {
  position: relative;
  z-index: 1;
}

.service-card strong {
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.service-card:hover strong {
  color: #2563eb;
  transform: translateY(-1px);
}

.service-card span {
  color: #64748b;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .service-card:hover {
    transform: translateY(-4px);
  }

  .service-card:hover .service-icon {
    transform: translateY(-2px) translateZ(10px);
  }
}

/* =========================================================
   HOMEPAGE — SIDEBAR & PROMO 3D
   ========================================================= */

/* =========================================================
   STUDENT CARD
   ========================================================= */

.student-card {
  position: relative;
  overflow: hidden;

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 250, 252, 0.93)
    );

  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.07),
    0 5px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transform-style: preserve-3d;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.student-card::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 0% 0%,
      rgba(59, 130, 246, 0.08),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.45),
      transparent 45%
    );

  pointer-events: none;
}

.student-card:hover {
  transform:
    translateY(-6px)
    translateZ(10px);

  border-color: rgba(59, 130, 246, 0.22);

  box-shadow:
    0 27px 50px rgba(15, 23, 42, 0.11),
    0 8px 18px rgba(37, 99, 235, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.student-profile {
  position: relative;
  z-index: 2;
}

.large-avatar {
  transform:
    translateZ(12px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.student-card:hover .large-avatar {
  transform:
    translateY(-3px)
    translateZ(20px);

  box-shadow:
    0 12px 24px rgba(37, 99, 235, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

.student-profile > svg {
  transition:
    transform 0.2s ease;
}

.student-card:hover .student-profile > svg {
  transform: translateX(3px);
}


/* =========================================================
   STUDENT STATISTICS
   ========================================================= */

.student-stats {
  position: relative;
  z-index: 2;
}

.student-stats > div {
  position: relative;

  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.90),
      rgba(248, 250, 252, 0.78)
    );

  box-shadow:
    0 5px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.85);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.student-stats > div:hover {
  transform:
    translateY(-4px)
    translateZ(6px);

  border-color: rgba(59, 130, 246, 0.16);

  box-shadow:
    0 10px 20px rgba(15, 23, 42, 0.07),
    0 3px 8px rgba(37, 99, 235, 0.04);
}


/* =========================================================
   AGENDA CARD
   ========================================================= */

.agenda-card {
  position: relative;
  overflow: hidden;

  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 250, 252, 0.93)
    );

  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.07),
    0 5px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transform-style: preserve-3d;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease,
    border-color 0.3s ease;
}

.agenda-card::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(99, 102, 241, 0.07),
      transparent 30%
    );

  pointer-events: none;
}

.agenda-card:hover {
  transform:
    translateY(-5px)
    translateZ(8px);

  box-shadow:
    0 25px 48px rgba(15, 23, 42, 0.10),
    0 7px 16px rgba(15, 23, 42, 0.05);
}

.agenda-heading,
.agenda-list {
  position: relative;
  z-index: 2;
}

.agenda-heading a {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  padding: 7px 10px;

  border-radius: 9px;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.agenda-heading a:hover {
  transform: translateY(-2px);

  background: rgba(59, 130, 246, 0.05);

  box-shadow:
    0 6px 13px rgba(37, 99, 235, 0.06);
}


/* =========================================================
   AGENDA ITEM
   ========================================================= */

.agenda-item {
  position: relative;

  border-radius: 12px;

  transition:
    transform 0.22s ease,
    background 0.22s ease,
    box-shadow 0.22s ease;
}

.agenda-item:hover {
  transform:
    translateX(5px)
    translateZ(5px);

  background:
    rgba(248, 250, 252, 0.72);

  box-shadow:
    0 7px 15px rgba(15, 23, 42, 0.04);
}

.agenda-icon {
  transform:
    translateZ(8px);

  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease;
}

.agenda-item:hover .agenda-icon {
  transform:
    translateY(-2px)
    translateZ(14px);

  box-shadow:
    0 8px 16px rgba(15, 23, 42, 0.08);
}

.agenda-item b {
  box-shadow:
    0 5px 12px rgba(37, 99, 235, 0.10);
}


/* =========================================================
   PROMO GRID
   ========================================================= */

.promo-grid {
  perspective: 1200px;
}

.promo {
  position: relative;
  overflow: hidden;

  border: 1px solid rgba(255, 255, 255, 0.18);

  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.09),
    0 5px 12px rgba(15, 23, 42, 0.05);

  transform-style: preserve-3d;

  transition:
    transform 0.3s ease,
    box-shadow 0.3s ease;
}

.promo::after {
  content: "";

  position: absolute;
  inset: 0;

  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.16),
      transparent 40%
    );

  pointer-events: none;
}

.promo:hover {
  transform:
    translateY(-7px)
    rotateX(1deg)
    translateZ(12px);

  box-shadow:
    0 28px 55px rgba(15, 23, 42, 0.14),
    0 9px 20px rgba(15, 23, 42, 0.07);
}

.promo > div {
  position: relative;
  z-index: 2;
}


/* =========================================================
   PROMO BUTTONS
   ========================================================= */

.promo button {
  position: relative;

  border: 1px solid rgba(255, 255, 255, 0.20);

  box-shadow:
    0 8px 17px rgba(15, 23, 42, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.20);

  transform: translateZ(15px);

  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.promo button:hover {
  transform:
    translateY(-3px)
    translateZ(20px);

  box-shadow:
    0 13px 24px rgba(15, 23, 42, 0.16),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.promo button:active {
  transform:
    translateY(1px)
    translateZ(8px);

  box-shadow:
    0 4px 8px rgba(15, 23, 42, 0.10),
    inset 0 2px 4px rgba(15, 23, 42, 0.10);
}


/* =========================================================
   AI LIBRARIAN
   ========================================================= */

.ai-library {
  position: relative;
}

.ai-library .robot {
  transform:
    translateZ(20px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.ai-library:hover .robot {
  transform:
    translateY(-5px)
    translateZ(30px)
    rotate(-3deg);

  box-shadow:
    0 15px 30px rgba(14, 165, 233, 0.20),
    0 0 25px rgba(14, 165, 233, 0.08);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 800px) {
  .student-card:hover,
  .agenda-card:hover,
  .promo:hover {
    transform: translateY(-3px);
  }

  .student-stats > div:hover {
    transform: translateY(-2px);
  }

  .agenda-item:hover {
    transform: translateX(2px);
  }

  .ai-library:hover .robot {
    transform: translateY(-3px);
  }
}

/* Tarik kartu Agenda & Informasi lebih panjang ke bawah */
@media (min-width: 801px) {
  .agenda-card {
    min-height: 377px;
  }
}

/* =========================================================
   AGENDA — ISI PENUH RUANG YANG SUDAH TERSEDIA
   ========================================================= */

@media (min-width: 801px) {
  .agenda-card {
    display: flex;
    flex-direction: column;
    transform: translateY(7%);
  }

  .agenda-list {
    flex: 1;
    display: grid;
    grid-template-rows: repeat(4, 1fr);
  }

  .agenda-item {
    display: flex;
    align-items: center;
    min-height: 0;
  }
}

/* =========================================================
   SEARCH BOX — PENDEKKAN KE DALAM
   ========================================================= */

.search-wrapper {
  padding-right:60px;
}

.search-box {
  width: calc(100% - 24px);
}

/* =========================================
   PROFIL PENGGUNA
   ========================================= */

.profile-page {
  min-height: 100vh;
  padding: 120px 24px 60px;
  background:
    radial-gradient(circle at top left, rgba(70, 120, 255, 0.08), transparent 35%),
    linear-gradient(180deg, #f7f9fc 0%, #eef2f7 100%);
}

.profile-container {
  width: min(1100px, 100%);
  margin: 0 auto;
}

.profile-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 11px 17px;
  border: 1px solid #dce3ec;
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.9);
  color: #334155;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 5px 0 #d7dee8, 0 10px 22px rgba(15, 23, 42, 0.08);
  transition: 0.2s ease;
}

.profile-back:hover {
  transform: translateY(-2px);
  box-shadow: 0 7px 0 #d7dee8, 0 14px 25px rgba(15, 23, 42, 0.1);
}

.profile-back:active {
  transform: translateY(3px);
  box-shadow: 0 2px 0 #d7dee8;
}

.profile-hero {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 32px;
  margin-bottom: 24px;
  border: 1px solid #e1e7ef;
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 8px 0 #dce3ec,
    0 20px 45px rgba(15, 23, 42, 0.09);
}

.profile-avatar {
  width: 92px;
  height: 92px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24px;
  background: linear-gradient(145deg, #172554, #2563eb);
  color: white;
  font-size: 30px;
  font-weight: 900;
  box-shadow:
    inset 0 2px 2px rgba(255, 255, 255, 0.2),
    0 8px 0 #10204a,
    0 15px 25px rgba(37, 99, 235, 0.22);
}

.profile-hero-info h1 {
  margin: 0 0 7px;
  color: #172033;
  font-size: 28px;
  font-weight: 900;
}

.profile-hero-info p {
  margin: 0 0 8px;
  color: #526174;
  font-size: 16px;
  font-weight: 700;
}

.profile-hero-info span {
  color: #64748b;
  font-size: 14px;
  font-weight: 600;
}

.profile-section {
  margin-bottom: 24px;
  padding: 28px;
  border: 1px solid #e1e7ef;
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 6px 0 #e0e6ee,
    0 15px 35px rgba(15, 23, 42, 0.07);
}

.profile-section-title {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 22px;
  color: #1e3a8a;
}

.profile-section-title h2 {
  margin: 0;
  color: #172033;
  font-size: 18px;
  font-weight: 900;
}

.profile-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.profile-item {
  display: flex;
  align-items: center;
  gap: 14px;
  min-height: 76px;
  padding: 16px;
  border: 1px solid #e5eaf1;
  border-radius: 16px;
  background: #f8fafc;
}

.profile-item-icon {
  width: 42px;
  height: 42px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12px;
  background: #e8eefc;
  color: #3159b7;
}

.profile-item div:last-child {
  min-width: 0;
}

.profile-item span,
.profile-status span {
  display: block;
  margin-bottom: 4px;
  color: #718096;
  font-size: 12px;
  font-weight: 700;
}

.profile-item strong {
  display: block;
  color: #1e293b;
  font-size: 15px;
  font-weight: 800;
  word-break: break-word;
}

.profile-status {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.profile-status > div {
  padding: 18px;
  border-radius: 16px;
  background: #f8fafc;
  border: 1px solid #e5eaf1;
}

.profile-status strong {
  color: #1e293b;
  font-size: 15px;
}

.status-active {
  display: flex !important;
  align-items: center;
  gap: 8px;
}

.status-active i {
  width: 9px;
  height: 9px;
  display: inline-block;
  border-radius: 50%;
  background: #16a34a;
  box-shadow: 0 0 0 4px rgba(22, 163, 74, 0.12);
}

.profile-loading,
.profile-error {
  width: min(600px, 100%);
  margin: 150px auto;
  padding: 30px;
  text-align: center;
  border-radius: 20px;
  background: white;
  color: #475569;
  font-weight: 700;
  box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
}

@media (max-width: 700px) {
  .profile-page {
    padding: 95px 16px 40px;
  }

  .profile-hero {
    align-items: flex-start;
    padding: 24px;
  }

  .profile-avatar {
    width: 72px;
    height: 72px;
    border-radius: 20px;
    font-size: 24px;
  }

  .profile-hero-info h1 {
    font-size: 21px;
  }

  .profile-grid,
  .profile-status {
    grid-template-columns: 1fr;
  }

  .profile-section {
    padding: 22px;
  }
}

/* =========================================
   PROFILE DROPDOWN — UMA WEB3
   ========================================= */

.profile-menu-wrapper {
  position: relative;
  z-index: 1000;
}

.profile-mini {
  cursor: pointer;
}

.profile-chevron-open {
  transform: rotate(180deg);
  transition: transform 0.2s ease;
}

.profile-dropdown {
  position: absolute;
  top: calc(100% + 12px);
  right: 0;

  width: 245px;
  padding: 8px;

  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 18px;

  background: #ffffff;

  /* Shadow tunggal dan tipis — tanpa lapisan 3D bawah */
  box-shadow: 0 14px 30px rgba(15, 23, 42, 0.14);

  overflow: hidden;
  z-index: 1001;

  animation: profileDropdownIn 0.18s ease-out;
}

@keyframes profileDropdownIn {
  from {
    opacity: 0;
    transform: translateY(-5px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.profile-dropdown button {
  width: 100%;
  min-height: 48px;

  display: flex;
  align-items: center;
  gap: 12px;

  padding: 12px 13px;

  border: 0;
  border-radius: 12px;

  background: transparent;

  color: #334155;

  font-size: 14px;
  font-weight: 750;

  text-align: left;
  cursor: pointer;

  transition:
    background 0.16s ease,
    transform 0.16s ease;
}

.profile-dropdown button:hover {
  background: #f1f5f9;
  transform: translateX(2px);
}

.profile-dropdown button:active {
  transform: translateX(1px);
}

.profile-dropdown button svg {
  flex-shrink: 0;
}

.profile-dropdown-divider {
  height: 1px;
  margin: 7px 5px;

  background: rgba(148, 163, 184, 0.25);
}

.profile-dropdown .logout-button {
  color: #dc2626;
}

.profile-dropdown .logout-button:hover {
  background: #fef2f2;
}

.profile-dropdown button:disabled {
  opacity: 0.6;
  cursor: wait;
  transform: none;
}

@media (max-width: 700px) {
  .profile-dropdown {
    right: -8px;
    width: 220px;
  }
}

/* =========================================
   PEMINJAMAN — UMA WEB3 3D
   ========================================= */

.loan-page {
  min-height: 100vh;
  padding: 40px 24px 70px;
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(37, 99, 235, 0.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 85% 20%,
      rgba(14, 165, 233, 0.07),
      transparent 25%
    ),
    #f8fafc;
}

.loan-container {
  width: min(1120px, 100%);
  margin: 0 auto;
}

.loan-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid rgba(148, 163, 184, 0.32);
  border-radius: 13px;
  background: rgba(255, 255, 255, 0.9);
  color: #334155;
  font-size: 14px;
  font-weight: 750;
  cursor: pointer;
  box-shadow:
    0 5px 12px rgba(15, 23, 42, 0.07),
    0 1px 2px rgba(15, 23, 42, 0.05);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.loan-back:hover {
  transform: translateY(-2px);
  background: #ffffff;
  box-shadow:
    0 10px 22px rgba(15, 23, 42, 0.11),
    0 2px 4px rgba(15, 23, 42, 0.06);
}

.loan-back:active {
  transform: translateY(0);
}

.loan-header {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-top: 24px;
  padding: 30px 32px;
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    0 20px 45px rgba(15, 23, 42, 0.08),
    0 4px 10px rgba(15, 23, 42, 0.05);
  overflow: hidden;
}

.loan-header::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.7),
      transparent 55%
    );
  pointer-events: none;
}

.loan-eyebrow {
  position: relative;
  display: block;
  margin-bottom: 8px;
  color: #2563eb;
  font-size: 11px;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.loan-header h1 {
  position: relative;
  margin: 0;
  color: #0f172a;
  font-size: clamp(28px, 4vw, 40px);
  line-height: 1.1;
  font-weight: 850;
  letter-spacing: -0.035em;
}

.loan-header p {
  position: relative;
  max-width: 620px;
  margin: 10px 0 0;
  color: #64748b;
  font-size: 15px;
  line-height: 1.6;
}

.loan-header-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72px;
  height: 72px;
  flex-shrink: 0;
  border: 1px solid rgba(59, 130, 246, 0.18);
  border-radius: 20px;
  background: linear-gradient(
    145deg,
    #eff6ff,
    #dbeafe
  );
  color: #2563eb;
  box-shadow:
    0 12px 24px rgba(37, 99, 235, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.loan-list {
  display: grid;
  gap: 18px;
  margin-top: 24px;
}

.loan-card {
  position: relative;
  border: 1px solid rgba(148, 163, 184, 0.27);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.96);
  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.07),
    0 3px 8px rgba(15, 23, 42, 0.04);
  overflow: hidden;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.loan-card:hover {
  transform: translateY(-3px);
  box-shadow:
    0 22px 42px rgba(15, 23, 42, 0.1),
    0 5px 12px rgba(15, 23, 42, 0.05);
}

.loan-card-main {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 22px 24px;
}

.loan-book-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54px;
  height: 54px;
  flex-shrink: 0;
  border-radius: 16px;
  background: linear-gradient(
    145deg,
    #eff6ff,
    #dbeafe
  );
  color: #2563eb;
  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.loan-book-info {
  min-width: 0;
  flex: 1;
}

.loan-label {
  display: block;
  margin-bottom: 4px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.1em;
}

.loan-book-info h2 {
  margin: 0;
  color: #0f172a;
  font-size: 17px;
  line-height: 1.35;
  font-weight: 800;
}

.loan-book-info p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 13px;
}

.loan-book-info small {
  display: block;
  margin-top: 7px;
  color: #94a3b8;
  font-size: 11px;
}

.loan-status {
  flex-shrink: 0;
  padding: 8px 12px;
  border: 1px solid transparent;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  white-space: nowrap;
}

.loan-status-pending {
  background: #fff7ed;
  border-color: #fed7aa;
  color: #c2410c;
}

.loan-status-active {
  background: #eff6ff;
  border-color: #bfdbfe;
  color: #1d4ed8;
}

.loan-status-overdue {
  background: #fef2f2;
  border-color: #fecaca;
  color: #dc2626;
}

.loan-status-returned {
  background: #f0fdf4;
  border-color: #bbf7d0;
  color: #15803d;
}

.loan-status-cancelled,
.loan-status-rejected {
  background: #f8fafc;
  border-color: #e2e8f0;
  color: #64748b;
}

.loan-status-lost {
  background: #fef2f2;
  border-color: #fecaca;
  color: #b91c1c;
}

.loan-card-details {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid rgba(148, 163, 184, 0.18);
  background: #f8fafc;
}

.loan-detail {
  display: flex;
  align-items: center;
  gap: 11px;
  min-height: 76px;
  padding: 14px 20px;
}

.loan-detail + .loan-detail {
  border-left: 1px solid rgba(148, 163, 184, 0.18);
}

.loan-detail svg {
  flex-shrink: 0;
  color: #64748b;
}

.loan-detail span {
  display: block;
  margin-bottom: 3px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 750;
}

.loan-detail strong {
  display: block;
  color: #334155;
  font-size: 13px;
  font-weight: 800;
}

.loan-loading,
.loan-empty {
  margin-top: 24px;
  padding: 60px 24px;
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.95);
  text-align: center;
  color: #64748b;
  box-shadow:
    0 16px 35px rgba(15, 23, 42, 0.06),
    0 3px 8px rgba(15, 23, 42, 0.04);
}

.loan-empty svg {
  margin-bottom: 12px;
  color: #94a3b8;
}

.loan-empty h2 {
  margin: 0;
  color: #334155;
  font-size: 20px;
  font-weight: 800;
}

.loan-empty p {
  margin: 7px 0 0;
  color: #94a3b8;
  font-size: 14px;
}

@media (max-width: 700px) {
  .loan-page {
    padding: 24px 16px 50px;
  }

  .loan-header {
    padding: 24px 20px;
  }

  .loan-header-icon {
    width: 58px;
    height: 58px;
    border-radius: 16px;
  }

  .loan-card-main {
    align-items: flex-start;
    flex-wrap: wrap;
    padding: 20px;
  }

  .loan-status {
    margin-left: 70px;
  }

  .loan-card-details {
    grid-template-columns: 1fr;
  }

  .loan-detail {
    min-height: 64px;
  }

  .loan-detail + .loan-detail {
    border-left: 0;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
  }
}

/* =========================================================
   DETAIL PEMINJAMAN
   ========================================================= */

.loan-detail-page {
  min-height: 100vh;
  padding: 40px 24px 80px;
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(59, 130, 246, 0.08),
      transparent 30%
    ),
    radial-gradient(
      circle at 85% 20%,
      rgba(139, 92, 246, 0.07),
      transparent 30%
    ),
    #f8fafc;
}

.loan-detail-container {
  width: min(1180px, 100%);
  margin: 0 auto;
}

/* BACK BUTTON */

.loan-detail-page .loan-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 28px;
  padding: 10px 16px;
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.9);
  color: #475569;
  font-size: 14px;
  font-weight: 700;
  cursor: pointer;
  box-shadow:
    0 4px 12px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.loan-detail-page .loan-back:hover {
  transform: translateY(-2px);
  background: #ffffff;
  box-shadow:
    0 10px 24px rgba(15, 23, 42, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

/* HEADER */

.loan-detail-header {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
  padding: 34px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 26px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 250, 252, 0.95)
    );
  box-shadow:
    0 20px 45px rgba(15, 23, 42, 0.08),
    0 4px 12px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.loan-detail-header::before {
  content: "";
  position: absolute;
  top: -80px;
  right: -80px;
  width: 220px;
  height: 220px;
  border-radius: 50%;
  background: rgba(59, 130, 246, 0.07);
  filter: blur(3px);
}

.loan-detail-header h1 {
  position: relative;
  z-index: 1;
  margin: 8px 0 8px;
  color: #0f172a;
  font-size: clamp(28px, 4vw, 42px);
  line-height: 1.1;
  letter-spacing: -0.04em;
}

.loan-detail-header p {
  position: relative;
  z-index: 1;
  margin: 0;
  color: #64748b;
  font-size: 15px;
}

.loan-detail-status {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  padding: 11px 17px;
  border: 1px solid rgba(59, 130, 246, 0.16);
  border-radius: 999px;
  background: rgba(239, 246, 255, 0.95);
  color: #2563eb;
  font-size: 13px;
  font-weight: 800;
  white-space: nowrap;
  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

/* GRID */

.loan-detail-grid {
  display: grid;
  grid-template-columns: minmax(280px, 0.85fr) minmax(0, 1.4fr);
  gap: 24px;
  align-items: stretch;
}

/* BOOK CARD */

.loan-detail-book-card {
  position: relative;
  min-height: 360px;
  padding: 32px;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 26px;
  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f8fafc 60%,
      #eef4ff 100%
    );
  box-shadow:
    0 22px 45px rgba(15, 23, 42, 0.09),
    0 5px 14px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease;
}

.loan-detail-book-card:hover {
  transform: translateY(-4px);
  box-shadow:
    0 28px 55px rgba(15, 23, 42, 0.12),
    0 8px 18px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.loan-detail-book-card::after {
  content: "";
  position: absolute;
  right: -65px;
  bottom: -65px;
  width: 190px;
  height: 190px;
  border-radius: 50%;
  background: rgba(99, 102, 241, 0.06);
}

.loan-detail-book-icon {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82px;
  height: 82px;
  margin-bottom: 32px;
  border: 1px solid rgba(59, 130, 246, 0.16);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      #eff6ff,
      #dbeafe
    );
  color: #2563eb;
  box-shadow:
    0 14px 25px rgba(37, 99, 235, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.loan-detail-book-card .loan-label {
  position: relative;
  z-index: 1;
  display: block;
  margin-bottom: 8px;
  color: #94a3b8;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.loan-detail-book-card h2 {
  position: relative;
  z-index: 1;
  margin: 0 0 8px;
  color: #0f172a;
  font-size: 25px;
  line-height: 1.25;
  letter-spacing: -0.025em;
}

.loan-detail-book-card p {
  position: relative;
  z-index: 1;
  margin: 0;
  color: #64748b;
  font-size: 15px;
}

.loan-barcode {
  position: relative;
  z-index: 1;
  display: inline-block;
  margin-top: 28px;
  padding: 9px 12px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  font-family: monospace;
  font-size: 12px;
  box-shadow:
    0 4px 10px rgba(15, 23, 42, 0.04);
}

/* INFORMATION CARD */

.loan-detail-info-card {
  padding: 18px 26px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 26px;
  background: rgba(255, 255, 255, 0.97);
  box-shadow:
    0 22px 45px rgba(15, 23, 42, 0.08),
    0 5px 14px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.loan-info-row {
  display: flex;
  align-items: center;
  gap: 17px;
  min-height: 82px;
  padding: 13px 4px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
}

.loan-info-row:last-child {
  border-bottom: 0;
}

.loan-info-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 46px;
  height: 46px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 14px;
  background: #f8fafc;
  color: #64748b;
  box-shadow:
    0 5px 12px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 #ffffff;
}

.loan-info-row div:last-child {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.loan-info-row span {
  color: #94a3b8;
  font-size: 12px;
  font-weight: 700;
}

.loan-info-row strong {
  color: #1e293b;
  font-size: 15px;
  font-weight: 800;
}

/* LOADING */

.loan-detail-page .loan-loading {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 26px;
  background: #ffffff;
  color: #64748b;
  font-weight: 700;
  box-shadow:
    0 18px 40px rgba(15, 23, 42, 0.07);
}

/* MOBILE */

@media (max-width: 800px) {
  .loan-detail-page {
    padding: 24px 16px 60px;
  }

  .loan-detail-header {
    align-items: flex-start;
    flex-direction: column;
    padding: 26px;
  }

  .loan-detail-status {
    align-self: flex-start;
  }

  .loan-detail-grid {
    grid-template-columns: 1fr;
  }

  .loan-detail-book-card {
    min-height: auto;
  }
}

@media (max-width: 480px) {
  .loan-detail-page {
    padding: 18px 12px 50px;
  }

  .loan-detail-header {
    padding: 22px;
    border-radius: 21px;
  }

  .loan-detail-header h1 {
    font-size: 27px;
  }

  .loan-detail-book-card {
    padding: 24px;
    border-radius: 21px;
  }

  .loan-detail-info-card {
    padding: 12px 18px;
    border-radius: 21px;
  }

  .loan-info-row {
    min-height: 72px;
  }
}

/* =========================================================
   TOMBOL DETAIL PEMINJAMAN
   ========================================================= */

.loan-detail-button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 82px;
  height: 42px;
  padding: 0 17px;

  border: 1px solid rgba(59, 130, 246, 0.18);
  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f8fafc 100%
    );

  color: #2563eb;
  font-size: 13px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 6px 14px rgba(37, 99, 235, 0.08),
    0 2px 4px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease;
}

.loan-detail-button:hover {
  transform: translateY(-2px);

  border-color: rgba(59, 130, 246, 0.3);

  background:
    linear-gradient(
      145deg,
      #eff6ff 0%,
      #ffffff 100%
    );

  box-shadow:
    0 10px 20px rgba(37, 99, 235, 0.12),
    0 4px 8px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.loan-detail-button:active {
  transform: translateY(0);

  box-shadow:
    0 4px 8px rgba(37, 99, 235, 0.08),
    inset 0 2px 4px rgba(15, 23, 42, 0.06);
}

.loan-detail-button:focus-visible {
  outline: 3px solid rgba(59, 130, 246, 0.18);
  outline-offset: 3px;
}

/* =========================================================
   AKSI DETAIL PEMINJAMAN
   ========================================================= */

.loan-action-group {
  position: relative;
  z-index: 2;

  display: grid;

  /* SAMA PERSIS dengan loan-detail-grid */
  grid-template-columns:
    minmax(280px, 0.85fr)
    minmax(0, 1.4fr);

  gap: 24px;

  width: 100%;
}

.loan-action-button {
  width: 100%;
  min-height: 42px;
  box-sizing: border-box;

  padding: 0 17px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;

  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.25);

  font-size: 13px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 7px 15px rgba(15, 23, 42, 0.07),
    0 2px 4px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease;
}

.loan-action-button:hover {
  transform: translateY(-2px);

  box-shadow:
    0 11px 22px rgba(15, 23, 42, 0.11),
    0 4px 8px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.loan-action-button:active {
  transform: translateY(0);

  box-shadow:
    0 4px 8px rgba(15, 23, 42, 0.08),
    inset 0 2px 4px rgba(15, 23, 42, 0.06);
}

/* BATAL */

.loan-action-cancel {
  border-color: rgba(220, 38, 38, 0.16);

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #fef2f2
    );

  color: #dc2626;
}

.loan-action-cancel:hover {
  border-color: rgba(220, 38, 38, 0.28);

  background:
    linear-gradient(
      145deg,
      #fef2f2,
      #ffffff
    );

  box-shadow:
    0 11px 22px rgba(220, 38, 38, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

/* KEMBALIKAN */

.loan-action-return {
  border-color: rgba(22, 163, 74, 0.17);

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f0fdf4
    );

  color: #15803d;
}

.loan-action-return:hover {
  border-color: rgba(22, 163, 74, 0.3);

  background:
    linear-gradient(
      145deg,
      #f0fdf4,
      #ffffff
    );

  box-shadow:
    0 11px 22px rgba(22, 163, 74, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

/* TABLET */

@media (max-width: 800px) {
  .loan-detail-header {
    align-items: flex-start;
  }

  .loan-action-group {
    width: 100%;

    grid-template-columns: 1fr;
    gap: 10px;
  }

  .loan-action-button {
    width: 100%;
  }
}

/* MOBILE */

@media (max-width: 480px) {
  .loan-action-group {
    grid-template-columns: 1fr;
    gap: 10px;
  }

  .loan-action-button {
    width: 100%;
  }
}

/* =========================
   RENEW LOAN BUTTON
   ========================= */

.loan-action-renew {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid rgba(59, 130, 246, 0.22);
  background: linear-gradient(
    145deg,
    #ffffff 0%,
    #eff6ff 100%
  );
  color: #2563eb;
  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.12),
    0 3px 6px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.loan-action-renew::before {
  content: "";
  position: absolute;
  top: 0;
  left: -120%;
  width: 70%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.75),
    transparent
  );
  transform: skewX(-20deg);
  transition: left 0.55s ease;
}

.loan-action-renew:hover {
  transform: translateY(-2px);
  border-color: rgba(59, 130, 246, 0.38);
  box-shadow:
    0 12px 24px rgba(37, 99, 235, 0.17),
    0 4px 8px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.loan-action-renew:hover::before {
  left: 140%;
}

.loan-action-renew:active {
  transform: translateY(0);
  box-shadow:
    0 5px 12px rgba(37, 99, 235, 0.12),
    inset 0 2px 5px rgba(15, 23, 42, 0.06);
}

.loan-action-renew:focus-visible {
  outline: 3px solid rgba(59, 130, 246, 0.18);
  outline-offset: 3px;
}

/* =========================
   BOOK LOAN ACTION
   ========================= */

.book-detail-loan-action {
  margin-top: 24px;
  display: flex;
  align-items: center;
}

.book-loan-button {
  position: relative;
  overflow: hidden;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  min-height: 48px;
  padding: 0 22px;

  border: 1px solid rgba(59, 130, 246, 0.28);
  border-radius: 14px;

  background: linear-gradient(
    145deg,
    #2563eb 0%,
    #1d4ed8 100%
  );

  color: #ffffff;

  font-size: 14px;
  font-weight: 800;

  cursor: pointer;

  box-shadow:
    0 10px 22px rgba(37, 99, 235, 0.22),
    0 4px 8px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);

  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.book-loan-button::before {
  content: "";

  position: absolute;
  top: 0;
  left: -120%;

  width: 65%;
  height: 100%;

  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.28),
    transparent
  );

  transform: skewX(-20deg);

  transition: left 0.55s ease;
}

.book-loan-button:hover {
  transform: translateY(-2px);

  border-color: rgba(59, 130, 246, 0.45);

  box-shadow:
    0 14px 28px rgba(37, 99, 235, 0.28),
    0 5px 10px rgba(15, 23, 42, 0.1),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.book-loan-button:hover::before {
  left: 140%;
}

.book-loan-button:active {
  transform: translateY(0);

  box-shadow:
    0 5px 12px rgba(37, 99, 235, 0.16),
    inset 0 2px 5px rgba(15, 23, 42, 0.06);
}

.book-loan-button:focus-visible {
  outline: 3px solid rgba(59, 130, 246, 0.2);
  outline-offset: 3px;
}

.book-loan-unavailable {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 46px;
  padding: 0 18px;

  border: 1px solid rgba(148, 163, 184, 0.25);
  border-radius: 14px;

  background: #f8fafc;

  color: #64748b;

  font-size: 14px;
  font-weight: 700;
}

/* =========================
   ADMIN LOAN APPROVAL
   ========================= */

.admin-loan-page {
  min-height: 100vh;
  padding: 48px 24px 80px;
  background:
    radial-gradient(
      circle at 10% 10%,
      rgba(59, 130, 246, 0.08),
      transparent 32%
    ),
    linear-gradient(
      180deg,
      #f8fbff 0%,
      #eef4fb 100%
    );
}

.admin-loan-container {
  width: min(1180px, 100%);
  margin: 0 auto;
}

.admin-loan-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 30px;
}

.admin-loan-eyebrow {
  display: inline-block;
  margin-bottom: 10px;
  color: #2563eb;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.16em;
}

.admin-loan-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(30px, 4vw, 46px);
  line-height: 1.08;
  letter-spacing: -0.035em;
}

.admin-loan-header p {
  margin: 12px 0 0;
  color: #64748b;
  font-size: 15px;
}

.admin-loan-refresh,
.admin-loan-approve,
.admin-loan-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 0;
  cursor: pointer;
  font-weight: 800;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    opacity 0.18s ease;
}

.admin-loan-refresh {
  min-height: 44px;
  padding: 0 17px;
  border: 1px solid rgba(59, 130, 246, 0.18);
  border-radius: 13px;
  background: #ffffff;
  color: #2563eb;
  box-shadow:
    0 7px 18px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 #ffffff;
}

.admin-loan-refresh:hover {
  transform: translateY(-2px);
  box-shadow:
    0 11px 24px rgba(37, 99, 235, 0.12);
}

.admin-loan-state {
  display: flex;
  min-height: 300px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 40px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 18px 40px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  text-align: center;
}

.admin-loan-state svg {
  color: #2563eb;
}

.admin-loan-state h2 {
  margin: 16px 0 6px;
  color: #0f172a;
  font-size: 21px;
}

.admin-loan-state p {
  margin: 0;
  color: #64748b;
}

.admin-loan-error svg {
  color: #dc2626;
}

.admin-loan-retry {
  margin-top: 18px;
  min-height: 42px;
  padding: 0 18px;
  border-radius: 12px;
  background: #2563eb;
  color: #ffffff;
  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.18);
}

.admin-loan-list {
  display: grid;
  gap: 16px;
}

.admin-loan-list-header {
  display: flex;
  align-items: center;
  min-height: 42px;
  padding: 0 4px;
  color: #64748b;
  font-size: 13px;
  font-weight: 800;
}

.admin-loan-card {
  position: relative;
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) auto;
  gap: 18px;
  align-items: center;
  padding: 22px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 250, 252, 0.94)
    );
  box-shadow:
    0 14px 32px rgba(15, 23, 42, 0.07),
    0 3px 8px rgba(15, 23, 42, 0.04),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.admin-loan-card:hover {
  transform: translateY(-2px);
  box-shadow:
    0 20px 40px rgba(15, 23, 42, 0.09),
    0 5px 12px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 1);
}

.admin-loan-book-icon {
  display: flex;
  width: 58px;
  height: 58px;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(59, 130, 246, 0.14);
  border-radius: 17px;
  background: linear-gradient(
    145deg,
    #eff6ff,
    #dbeafe
  );
  color: #2563eb;
  box-shadow:
    inset 0 1px 0 #ffffff,
    0 8px 16px rgba(37, 99, 235, 0.08);
}

.admin-loan-label {
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.admin-loan-main h2 {
  margin: 5px 0 3px;
  color: #0f172a;
  font-size: 19px;
}

.admin-loan-main > p {
  margin: 0;
  color: #64748b;
  font-size: 13px;
}

.admin-loan-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 13px;
}

.admin-loan-meta div {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: #475569;
  font-size: 12px;
  font-weight: 650;
}

.admin-loan-meta svg {
  color: #64748b;
}

.admin-loan-barcode {
  margin-top: 9px;
  color: #94a3b8;
  font-size: 11px;
}

.admin-loan-side {
  display: flex;
  min-width: 190px;
  flex-direction: column;
  align-items: flex-end;
  gap: 13px;
}

.admin-loan-status {
  display: inline-flex;
  align-items: center;
  min-height: 30px;
  padding: 0 11px;
  border: 1px solid rgba(245, 158, 11, 0.18);
  border-radius: 999px;
  background: rgba(255, 247, 237, 0.9);
  color: #b45309;
  font-size: 11px;
  font-weight: 800;
}

.admin-loan-approve {
  min-height: 44px;
  padding: 0 17px;
  border-radius: 12px;
  background: linear-gradient(
    145deg,
    #2563eb,
    #1d4ed8
  );
  color: #ffffff;
  box-shadow:
    0 9px 18px rgba(37, 99, 235, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.admin-loan-approve:hover:not(:disabled) {
  transform: translateY(-2px);
  box-shadow:
    0 13px 24px rgba(37, 99, 235, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.admin-loan-approve:disabled,
.admin-loan-refresh:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

@media (max-width: 760px) {
  .admin-loan-page {
    padding: 30px 16px 60px;
  }

  .admin-loan-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-loan-card {
    grid-template-columns: 48px minmax(0, 1fr);
    padding: 17px;
  }

  .admin-loan-book-icon {
    width: 48px;
    height: 48px;
    border-radius: 14px;
  }

  .admin-loan-side {
    grid-column: 1 / -1;
    align-items: stretch;
    min-width: 0;
  }

  .admin-loan-status,
  .admin-loan-approve {
    justify-content: center;
  }
}

.admin-loan-reject {
  position: relative;
  overflow: hidden;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 18px;
  border: 1px solid rgba(239, 68, 68, 0.2);
  border-radius: 13px;
  background: #fff;
  color: #dc2626;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease,
    background 0.18s ease;
}

.admin-loan-reject:hover {
  transform: translateY(-2px);
  border-color: rgba(239, 68, 68, 0.35);
  background: #fef2f2;
  box-shadow:
    0 10px 20px rgba(239, 68, 68, 0.1),
    0 4px 8px rgba(15, 23, 42, 0.06);
}

.admin-loan-reject:active {
  transform: translateY(0);
}

.admin-loan-reject:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
}

.admin-loan-approve,
.admin-loan-reject {
  width: 165px;
  box-sizing: border-box;
}

/* =========================================================
   ADMIN - MANAJEMEN PEMINJAMAN
   ========================================================= */

.admin-manage-loan-page {
  min-height: 100vh;
  padding: 42px 24px 70px;
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(37, 99, 235, 0.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 10%,
      rgba(14, 165, 233, 0.08),
      transparent 28%
    ),
    #f6f9ff;
}

.admin-manage-loan-container {
  width: min(1180px, 100%);
  margin: 0 auto;
}

/* HEADER */

.admin-manage-loan-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
}

.admin-manage-loan-eyebrow {
  display: inline-flex;
  margin-bottom: 9px;
  color: #2563eb;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.admin-manage-loan-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 900;
  letter-spacing: -0.035em;
}

.admin-manage-loan-header p {
  margin: 9px 0 0;
  color: #64748b;
  font-size: 14px;
}

.admin-manage-loan-refresh {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 0 17px;
  border: 1px solid rgba(37, 99, 235, 0.18);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.82);
  color: #2563eb;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.07);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease;
}

.admin-manage-loan-refresh:hover {
  transform: translateY(-2px);
  background: #ffffff;
  box-shadow: 0 12px 28px rgba(15, 23, 42, 0.10);
}

.admin-manage-loan-refresh:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}


/* =========================
   STAFF TRANSACTION
   ========================= */

.admin-manage-loan-transaction {
  margin-bottom: 20px;
  padding: 22px;
  border: 1px solid rgba(37, 99, 235, 0.16);
  border-radius: 22px;
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.92),
      rgba(239, 246, 255, 0.82)
    );
  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
}

.admin-manage-loan-transaction-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.admin-manage-loan-transaction-header h2 {
  margin: 5px 0 5px;
  color: #10213f;
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.admin-manage-loan-transaction-header p {
  margin: 0;
  color: #758093;
  font-size: 13px;
  line-height: 1.6;
}

.admin-manage-loan-transaction-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48px;
  height: 48px;
  flex: 0 0 48px;
  border: 1px solid rgba(37, 99, 235, 0.14);
  border-radius: 15px;
  background: rgba(255, 255, 255, 0.72);
  color: #2563eb;
  box-shadow:
    0 10px 25px rgba(37, 99, 235, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-manage-loan-transaction-form {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
  align-items: end;
  gap: 14px;
}

.admin-manage-loan-transaction-field {
  min-width: 0;
}

.admin-manage-loan-transaction-field label {
  display: block;
  margin-bottom: 7px;
  color: #334155;
  font-size: 12px;
  font-weight: 700;
}

.admin-manage-loan-transaction-field input {
  width: 100%;
  height: 48px;
  padding: 0 14px;
  border: 1px solid #dbe4f0;
  border-radius: 14px;
  outline: none;
  background: rgba(255, 255, 255, 0.92);
  color: #10213f;
  font-size: 13px;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    transform 0.2s ease;
  box-sizing: border-box;
}

.admin-manage-loan-transaction-field input::placeholder {
  color: #94a3b8;
}

.admin-manage-loan-transaction-field input:focus {
  border-color: rgba(37, 99, 235, 0.48);
  box-shadow:
    0 0 0 4px rgba(37, 99, 235, 0.08),
    0 10px 25px rgba(15, 23, 42, 0.05);
}

.admin-manage-loan-transaction-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-width: 178px;
  height: 48px;
  padding: 0 18px;
  border: 1px solid rgba(30, 64, 175, 0.18);
  border-radius: 14px;
  background: linear-gradient(
    135deg,
    #1d4ed8,
    #2563eb
  );
  color: #ffffff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  box-shadow:
    0 12px 25px rgba(37, 99, 235, 0.20),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    opacity 0.2s ease;
}

.admin-manage-loan-transaction-submit:hover:not(:disabled) {
  transform: translateY(-1px);
  box-shadow:
    0 16px 30px rgba(37, 99, 235, 0.24),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

.admin-manage-loan-transaction-submit:disabled {
  cursor: not-allowed;
  opacity: 0.6;
}

/* MOBILE */

@media (max-width: 760px) {
  .admin-manage-loan-transaction {
    padding: 16px;
    border-radius: 18px;
  }

  .admin-manage-loan-transaction-header {
    align-items: flex-start;
  }

  .admin-manage-loan-transaction-header h2 {
    font-size: 18px;
  }

  .admin-manage-loan-transaction-form {
    grid-template-columns: 1fr;
  }

  .admin-manage-loan-transaction-submit {
    width: 100%;
  }
}

/* TOOLBAR */

.admin-manage-loan-toolbar {
  margin-bottom: 20px;
  padding: 18px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.76);
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(18px);
}

.admin-manage-loan-search {
  display: flex;
  align-items: center;
  min-height: 48px;
  padding-left: 15px;
  border: 1px solid #dbe4f0;
  border-radius: 14px;
  background: #ffffff;
  color: #64748b;
  overflow: hidden;
}

.admin-manage-loan-search input {
  flex: 1;
  min-width: 0;
  height: 48px;
  padding: 0 13px;
  border: 0;
  outline: none;
  background: transparent;
  color: #0f172a;
  font-size: 13px;
}

.admin-manage-loan-search input::placeholder {
  color: #94a3b8;
}

.admin-manage-loan-search button {
  height: 48px;
  padding: 0 20px;
  border: 0;
  background: #2563eb;
  color: #ffffff;
  font-size: 13px;
  font-weight: 800;
  cursor: pointer;
  transition: background 0.2s ease;
}

.admin-manage-loan-search button:hover {
  background: #1d4ed8;
}

/* FILTER */

.admin-manage-loan-filters {
  display: flex;
  gap: 8px;
  margin-top: 14px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.admin-manage-loan-filters button {
  flex: 0 0 auto;
  min-height: 36px;
  padding: 0 13px;
  border: 1px solid #dbe4f0;
  border-radius: 10px;
  background: #ffffff;
  color: #64748b;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    color 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease,
    transform 0.2s ease;
}

.admin-manage-loan-filters button:hover {
  transform: translateY(-1px);
  color: #2563eb;
  border-color: rgba(37, 99, 235, 0.3);
}

.admin-manage-loan-filters button.active {
  border-color: #2563eb;
  background: #2563eb;
  color: #ffffff;
}

/* SUMMARY */

.admin-manage-loan-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin: 0 3px 13px;
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
}

/* LIST */

.admin-manage-loan-list {
  display: grid;
  gap: 13px;
}

.admin-manage-loan-card {
  position: relative;
  display: grid;
  grid-template-columns: 58px minmax(0, 1fr) 190px;
  gap: 18px;
  align-items: center;
  padding: 20px;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 20px;
  background:
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.98),
      rgba(248, 251, 255, 0.92)
    );
  box-shadow:
    0 14px 38px rgba(15, 23, 42, 0.065),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  overflow: hidden;
  transition:
    transform 0.22s ease,
    box-shadow 0.22s ease,
    border-color 0.22s ease;
}

.admin-manage-loan-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(
    180deg,
    #2563eb,
    #38bdf8
  );
}

.admin-manage-loan-card:hover {
  transform: translateY(-3px);
  border-color: rgba(37, 99, 235, 0.18);
  box-shadow:
    0 20px 46px rgba(15, 23, 42, 0.10),
    0 0 0 1px rgba(37, 99, 235, 0.03);
}

.admin-manage-loan-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58px;
  height: 58px;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 16px;
  background:
    linear-gradient(
      145deg,
      rgba(37, 99, 235, 0.11),
      rgba(14, 165, 233, 0.07)
    );
  color: #2563eb;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-manage-loan-main {
  min-width: 0;
}

.admin-manage-loan-label {
  display: block;
  margin-bottom: 5px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.10em;
}

.admin-manage-loan-main h2 {
  margin: 0;
  color: #0f172a;
  font-size: 17px;
  font-weight: 850;
  line-height: 1.35;
}

.admin-manage-loan-main > p {
  margin: 4px 0 12px;
  color: #64748b;
  font-size: 12px;
}

.admin-manage-loan-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 18px;
  color: #64748b;
  font-size: 11px;
  font-weight: 650;
}

.admin-manage-loan-meta div {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.admin-manage-loan-meta svg {
  color: #94a3b8;
}

/* SIDE */

.admin-manage-loan-side {
  display: flex;
  align-items: flex-end;
  flex-direction: column;
  gap: 7px;
  text-align: right;
}

.admin-manage-loan-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 30px;
  padding: 0 11px;
  border-radius: 9px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  white-space: nowrap;
}

.admin-manage-loan-side strong {
  color: #0f172a;
  font-size: 13px;
  font-weight: 900;
}

.admin-manage-loan-side > span:last-child {
  color: #94a3b8;
  font-size: 11px;
  font-weight: 700;
}

/* STATUS */

.admin-manage-loan-status.status-pending {
  background: #fff7ed;
  color: #c2410c;
}

.admin-manage-loan-status.status-active {
  background: #ecfdf5;
  color: #047857;
}

.admin-manage-loan-status.status-overdue {
  background: #fef2f2;
  color: #dc2626;
}

.admin-manage-loan-status.status-returned {
  background: #eff6ff;
  color: #2563eb;
}

.admin-manage-loan-status.status-cancelled {
  background: #f1f5f9;
  color: #64748b;
}

.admin-manage-loan-status.status-rejected {
  background: #fef2f2;
  color: #b91c1c;
}

.admin-manage-loan-status.status-lost {
  background: #faf5ff;
  color: #9333ea;
}

.admin-manage-loan-status.status-damaged {
  background: #fff7ed;
  color: #ea580c;
}

/* STATE */

.admin-manage-loan-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  padding: 40px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.82);
  color: #64748b;
  text-align: center;
  box-shadow: 0 14px 38px rgba(15, 23, 42, 0.05);
}

.admin-manage-loan-state svg {
  margin-bottom: 12px;
}

.admin-manage-loan-state h2 {
  margin: 0 0 6px;
  color: #0f172a;
  font-size: 18px;
  font-weight: 900;
}

.admin-manage-loan-state p {
  margin: 0;
  font-size: 13px;
}

.admin-manage-loan-error {
  color: #dc2626;
}

.admin-manage-loan-state button {
  margin-top: 16px;
  min-height: 40px;
  padding: 0 16px;
  border: 0;
  border-radius: 10px;
  background: #2563eb;
  color: #ffffff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

/* PAGINATION */

.admin-manage-loan-pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-top: 24px;
}

.admin-manage-loan-pagination button {
  min-height: 40px;
  padding: 0 15px;
  border: 1px solid #dbe4f0;
  border-radius: 10px;
  background: #ffffff;
  color: #2563eb;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.admin-manage-loan-pagination button:hover:not(:disabled) {
  transform: translateY(-1px);
  background: #eff6ff;
}

.admin-manage-loan-pagination button:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.admin-manage-loan-pagination span {
  min-width: 60px;
  color: #475569;
  font-size: 12px;
  font-weight: 900;
  text-align: center;
}

/* RESPONSIVE */

@media (max-width: 850px) {
  .admin-manage-loan-card {
    grid-template-columns: 50px minmax(0, 1fr);
  }

  .admin-manage-loan-icon {
    width: 50px;
    height: 50px;
  }

  .admin-manage-loan-side {
    grid-column: 2;
    align-items: flex-start;
    text-align: left;
  }
}

@media (max-width: 600px) {
  .admin-manage-loan-page {
    padding: 28px 14px 50px;
  }

  .admin-manage-loan-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-manage-loan-refresh {
    width: 100%;
  }

  .admin-manage-loan-toolbar {
    padding: 13px;
    border-radius: 16px;
  }

  .admin-manage-loan-search {
    min-height: 44px;
  }

  .admin-manage-loan-search input {
    height: 44px;
    font-size: 12px;
  }

  .admin-manage-loan-search button {
    height: 44px;
    padding: 0 14px;
  }

  .admin-manage-loan-card {
    grid-template-columns: 1fr;
    gap: 14px;
    padding: 17px;
  }

  .admin-manage-loan-icon {
    width: 48px;
    height: 48px;
  }

  .admin-manage-loan-side {
    grid-column: auto;
    align-items: flex-start;
  }

  .admin-manage-loan-summary {
    align-items: flex-start;
    flex-direction: column;
    gap: 4px;
  }

  .admin-manage-loan-pagination {
    gap: 8px;
  }

  .admin-manage-loan-pagination button {
    padding: 0 11px;
  }
}

/* =========================================================
   AKSI - ADMIN MANAJEMEN PEMINJAMAN
   ========================================================= */

.admin-manage-loan-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 7px;
  margin-top: 9px;
}

.admin-manage-loan-actions button {
  min-height: 32px;
  padding: 0 11px;
  border-radius: 9px;
  border: 1px solid transparent;
  font-size: 10px;
  font-weight: 850;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease,
    border-color 0.18s ease;
}

.admin-manage-loan-actions button:hover:not(:disabled) {
  transform: translateY(-1px);
}

.admin-manage-loan-actions button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}

/* DETAIL */

.admin-manage-loan-detail {
  border-color: #dbe4f0 !important;
  background: #ffffff;
  color: #475569;
}

.admin-manage-loan-detail:hover:not(:disabled) {
  border-color: rgba(37, 99, 235, 0.25) !important;
  background: #eff6ff;
  color: #2563eb;
}

/* SETUJUI */

.admin-manage-loan-approve {
  background: #ecfdf5;
  border-color: rgba(16, 185, 129, 0.18) !important;
  color: #047857;
}

.admin-manage-loan-approve:hover:not(:disabled) {
  background: #d1fae5;
  box-shadow: 0 5px 14px rgba(16, 185, 129, 0.12);
}

/* TOLAK */

.admin-manage-loan-reject {
  background: #fef2f2;
  border-color: rgba(239, 68, 68, 0.15) !important;
  color: #b91c1c;
}

.admin-manage-loan-reject:hover:not(:disabled) {
  background: #fee2e2;
  box-shadow: 0 5px 14px rgba(239, 68, 68, 0.10);
}

/* KEMBALIKAN */

.admin-manage-loan-return {
  background: #eff6ff;
  border-color: rgba(37, 99, 235, 0.15) !important;
  color: #2563eb;
}

.admin-manage-loan-return:hover:not(:disabled) {
  background: #dbeafe;
  box-shadow: 0 5px 14px rgba(37, 99, 235, 0.12);
}

/* HILANG */

.admin-manage-loan-lost {
  background: #faf5ff;
  border-color: rgba(147, 51, 234, 0.15) !important;
  color: #9333ea;
}

.admin-manage-loan-lost:hover:not(:disabled) {
  background: #f3e8ff;
  box-shadow: 0 5px 14px rgba(147, 51, 234, 0.10);
}

/* RUSAK */

.admin-manage-loan-damaged {
  background: #fff7ed;
  border-color: rgba(234, 88, 12, 0.15) !important;
  color: #c2410c;
}

.admin-manage-loan-damaged:hover:not(:disabled) {
  background: #ffedd5;
  box-shadow: 0 5px 14px rgba(234, 88, 12, 0.10);
}

/* RESPONSIVE */

@media (max-width: 850px) {
  .admin-manage-loan-actions {
    justify-content: flex-start;
  }
}

@media (max-width: 600px) {
  .admin-manage-loan-actions {
    width: 100%;
    justify-content: flex-start;
  }

  .admin-manage-loan-actions button {
    flex: 1;
    min-width: 90px;
  }
}

/* =========================================================
   ADMIN - DETAIL PEMINJAMAN
   ========================================================= */

.admin-loan-detail-page {
  min-height: 100vh;
  padding: 42px 24px 70px;
  background:
    radial-gradient(
      circle at 8% 0%,
      rgba(37, 99, 235, 0.10),
      transparent 30%
    ),
    radial-gradient(
      circle at 92% 8%,
      rgba(14, 165, 233, 0.08),
      transparent 28%
    ),
    #f6f9ff;
}

.admin-loan-detail-container {
  width: min(1180px, 100%);
  margin: 0 auto;
}

/* BACK */

.admin-loan-detail-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #64748b;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-loan-detail-back:hover {
  color: #2563eb;
  transform: translateX(-2px);
}

/* HEADER */

.admin-loan-detail-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 28px;
  padding: 28px 30px;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18px);
}

.admin-loan-detail-eyebrow {
  display: inline-flex;
  margin-bottom: 8px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.admin-loan-detail-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(28px, 4vw, 40px);
  font-weight: 900;
  letter-spacing: -0.035em;
}

.admin-loan-detail-header p {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 13px;
}

/* STATUS */

.admin-loan-detail-status {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  padding: 0 15px;
  border-radius: 11px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.admin-loan-detail-status.status-pending {
  background: #fff7ed;
  color: #c2410c;
}

.admin-loan-detail-status.status-active {
  background: #ecfdf5;
  color: #047857;
}

.admin-loan-detail-status.status-overdue {
  background: #fef2f2;
  color: #dc2626;
}

.admin-loan-detail-status.status-returned {
  background: #eff6ff;
  color: #2563eb;
}

.admin-loan-detail-status.status-cancelled {
  background: #f1f5f9;
  color: #64748b;
}

.admin-loan-detail-status.status-rejected {
  background: #fef2f2;
  color: #b91c1c;
}

.admin-loan-detail-status.status-lost {
  background: #faf5ff;
  color: #9333ea;
}

.admin-loan-detail-status.status-damaged {
  background: #fff7ed;
  color: #ea580c;
}

/* GRID */

.admin-loan-detail-grid {
  display: grid;
  grid-template-columns: 0.85fr 1.4fr;
  gap: 18px;
}

/* BOOK CARD */

.admin-loan-detail-book-card,
.admin-loan-detail-info-card {
  position: relative;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.97),
      rgba(248, 251, 255, 0.92)
    );
  box-shadow:
    0 16px 40px rgba(15, 23, 42, 0.065),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  overflow: hidden;
}

.admin-loan-detail-book-card {
  min-height: 420px;
  padding: 28px;
}

.admin-loan-detail-book-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(
    180deg,
    #2563eb,
    #38bdf8
  );
}

.admin-loan-detail-book-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70px;
  height: 70px;
  margin-bottom: 28px;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      rgba(37, 99, 235, 0.12),
      rgba(14, 165, 233, 0.07)
    );
  color: #2563eb;
}

.admin-loan-detail-label {
  display: block;
  margin-bottom: 8px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.admin-loan-detail-book-card h2 {
  margin: 0;
  color: #0f172a;
  font-size: 23px;
  font-weight: 900;
  line-height: 1.3;
  letter-spacing: -0.02em;
}

.admin-loan-detail-book-card > p {
  margin: 7px 0 25px;
  color: #64748b;
  font-size: 13px;
}

.admin-loan-detail-barcode {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 11px;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #f8fafc;
  color: #64748b;
  font-family: monospace;
  font-size: 11px;
  font-weight: 700;
}

/* INFO CARD */

.admin-loan-detail-info-card {
  padding: 10px 28px;
}

.admin-loan-detail-info-item {
  display: flex;
  align-items: center;
  gap: 15px;
  min-height: 70px;
  border-bottom: 1px solid rgba(226, 232, 240, 0.8);
}

.admin-loan-detail-info-item:last-child {
  border-bottom: 0;
}

.admin-loan-detail-info-item > svg {
  flex: 0 0 auto;
  color: #2563eb;
}

.admin-loan-detail-info-item > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.admin-loan-detail-info-item span {
  color: #94a3b8;
  font-size: 10px;
  font-weight: 800;
}

.admin-loan-detail-info-item strong {
  color: #0f172a;
  font-size: 13px;
  font-weight: 850;
  word-break: break-word;
}

/* STATE */

.admin-loan-detail-state {
  display: flex;
  min-height: 400px;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10px;
  padding: 40px;
  color: #64748b;
  text-align: center;
}

.admin-loan-detail-state svg {
  color: #2563eb;
}

.admin-loan-detail-state p {
  margin: 0;
  font-size: 13px;
}

.admin-loan-detail-state h2 {
  margin: 0;
  color: #0f172a;
  font-size: 20px;
  font-weight: 900;
}

.admin-loan-detail-state button {
  min-height: 40px;
  margin-top: 8px;
  padding: 0 16px;
  border: 0;
  border-radius: 10px;
  background: #2563eb;
  color: #ffffff;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.admin-loan-detail-error {
  min-height: 60vh;
}

/* RESPONSIVE */

@media (max-width: 800px) {
  .admin-loan-detail-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-loan-detail-grid {
    grid-template-columns: 1fr;
  }

  .admin-loan-detail-book-card {
    min-height: auto;
  }
}

@media (max-width: 520px) {
  .admin-loan-detail-page {
    padding: 28px 14px 50px;
  }

  .admin-loan-detail-header {
    padding: 22px;
    border-radius: 18px;
  }

  .admin-loan-detail-book-card {
    padding: 22px;
  }

  .admin-loan-detail-info-card {
    padding: 8px 20px;
  }

  .admin-loan-detail-info-item {
    min-height: 64px;
    gap: 12px;
  }

  .admin-loan-detail-header h1 {
    font-size: 29px;
  }
}

/* =========================================================
   ADMIN - AKSI DETAIL PEMINJAMAN
   ========================================================= */

.admin-loan-detail-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 18px;
  padding: 20px 24px;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 14px 38px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18px);
}

.admin-loan-detail-actions-label {
  display: block;
  margin-bottom: 5px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.12em;
}

.admin-loan-detail-actions p {
  margin: 0;
  color: #64748b;
  font-size: 12px;
}

.admin-loan-detail-actions-buttons {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-shrink: 0;
}

.admin-loan-detail-actions-buttons button {
  min-height: 42px;
  padding: 0 17px;
  border-radius: 11px;
  font-size: 12px;
  font-weight: 850;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-loan-detail-actions-buttons button:hover:not(:disabled) {
  transform: translateY(-2px);
}

.admin-loan-detail-actions-buttons button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* SETUJUI */

.admin-loan-detail-approve {
  border: 1px solid rgba(16, 185, 129, 0.18);
  background: #ecfdf5;
  color: #047857;
}

.admin-loan-detail-approve:hover:not(:disabled) {
  background: #d1fae5;
  box-shadow:
    0 8px 20px rgba(16, 185, 129, 0.12);
}

/* TOLAK */

.admin-loan-detail-reject {
  border: 1px solid rgba(239, 68, 68, 0.15);
  background: #fef2f2;
  color: #b91c1c;
}

.admin-loan-detail-reject:hover:not(:disabled) {
  background: #fee2e2;
  box-shadow:
    0 8px 20px rgba(239, 68, 68, 0.10);
}

/* RESPONSIVE */

@media (max-width: 700px) {
  .admin-loan-detail-actions {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-loan-detail-actions-buttons {
    width: 100%;
  }

  .admin-loan-detail-actions-buttons button {
    flex: 1;
  }
}

@media (max-width: 480px) {
  .admin-loan-detail-actions-buttons {
    flex-direction: column;
  }

  .admin-loan-detail-actions-buttons button {
    width: 100%;
  }
}

/* =========================================================
   ADMIN - AKSI ACTIVE PEMINJAMAN
   ========================================================= */

.admin-loan-detail-return {
  border: 1px solid rgba(37, 99, 235, 0.16);
  background: #eff6ff;
  color: #1d4ed8;
}

.admin-loan-detail-return:hover:not(:disabled) {
  background: #dbeafe;
  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.12);
}

.admin-loan-detail-lost {
  border: 1px solid rgba(245, 158, 11, 0.18);
  background: #fffbeb;
  color: #b45309;
}

.admin-loan-detail-lost:hover:not(:disabled) {
  background: #fef3c7;
  box-shadow:
    0 8px 20px rgba(245, 158, 11, 0.12);
}

.admin-loan-detail-damaged {
  border: 1px solid rgba(239, 68, 68, 0.15);
  background: #fef2f2;
  color: #b91c1c;
}

.admin-loan-detail-damaged:hover:not(:disabled) {
  background: #fee2e2;
  box-shadow:
    0 8px 20px rgba(239, 68, 68, 0.10);
}

/* =========================================================
   ADMIN - MANAJEMEN BUKU
   ========================================================= */

.admin-book-page {
  min-height: 100vh;
  padding: 42px 24px 70px;
}

.admin-book-container {
  width: min(1180px, 100%);
  margin: 0 auto;
}

.admin-book-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 24px;
}

.admin-book-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.14em;
}

.admin-book-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 850;
  letter-spacing: -0.035em;
}

.admin-book-header p {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 13px;
}

.admin-book-add-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 18px;
  border: 1px solid rgba(37, 99, 235, 0.18);
  border-radius: 12px;
  background: #2563eb;
  color: white;
  font-size: 12px;
  font-weight: 850;
  cursor: pointer;
  box-shadow:
    0 10px 24px rgba(37, 99, 235, 0.18);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-add-button:hover {
  transform: translateY(-2px);
  background: #1d4ed8;
  box-shadow:
    0 14px 28px rgba(37, 99, 235, 0.22);
}

/* =========================
   TOOLBAR
   ========================= */

.admin-book-toolbar {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 22px;
  padding: 14px;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.82);
  box-shadow:
    0 14px 38px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(18px);
}

.admin-book-search {
  display: flex;
  align-items: center;
  gap: 10px;
  flex: 1;
  min-height: 44px;
  padding: 0 14px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: #f8fafc;
  color: #64748b;
}

.admin-book-search:focus-within {
  border-color: rgba(37, 99, 235, 0.45);
  box-shadow:
    0 0 0 3px rgba(37, 99, 235, 0.08);
}

.admin-book-search input {
  width: 100%;
  border: 0;
  outline: 0;
  background: transparent;
  color: #0f172a;
  font-size: 13px;
}

.admin-book-search input::placeholder {
  color: #94a3b8;
}

.admin-book-refresh-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 44px;
  padding: 0 16px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: white;
  color: #475569;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease;
}

.admin-book-refresh-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #f8fafc;
}

.admin-book-refresh-button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.admin-book-spin {
  animation: admin-book-spin 0.9s linear infinite;
}

@keyframes admin-book-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* =========================
   BOOK GRID
   ========================= */

.admin-book-grid {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.admin-book-card {
  position: relative;
  overflow: hidden;
  padding: 22px;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 22px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(248, 250, 252, 0.88)
    );
  box-shadow:
    0 16px 40px rgba(15, 23, 42, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(18px);
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease;
}

.admin-book-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background: linear-gradient(
    180deg,
    #2563eb,
    #60a5fa
  );
}

.admin-book-card:hover {
  transform: translateY(-3px);
  box-shadow:
    0 20px 48px rgba(15, 23, 42, 0.10),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.admin-book-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.admin-book-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 15px;
  background: #eff6ff;
  color: #2563eb;
}

.admin-book-available,
.admin-book-unavailable {
  padding: 7px 10px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 850;
}

.admin-book-available {
  border: 1px solid rgba(16, 185, 129, 0.16);
  background: #ecfdf5;
  color: #047857;
}

.admin-book-unavailable {
  border: 1px solid rgba(239, 68, 68, 0.14);
  background: #fef2f2;
  color: #b91c1c;
}

.admin-book-category {
  display: inline-block;
  margin-top: 17px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: 0.04em;
}

.admin-book-card h2 {
  margin: 6px 0 4px;
  color: #0f172a;
  font-size: 19px;
  font-weight: 850;
  letter-spacing: -0.02em;
}

.admin-book-author {
  margin: 0;
  color: #64748b;
  font-size: 12px;
}

.admin-book-meta {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-top: 18px;
}

.admin-book-meta div {
  padding: 11px 12px;
  border-radius: 12px;
  background: #f8fafc;
}

.admin-book-meta span,
.admin-book-stats span {
  display: block;
  margin-bottom: 4px;
  color: #94a3b8;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.admin-book-meta strong {
  display: block;
  overflow: hidden;
  color: #334155;
  font-size: 11px;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-book-stats {
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 8px;
  margin-top: 12px;
}

.admin-book-stats div {
  padding: 11px;
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 12px;
  background: rgba(248, 250, 252, 0.75);
}

.admin-book-stats svg {
  margin-bottom: 5px;
  color: #64748b;
}

.admin-book-stats strong {
  display: block;
  color: #0f172a;
  font-size: 15px;
  font-weight: 850;
}

.admin-book-actions {
  display: flex;
  gap: 9px;
  margin-top: 17px;
}

.admin-book-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  flex: 1;
  min-height: 40px;
  border-radius: 11px;
  font-size: 11px;
  font-weight: 850;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.admin-book-actions button:hover {
  transform: translateY(-2px);
}

.admin-book-detail-button {
  border: 1px solid rgba(37, 99, 235, 0.16);
  background: #eff6ff;
  color: #1d4ed8;
}

.admin-book-detail-button:hover {
  background: #dbeafe;
  box-shadow:
    0 8px 20px rgba(37, 99, 235, 0.10);
}

.admin-book-edit-button {
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: #f8fafc;
  color: #475569;
}

.admin-book-edit-button:hover {
  background: #f1f5f9;
}

/* =========================
   STATES
   ========================= */

.admin-book-state {
  min-height: 280px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 30px;
  border: 1px solid rgba(148, 163, 184, 0.17);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.82);
  color: #64748b;
  text-align: center;
  box-shadow:
    0 14px 38px rgba(15, 23, 42, 0.05);
}

.admin-book-state h2 {
  margin: 0;
  color: #334155;
  font-size: 18px;
}

.admin-book-state p {
  margin: 0;
  font-size: 12px;
}

.admin-book-error {
  color: #b91c1c;
}

.admin-book-error button {
  min-height: 38px;
  padding: 0 15px;
  border: 0;
  border-radius: 10px;
  background: #2563eb;
  color: white;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 800px) {
  .admin-book-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-book-add-button {
    width: 100%;
  }

  .admin-book-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .admin-book-page {
    padding: 28px 14px 50px;
  }

  .admin-book-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-book-refresh-button {
    width: 100%;
  }

  .admin-book-meta {
    grid-template-columns: 1fr;
  }

  .admin-book-actions {
    flex-direction: column;
  }
}

/* =========================================================
   ADMIN - TAMBAH BUKU
   ========================================================= */

.admin-book-form-page {
  min-height: 100vh;
  padding: 42px 28px 70px;
  background:
    radial-gradient(
      circle at 15% 10%,
      rgba(37, 99, 235, 0.07),
      transparent 30%
    ),
    linear-gradient(
      180deg,
      #f8fbff 0%,
      #f5f8fc 100%
    );
}

.admin-book-form-container {
  width: min(1100px, 100%);
  margin: 0 auto;
}

.admin-book-form-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 24px;
  padding: 10px 14px;
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.78);
  color: #475569;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  box-shadow:
    0 6px 18px rgba(15, 23, 42, 0.05);
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.admin-book-form-back:hover {
  transform: translateY(-1px);
  background: #ffffff;
  box-shadow:
    0 9px 22px rgba(15, 23, 42, 0.08);
}

.admin-book-form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 24px;
  padding: 28px 30px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.84);
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(18px);
}

.admin-book-form-eyebrow {
  display: block;
  margin-bottom: 7px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.13em;
}

.admin-book-form-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: 32px;
  line-height: 1.15;
  font-weight: 850;
}

.admin-book-form-header p {
  margin: 9px 0 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}

.admin-book-form-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62px;
  height: 62px;
  flex-shrink: 0;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      #eff6ff,
      #dbeafe
    );
  color: #2563eb;
  box-shadow:
    0 12px 25px rgba(37, 99, 235, 0.1);
}

.admin-book-form-card {
  padding: 30px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.07),
    inset 0 1px 0 rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(18px);
}

.admin-book-form-section-label {
  display: block;
  margin-bottom: 20px;
  color: #2563eb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.13em;
}

.admin-book-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}

.admin-book-form-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.admin-book-form-field-full {
  grid-column: 1 / -1;
}

.admin-book-form-field label {
  color: #334155;
  font-size: 12px;
  font-weight: 800;
}

.admin-book-form-field label span {
  margin-left: 3px;
  color: #ef4444;
}

.admin-book-form-field input,
.admin-book-form-field textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 13px;
  background: rgba(248, 250, 252, 0.82);
  color: #0f172a;
  font-family: inherit;
  font-size: 13px;
  outline: none;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-form-field input {
  height: 46px;
  padding: 0 14px;
}

.admin-book-form-field textarea {
  min-height: 140px;
  padding: 13px 14px;
  resize: vertical;
  line-height: 1.6;
}

.admin-book-form-field input::placeholder,
.admin-book-form-field textarea::placeholder {
  color: #94a3b8;
}

.admin-book-form-field input:focus,
.admin-book-form-field textarea:focus {
  border-color: rgba(37, 99, 235, 0.55);
  background: #ffffff;
  box-shadow:
    0 0 0 4px rgba(37, 99, 235, 0.08);
}

.admin-book-form-field small {
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.5;
}

.admin-book-form-error {
  margin-top: 22px;
  padding: 13px 15px;
  border: 1px solid rgba(239, 68, 68, 0.16);
  border-radius: 12px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 12px;
  font-weight: 700;
}

.admin-book-form-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10px;
  margin-top: 28px;
  padding-top: 22px;
  border-top: 1px solid rgba(148, 163, 184, 0.15);
}

.admin-book-form-actions button {
  min-height: 44px;
  padding: 0 18px;
  border-radius: 12px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 850;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-form-actions button:hover:not(:disabled) {
  transform: translateY(-2px);
}

.admin-book-form-actions button:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

.admin-book-form-cancel {
  border: 1px solid rgba(148, 163, 184, 0.25);
  background: #ffffff;
  color: #475569;
}

.admin-book-form-cancel:hover:not(:disabled) {
  background: #f8fafc;
  box-shadow:
    0 8px 20px rgba(15, 23, 42, 0.07);
}

.admin-book-form-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border: 1px solid rgba(37, 99, 235, 0.15);
  background: #2563eb;
  color: #ffffff;
  box-shadow:
    0 10px 24px rgba(37, 99, 235, 0.18);
}

.admin-book-form-submit:hover:not(:disabled) {
  background: #1d4ed8;
  box-shadow:
    0 13px 28px rgba(37, 99, 235, 0.23);
}

/* =========================
   RESPONSIVE
   ========================= */

@media (max-width: 700px) {
  .admin-book-form-page {
    padding: 25px 16px 50px;
  }

  .admin-book-form-header {
    align-items: flex-start;
    padding: 23px;
  }

  .admin-book-form-header h1 {
    font-size: 27px;
  }

  .admin-book-form-card {
    padding: 22px;
  }

  .admin-book-form-grid {
    grid-template-columns: 1fr;
  }

  .admin-book-form-field-full {
    grid-column: auto;
  }
}

@media (max-width: 480px) {
  .admin-book-form-header {
    flex-direction: column;
  }

  .admin-book-form-icon {
    width: 54px;
    height: 54px;
  }

  .admin-book-form-actions {
    flex-direction: column-reverse;
  }

  .admin-book-form-actions button {
    width: 100%;
  }
}

.admin-book-form-field select {
  width: 100%;
  height: 46px;
  box-sizing: border-box;
  padding: 0 14px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 13px;
  background: rgba(248, 250, 252, 0.82);
  color: #0f172a;
  font-family: inherit;
  font-size: 13px;
  outline: none;
  cursor: pointer;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-form-field select:focus {
  border-color: rgba(37, 99, 235, 0.55);
  background: #ffffff;
  box-shadow:
    0 0 0 4px rgba(37, 99, 235, 0.08);
}

.admin-book-form-loading {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

/* =========================================================
   ADMIN - DETAIL BUKU
   ========================================================= */

.admin-book-detail-page {
  min-height: 100vh;
  padding: 40px 24px 70px;
  background:
    radial-gradient(circle at 10% 0%, rgba(37, 99, 235, 0.08), transparent 28%),
    radial-gradient(circle at 90% 10%, rgba(14, 165, 233, 0.06), transparent 25%),
    #f8fafc;
}

.admin-book-detail-container {
  width: min(1180px, 100%);
  margin: 0 auto;
}

.admin-book-detail-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  padding: 10px 14px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.82);
  color: #475569;
  font-family: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.admin-book-detail-back:hover {
  transform: translateY(-1px);
  background: #ffffff;
  box-shadow: 0 8px 22px rgba(15, 23, 42, 0.07);
}

/* HERO */

.admin-book-detail-hero {
  display: flex;
  align-items: center;
  gap: 22px;
  padding: 30px;
  margin-bottom: 20px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-book-detail-hero-icon {
  flex: 0 0 auto;
  width: 76px;
  height: 76px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 20px;
  background: linear-gradient(
    145deg,
    #eff6ff,
    #dbeafe
  );
  color: #2563eb;
  box-shadow:
    0 12px 28px rgba(37, 99, 235, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-book-detail-hero-content {
  min-width: 0;
}

.admin-book-detail-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.admin-book-detail-category {
  display: inline-flex;
  align-items: center;
  margin-bottom: 8px;
  padding: 5px 10px;
  border-radius: 999px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 11px;
  font-weight: 700;
}

.admin-book-detail-hero h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(24px, 3vw, 34px);
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.admin-book-detail-author {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 14px;
  white-space: pre-line;
  line-height: 1.6;
}

/* CARD */

.admin-book-detail-card {
  margin-bottom: 20px;
  padding: 26px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-book-detail-section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 22px;
}

.admin-book-detail-section-heading > div > span {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.admin-book-detail-section-heading h2 {
  margin: 0;
  color: #0f172a;
  font-size: 20px;
  letter-spacing: -0.02em;
}

/* INFO */

.admin-book-detail-info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.admin-book-detail-info-item {
  padding: 16px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 15px;
  background: rgba(248, 250, 252, 0.72);
}

.admin-book-detail-info-item span {
  display: block;
  margin-bottom: 6px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.admin-book-detail-info-item strong {
  display: block;
  color: #1e293b;
  font-size: 14px;
  line-height: 1.5;
  word-break: break-word;
}

.admin-book-detail-description {
  margin-top: 16px;
  padding-top: 18px;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.admin-book-detail-description > span {
  display: block;
  margin-bottom: 8px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.admin-book-detail-description p {
  margin: 0;
  color: #475569;
  font-size: 14px;
  line-height: 1.7;
}

/* STATS */

.admin-book-detail-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 20px;
}

.admin-book-detail-stat-card {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 20px;
  border: 1px solid rgba(148, 163, 184, 0.15);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14px 35px rgba(15, 23, 42, 0.045);
}

.admin-book-detail-stat-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #eff6ff;
  color: #2563eb;
}

.admin-book-detail-stat-card span {
  display: block;
  margin-bottom: 3px;
  color: #64748b;
  font-size: 11px;
  font-weight: 600;
}

.admin-book-detail-stat-card strong {
  display: block;
  color: #0f172a;
  font-size: 22px;
}

/* COPY */

.admin-book-copy-heading {
  margin-bottom: 20px;
}

.admin-book-copy-add-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 40px;
  padding: 0 15px;
  border: 0;
  border-radius: 11px;
  background: #2563eb;
  color: #ffffff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.18);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-copy-add-button:hover {
  transform: translateY(-1px);
  background: #1d4ed8;
  box-shadow: 0 12px 24px rgba(37, 99, 235, 0.22);
}

.admin-book-copy-loading {
  min-height: 180px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #64748b;
}

.admin-book-copy-loading p {
  margin: 0;
  font-size: 13px;
}

.admin-book-copy-empty {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20px;
  text-align: center;
  border: 1px dashed rgba(148, 163, 184, 0.3);
  border-radius: 18px;
  background: rgba(248, 250, 252, 0.55);
  color: #64748b;
}

.admin-book-copy-empty > svg {
  margin-bottom: 10px;
  color: #94a3b8;
}

.admin-book-copy-empty h3 {
  margin: 0 0 6px;
  color: #334155;
  font-size: 16px;
}

.admin-book-copy-empty p {
  max-width: 520px;
  margin: 0 0 18px;
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}

.admin-book-copy-empty button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 38px;
  padding: 0 14px;
  border: 0;
  border-radius: 10px;
  background: #2563eb;
  color: #ffffff;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.admin-book-copy-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.admin-book-copy-row {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 15px;
  border: 1px solid rgba(148, 163, 184, 0.14);
  border-radius: 15px;
  background: rgba(248, 250, 252, 0.65);
}

.admin-book-copy-number {
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 12px;
  font-weight: 800;
}

.admin-book-copy-main {
  flex: 1;
  min-width: 0;
}

.admin-book-copy-barcode,
.admin-book-copy-location {
  display: flex;
  align-items: center;
  gap: 7px;
}

.admin-book-copy-barcode {
  color: #1e293b;
  font-size: 13px;
}

.admin-book-copy-location {
  margin-top: 5px;
  color: #64748b;
  font-size: 11px;
}

.admin-book-copy-status {
  flex: 0 0 auto;
  padding: 6px 10px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 800;
}

.admin-book-copy-status-available {
  background: #ecfdf5;
  color: #047857;
}

.admin-book-copy-status-borrowed {
  background: #eff6ff;
  color: #1d4ed8;
}

.admin-book-copy-status-lost {
  background: #fffbeb;
  color: #b45309;
}

.admin-book-copy-status-damaged {
  background: #fef2f2;
  color: #b91c1c;
}

.admin-book-copy-status-default {
  background: #f1f5f9;
  color: #475569;
}

.admin-book-copy-edit-button {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 7px 10px;
  border: 1px solid rgba(37, 99, 235, 0.16);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.8);
  color: #2563eb;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.admin-book-copy-edit-button:hover {
  background: #eff6ff;
  border-color: rgba(37, 99, 235, 0.3);
  transform: translateY(-1px);
}

.admin-book-copy-edit-button:active {
  transform: translateY(0);
}

.admin-book-copy-delete-button {
  flex: 0 0 auto;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 7px 10px;
  border: 1px solid rgba(220, 38, 38, 0.14);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.8);
  color: #dc2626;
  font-size: 11px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background 0.2s ease,
    border-color 0.2s ease,
    transform 0.2s ease;
}

.admin-book-copy-delete-button:hover {
  background: #fef2f2;
  border-color: rgba(220, 38, 38, 0.28);
  transform: translateY(-1px);
}

.admin-book-copy-delete-button:active {
  transform: translateY(0);
}

/* STATE */

.admin-book-detail-state {
  min-height: 420px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  text-align: center;
  color: #64748b;
}

.admin-book-detail-state p {
  margin: 0;
  font-size: 13px;
}

.admin-book-detail-error h2 {
  margin: 0;
  color: #334155;
}

.admin-book-detail-error button {
  margin-top: 8px;
  padding: 10px 15px;
  border: 0;
  border-radius: 10px;
  background: #2563eb;
  color: #ffffff;
  font-family: inherit;
  font-weight: 700;
  cursor: pointer;
}

/* RESPONSIVE */

@media (max-width: 760px) {
  .admin-book-detail-page {
    padding: 24px 14px 50px;
  }

  .admin-book-detail-hero {
    align-items: flex-start;
    padding: 22px;
  }

  .admin-book-detail-info-grid,
  .admin-book-detail-stats {
    grid-template-columns: 1fr;
  }

  .admin-book-detail-section-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-book-copy-add-button {
    width: 100%;
  }

  .admin-book-copy-row {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .admin-book-copy-status {
    margin-left: 49px;
  }
}

/* =========================================================
   ADMIN - TAMBAH EKSEMPLAR
   ========================================================= */

.admin-book-copy-form-page {
  min-height: 100vh;
  padding: 40px 24px 70px;
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(37, 99, 235, 0.08),
      transparent 28%
    ),
    radial-gradient(
      circle at 90% 10%,
      rgba(14, 165, 233, 0.06),
      transparent 25%
    ),
    #f8fafc;
}

.admin-book-copy-form-container {
  width: min(980px, 100%);
  margin: 0 auto;
}

.admin-book-copy-form-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 20px;
  padding: 10px 14px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.82);
  color: #475569;
  font-family: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    box-shadow 0.18s ease;
}

.admin-book-copy-form-back:hover {
  transform: translateY(-1px);
  background: #ffffff;
  box-shadow:
    0 8px 22px rgba(15, 23, 42, 0.07);
}

/* HEADER */

.admin-book-copy-form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  margin-bottom: 20px;
  padding: 30px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow:
    0 20px 50px rgba(15, 23, 42, 0.06),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-book-copy-form-eyebrow {
  display: block;
  margin-bottom: 8px;
  color: #64748b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.admin-book-copy-form-header h1 {
  margin: 0;
  color: #0f172a;
  font-size: clamp(26px, 3vw, 34px);
  line-height: 1.15;
  letter-spacing: -0.025em;
}

.admin-book-copy-form-header p {
  margin: 8px 0 0;
  color: #64748b;
  font-size: 13px;
  line-height: 1.6;
}

.admin-book-copy-form-icon {
  width: 68px;
  height: 68px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 19px;
  background: linear-gradient(
    145deg,
    #eff6ff,
    #dbeafe
  );
  color: #2563eb;
  box-shadow:
    0 12px 28px rgba(37, 99, 235, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

/* INFORMASI BUKU */

.admin-book-copy-form-book {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  padding: 20px 22px;
  border: 1px solid rgba(37, 99, 235, 0.12);
  border-radius: 18px;
  background:
    linear-gradient(
      135deg,
      rgba(239, 246, 255, 0.95),
      rgba(255, 255, 255, 0.9)
    );
  box-shadow:
    0 12px 30px rgba(37, 99, 235, 0.05);
}

.admin-book-copy-form-book-icon {
  width: 46px;
  height: 46px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 13px;
  background: #ffffff;
  color: #2563eb;
  box-shadow:
    0 7px 18px rgba(37, 99, 235, 0.08);
}

.admin-book-copy-form-book > div:last-child {
  min-width: 0;
}

.admin-book-copy-form-book > div:last-child > span {
  display: block;
  margin-bottom: 5px;
  color: #64748b;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.11em;
}

.admin-book-copy-form-book h2 {
  margin: 0;
  color: #0f172a;
  font-size: 16px;
  line-height: 1.4;
}

.admin-book-copy-form-book p {
  margin: 4px 0 0;
  color: #64748b;
  font-size: 11px;
}

/* FORM CARD */

.admin-book-copy-form-card {
  padding: 28px;
  border: 1px solid rgba(148, 163, 184, 0.16);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 18px 45px rgba(15, 23, 42, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-book-copy-form-section-label {
  display: block;
  margin-bottom: 18px;
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.14em;
}

.admin-book-copy-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.admin-book-copy-form-field {
  min-width: 0;
}

.admin-book-copy-form-field label {
  display: block;
  margin-bottom: 8px;
  color: #334155;
  font-size: 12px;
  font-weight: 700;
}

.admin-book-copy-form-field label span {
  margin-left: 3px;
  color: #dc2626;
}

.admin-book-copy-form-input-wrapper {
  display: flex;
  align-items: center;
  gap: 10px;
  height: 48px;
  box-sizing: border-box;
  padding: 0 14px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 13px;
  background: rgba(248, 250, 252, 0.82);
  color: #64748b;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-copy-form-input-wrapper:focus-within {
  border-color: rgba(37, 99, 235, 0.55);
  background: #ffffff;
  box-shadow:
    0 0 0 4px rgba(37, 99, 235, 0.08);
}

.admin-book-copy-form-input-wrapper input {
  width: 100%;
  min-width: 0;
  height: 100%;
  padding: 0;
  border: 0;
  outline: none;
  background: transparent;
  color: #0f172a;
  font-family: inherit;
  font-size: 13px;
}

.admin-book-copy-form-input-wrapper input::placeholder {
  color: #94a3b8;
}

.admin-book-copy-form-field small {
  display: block;
  margin-top: 7px;
  color: #94a3b8;
  font-size: 10px;
  line-height: 1.5;
}

/* STATUS */

.admin-book-copy-form-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 24px;
  padding: 17px 18px;
  border: 1px solid rgba(16, 185, 129, 0.14);
  border-radius: 15px;
  background: #f0fdf4;
}

.admin-book-copy-form-status > div span {
  display: block;
  margin-bottom: 4px;
  color: #64748b;
  font-size: 10px;
  font-weight: 700;
}

.admin-book-copy-form-status > div strong {
  color: #047857;
  font-size: 14px;
}

.admin-book-copy-form-status p {
  margin: 0;
  color: #64748b;
  font-size: 11px;
  line-height: 1.5;
  text-align: right;
}

.admin-book-copy-form-status p b {
  color: #047857;
}

/* ERROR */

.admin-book-copy-form-error {
  margin-top: 18px;
  padding: 12px 14px;
  border: 1px solid rgba(239, 68, 68, 0.16);
  border-radius: 12px;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 12px;
  font-weight: 600;
}

/* ACTIONS */

.admin-book-copy-form-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 26px;
  padding-top: 22px;
  border-top: 1px solid rgba(148, 163, 184, 0.14);
}

.admin-book-copy-form-cancel,
.admin-book-copy-form-submit {
  min-width: 145px;
  height: 42px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  box-sizing: border-box;
  border-radius: 11px;
  font-family: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.admin-book-copy-form-cancel {
  border: 1px solid rgba(148, 163, 184, 0.24);
  background: #ffffff;
  color: #475569;
}

.admin-book-copy-form-cancel:hover:not(:disabled) {
  transform: translateY(-1px);
  background: #f8fafc;
  box-shadow:
    0 8px 18px rgba(15, 23, 42, 0.06);
}

.admin-book-copy-form-submit {
  border: 0;
  background: #2563eb;
  color: #ffffff;
  box-shadow:
    0 8px 18px rgba(37, 99, 235, 0.18);
}

.admin-book-copy-form-submit:hover:not(:disabled) {
  transform: translateY(-1px);
  background: #1d4ed8;
  box-shadow:
    0 12px 24px rgba(37, 99, 235, 0.22);
}

.admin-book-copy-form-cancel:disabled,
.admin-book-copy-form-submit:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* STATE */

.admin-book-copy-form-state {
  min-height: 450px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  text-align: center;
  color: #64748b;
}

.admin-book-copy-form-state h2 {
  margin: 0;
  color: #334155;
}

.admin-book-copy-form-state p {
  margin: 0;
  font-size: 13px;
}

/* RESPONSIVE */

@media (max-width: 720px) {
  .admin-book-copy-form-page {
    padding: 24px 14px 50px;
  }

  .admin-book-copy-form-header {
    align-items: flex-start;
    padding: 22px;
  }

  .admin-book-copy-form-icon {
    width: 56px;
    height: 56px;
  }

  .admin-book-copy-form-grid {
    grid-template-columns: 1fr;
  }

  .admin-book-copy-form-card {
    padding: 22px;
  }

  .admin-book-copy-form-book {
    align-items: flex-start;
  }

  .admin-book-copy-form-status {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-book-copy-form-status p {
    text-align: left;
  }

  .admin-book-copy-form-actions {
    flex-direction: column-reverse;
  }

  .admin-book-copy-form-cancel,
  .admin-book-copy-form-submit {
    width: 100%;
  }
}

.book-author-multiline {
  white-space: pre-line;
}

/* =========================================================
   USEFECT — ADMIN RESERVATION
   Mengikuti visual language homepage DEAL
   ========================================================= */

.admin-reservation-page {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 10% 0%,
      rgba(37, 99, 235, 0.055),
      transparent 30%
    ),
    radial-gradient(
      circle at 90% 15%,
      rgba(30, 64, 175, 0.04),
      transparent 28%
    ),
    #f7f9fc;
}

/* Page heading */

.admin-reservation-page h1 {
  color: #10245d !important;
  letter-spacing: -0.035em;
}

.admin-reservation-page h2,
.admin-reservation-page h3 {
  color: #172033 !important;
}

/* Statistics */

.admin-reservation-page
  .content-container
  > div:nth-child(2) {
  perspective: 1000px;
}

.admin-reservation-page
  .content-container
  > div:nth-child(2)
  > div {
  border:
    1px solid rgba(215, 226, 245, 0.85) !important;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.96),
      rgba(247, 250, 255, 0.9)
    ) !important;

  box-shadow:
    0 12px 30px rgba(15, 23, 42, 0.055),
    inset 0 1px 0 rgba(255, 255, 255, 0.9) !important;

  backdrop-filter: blur(18px);
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease !important;
}

.admin-reservation-page
  .content-container
  > div:nth-child(2)
  > div:hover {
  transform:
    translateY(-4px)
    translateZ(12px) !important;

  box-shadow:
    0 20px 38px rgba(15, 23, 42, 0.09),
    0 5px 14px rgba(37, 99, 235, 0.06) !important;
}

/* Filter */

.admin-reservation-page
  .content-container
  > section {
  border:
    1px solid rgba(215, 226, 245, 0.85) !important;

  background:
    rgba(255, 255, 255, 0.88) !important;

  box-shadow:
    0 10px 28px rgba(15, 23, 42, 0.045) !important;

  backdrop-filter: blur(20px);
}

/* Reservation cards */

.admin-reservation-page
  .content-container
  > section:last-of-type
  article {
  border:
    1px solid rgba(215, 226, 245, 0.82) !important;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.97),
      rgba(250, 252, 255, 0.92)
    ) !important;

  box-shadow:
    0 12px 30px rgba(15, 23, 42, 0.055),
    inset 0 1px 0 rgba(255, 255, 255, 0.95) !important;

  backdrop-filter: blur(18px);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease !important;
}

.admin-reservation-page
  .content-container
  > section:last-of-type
  article:hover {
  transform:
    translateY(-4px)
    rotateX(0.5deg) !important;

  box-shadow:
    0 24px 45px rgba(15, 23, 42, 0.10),
    0 7px 16px rgba(37, 99, 235, 0.06) !important;
}

/* Book icon */

.admin-reservation-page
  .content-container
  > section:last-of-type
  article
  > div
  > div
  > div:first-child {
  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease !important;
}

/* Buttons */

.admin-reservation-page button {
  font-family: inherit;
}

.admin-reservation-page
  button:hover:not(:disabled) {
  filter: brightness(1.015);
}

.admin-reservation-page
  button:active:not(:disabled) {
  transform: translateY(1px) !important;
}

/* Inputs */

.admin-reservation-page input {
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease !important;
}

.admin-reservation-page input:focus {
  border-color:
    rgba(37, 99, 235, 0.45) !important;

  background: #fff !important;

  box-shadow:
    0 0 0 4px rgba(37, 99, 235, 0.08) !important;
}

/* Pickup modal */

.admin-reservation-page
  > div[style*="position: fixed"] {
  background:
    rgba(9, 43, 117, 0.42) !important;

  backdrop-filter: blur(14px) !important;
}

.admin-reservation-page
  > div[style*="position: fixed"]
  > div {
  border:
    1px solid rgba(255, 255, 255, 0.7) !important;

  background:
    rgba(255, 255, 255, 0.96) !important;

  box-shadow:
    0 35px 90px rgba(15, 23, 42, 0.25) !important;
}

/* Responsive */

@media (max-width: 900px) {
  .admin-reservation-page
    .content-container
    > div:nth-child(2) {
    grid-template-columns:
      1fr !important;
  }

  .admin-reservation-page
    .content-container
    > section:last-of-type
    article {
    padding: 18px !important;
  }
}

@media (max-width: 640px) {
  .admin-reservation-page
    .content-container {
    padding:
      22px 15px 35px !important;
  }

  .admin-reservation-page
    .content-container
    > section:last-of-type
    article
    > div {
    flex-direction:
      column !important;
  }

  .admin-reservation-page
    .content-container
    > section:last-of-type
    article
    > div
    > div:last-child {
    width: 100% !important;
  }
}

@keyframes admin-refresh-spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* FIX: aktifkan kembali efek tombol pada halaman reservasi */
.library-page.admin-reservation-page button {
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease !important;
  transform: translateY(0) !important;
}

.library-page.admin-reservation-page button:hover:not(:disabled) {
  transform: translateY(-2px) !important;
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.14) !important;
}

.library-page.admin-reservation-page button:active:not(:disabled) {
  transform: translateY(0) scale(0.97) !important;
}

.library-page.admin-reservation-page button:disabled {
  cursor: wait;
  opacity: 0.7;
}

/* Efek tab filter */
.library-page.admin-reservation-page button:hover:not(:disabled) {
  border-color: rgba(37, 99, 235, 0.25) !important;
}

/* Animasi icon Refresh */
@keyframes admin-refresh-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.library-page.admin-reservation-page button svg {
  transition: transform 0.2s ease !important;
}

.library-page.admin-reservation-page button:hover:not(:disabled) svg {
  transform: scale(1.08) !important;
}

/* =========================================================
   RESERVASI SAYA — USEFECT
   Mengikuti visual language halaman utama
   ========================================================= */

.reservation-page {
  min-height: 100vh;
  background:
    linear-gradient(
      180deg,
      #f7faff 0%,
      #ffffff 55%,
      #f7faff 100%
    );
}

.reservation-page .reservation-header {
  margin-bottom: 28px;
}

.reservation-page .reservation-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
  color: #3569b8;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.2px;
  text-transform: uppercase;
}

.reservation-page .reservation-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.reservation-page .reservation-title {
  margin: 0;
  color: #10245d;
  font-size: 32px;
  font-weight: 900;
  letter-spacing: -0.8px;
}

.reservation-page .reservation-subtitle {
  margin: 8px 0 0;
  color: #68799d;
  font-size: 14px;
}

.reservation-page .reservation-refresh {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 11px 16px;
  border: 1px solid rgba(37, 99, 235, .14);
  border-radius: 12px;
  background: rgba(255, 255, 255, .9);
  color: #2563eb;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 8px 24px rgba(30, 64, 175, .08);
  transition:
    transform .2s ease,
    box-shadow .2s ease,
    background .2s ease;
}

.reservation-page .reservation-refresh:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #eff6ff;
  box-shadow: 0 12px 28px rgba(37, 99, 235, .16);
}

.reservation-page .reservation-refresh:active:not(:disabled) {
  transform: translateY(0);
}

.reservation-page .reservation-refresh:disabled {
  cursor: wait;
  opacity: .7;
}

.reservation-page .reservation-refresh.spinning svg {
  animation: reservation-refresh-spin .8s linear infinite;
}

@keyframes reservation-refresh-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.reservation-page .reservation-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  margin-bottom: 24px;
}

.reservation-page .reservation-stat {
  min-height: 145px;
}

.reservation-page .reservation-stat-icon {
  width: 22px;
  height: 22px;
}

.reservation-page .reservation-stat-content {
  margin-top: 12px;
}

.reservation-page .reservation-stat-label {
  display: block;
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.reservation-page .reservation-stat-number {
  display: block;
  margin-top: 5px;
  color: #10245d;
  font-size: 27px;
  font-weight: 800;
}

.reservation-page .reservation-stat-description {
  color: #94a3b8;
  font-size: 12px;
}

.reservation-page .reservation-list {
  display: grid;
  gap: 16px;
}

.reservation-page .reservation-card {
  position: relative;
  overflow: hidden;
  padding: 24px;
  border: 1px solid rgba(215, 226, 245, .8);
  border-radius: 20px;
  background: rgba(255, 255, 255, .88);
  box-shadow: 0 12px 32px rgba(15, 23, 42, .055);
  transition:
    transform .25s ease,
    box-shadow .25s ease,
    border-color .25s ease;
}

.reservation-page .reservation-card:hover {
  transform: translateY(-3px);
  border-color: rgba(37, 99, 235, .16);
  box-shadow:
    0 20px 40px rgba(15, 23, 42, .08),
    0 6px 16px rgba(15, 23, 42, .04);
}

.reservation-page .reservation-card-inner {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  flex-wrap: wrap;
}

.reservation-page .reservation-book {
  display: flex;
  min-width: 0;
  gap: 15px;
}

.reservation-page .reservation-book-icon {
  flex: 0 0 50px;
  width: 50px;
  height: 62px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, #102c73, #2677ed);
  color: #fff;
}

.reservation-page .reservation-book-info {
  min-width: 0;
}

.reservation-page .reservation-meta-top {
  display: flex;
  align-items: center;
  gap: 9px;
  flex-wrap: wrap;
}

.reservation-page .reservation-number {
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.reservation-page .reservation-status {
  padding: 5px 9px;
  border-radius: 999px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 10px;
  font-weight: 800;
}

.reservation-page .reservation-book-title {
  margin: 10px 0 5px;
  color: #10245d;
  font-size: 18px;
  font-weight: 850;
  line-height: 1.35;
}

.reservation-page .reservation-book-author {
  margin: 0;
  color: #71809d;
  font-size: 12px;
}

.reservation-page .reservation-cancel {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 9px 13px;
  border: 1px solid rgba(220, 38, 38, .14);
  border-radius: 10px;
  background: #fff;
  color: #dc2626;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform .2s ease,
    background .2s ease,
    box-shadow .2s ease;
}

.reservation-page .reservation-cancel:hover:not(:disabled) {
  transform: translateY(-1px);
  background: #fef2f2;
  box-shadow: 0 8px 18px rgba(220, 38, 38, .08);
}

.reservation-page .reservation-cancel:disabled {
  cursor: wait;
  opacity: .6;
}

.reservation-page .reservation-details {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
  margin-top: 24px;
  padding-top: 18px;
  border-top: 1px solid rgba(215, 226, 245, .7);
}

.reservation-page .reservation-detail-label {
  display: block;
  color: #94a3b8;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1px;
}

.reservation-page .reservation-detail-value {
  display: block;
  margin-top: 6px;
  color: #334155;
  font-size: 12px;
  line-height: 1.45;
}

.reservation-page .reservation-ready {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 18px;
  padding: 12px 14px;
  border-radius: 12px;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 12px;
  font-weight: 700;
}

.reservation-page .reservation-empty,
.reservation-page .reservation-error {
  padding: 70px 20px;
  text-align: center;
  border: 1px solid rgba(215, 226, 245, .8);
  border-radius: 22px;
  background: rgba(255, 255, 255, .82);
  box-shadow: 0 15px 40px rgba(15, 23, 42, .05);
}

.reservation-page .reservation-empty h2 {
  margin: 16px 0 6px;
  color: #10245d;
  font-size: 20px;
}

.reservation-page .reservation-empty p {
  margin: 0;
  color: #94a3b8;
  font-size: 13px;
}

.reservation-page .reservation-error {
  padding: 40px 20px;
  border-color: rgba(220, 38, 38, .12);
  color: #b91c1c;
}

@media (max-width: 800px) {
  .reservation-page .reservation-stats,
  .reservation-page .reservation-details {
    grid-template-columns: 1fr;
  }

  .reservation-page .reservation-title {
    font-size: 27px;
  }
}


/* =========================================
   PEMINJAMAN — UPGRADE USER EXPERIENCE
   ========================================= */

.loan-header-actions {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
}

.loan-refresh {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 40px;
  padding: 9px 13px;
  border: 1px solid rgba(37, 99, 235, 0.16);
  border-radius: 12px;
  background: rgba(239, 246, 255, 0.9);
  color: #2563eb;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.loan-refresh:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #eff6ff;
  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.12);
}

.loan-refresh:disabled {
  cursor: wait;
  opacity: 0.7;
}

.loan-refresh.is-loading svg {
  animation: loan-refresh-spin 0.8s linear infinite;
}

@keyframes loan-refresh-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

.loan-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-top: 20px;
}

.loan-stat {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 86px;
  padding: 16px 18px;
  border: 1px solid rgba(148, 163, 184, 0.24);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.94);
  color: #2563eb;
  text-align: left;
  cursor: pointer;
  box-shadow:
    0 10px 24px rgba(15, 23, 42, 0.05),
    0 2px 5px rgba(15, 23, 42, 0.03);
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    border-color 0.18s ease;
}

.loan-stat:hover {
  transform: translateY(-3px);
  box-shadow:
    0 16px 30px rgba(15, 23, 42, 0.08),
    0 3px 7px rgba(15, 23, 42, 0.04);
}

.loan-stat.is-active {
  border-color: rgba(37, 99, 235, 0.28);
  box-shadow:
    0 14px 30px rgba(37, 99, 235, 0.1),
    inset 0 0 0 1px rgba(37, 99, 235, 0.08);
}

.loan-stat.is-warning {
  color: #d97706;
}

.loan-stat.is-danger {
  color: #dc2626;
}

.loan-stat div {
  min-width: 0;
}

.loan-stat span {
  display: block;
  color: #94a3b8;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.loan-stat strong {
  display: block;
  margin-top: 3px;
  color: #0f172a;
  font-size: 24px;
  line-height: 1;
  font-weight: 850;
}

.loan-tabs {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-top: 22px;
  padding: 6px;
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 15px;
  background: rgba(241, 245, 249, 0.72);
}

.loan-tabs button {
  min-height: 38px;
  padding: 8px 14px;
  border: 0;
  border-radius: 10px;
  background: transparent;
  color: #64748b;
  font-size: 12px;
  font-weight: 750;
  cursor: pointer;
  transition:
    background 0.18s ease,
    color 0.18s ease,
    transform 0.18s ease;
}

.loan-tabs button:hover {
  color: #2563eb;
  transform: translateY(-1px);
}

.loan-tabs button.active {
  background: #ffffff;
  color: #2563eb;
  box-shadow: 0 4px 12px rgba(15, 23, 42, 0.07);
}

.loan-detail.is-due {
  color: #d97706;
}

.loan-detail.is-due strong {
  color: #b45309;
}

.loan-detail small {
  display: block;
  margin-top: 3px;
  color: #94a3b8;
  font-size: 10px;
  font-weight: 650;
}

.loan-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 13px 24px 16px;
  border-top: 1px solid rgba(226, 232, 240, 0.82);
  background: rgba(248, 250, 252, 0.62);
}

.loan-footer-info {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #64748b;
  font-size: 11px;
  font-weight: 650;
}

.loan-renew-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 36px;
  padding: 8px 13px;
  border: 1px solid rgba(37, 99, 235, 0.18);
  border-radius: 10px;
  background: #eff6ff;
  color: #2563eb;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease,
    background 0.18s ease;
}

.loan-renew-button:hover:not(:disabled) {
  transform: translateY(-2px);
  background: #dbeafe;
  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.13);
}

.loan-renew-button:disabled {
  cursor: wait;
  opacity: 0.72;
}

.loan-renew-spin {
  animation: loan-refresh-spin 0.8s linear infinite;
}

.overdue-footer {
  background: rgba(254, 242, 242, 0.65);
}

.overdue-footer .loan-footer-info {
  color: #b91c1c;
}

.returned-footer {
  background: rgba(240, 253, 250, 0.65);
}

.returned-footer .loan-footer-info {
  color: #0f766e;
}

.loan-error {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 24px;
  padding: 18px 20px;
  border: 1px solid rgba(239, 68, 68, 0.18);
  border-radius: 16px;
  background: rgba(254, 242, 242, 0.9);
  color: #b91c1c;
  font-size: 13px;
  font-weight: 650;
}

@media (max-width: 900px) {
  .loan-stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 700px) {
  .loan-header {
    align-items: flex-start;
  }

  .loan-header-actions {
    flex-direction: column;
    align-items: flex-end;
  }

  .loan-tabs {
    overflow-x: auto;
  }

  .loan-tabs button {
    flex-shrink: 0;
  }

  .loan-card-main {
    flex-wrap: wrap;
  }

  .loan-status {
    order: 3;
  }

  .loan-detail-button {
    order: 4;
    margin-left: auto;
  }

  .loan-card-footer {
    align-items: flex-start;
    flex-direction: column;
  }

  .loan-renew-button {
    width: 100%;
  }
}

@media (max-width: 520px) {
  .loan-stats {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .loan-stat {
    min-height: 76px;
    padding: 13px;
  }

  .loan-stat strong {
    font-size: 21px;
  }
}

/* =========================
   HOMEPAGE NOTIFICATION BADGE
   ========================= */

.library-page .header-actions .notification {
  position: relative;
}

.library-page .header-actions .notification-badge {
  position: absolute;
  top: -5px;
  right: -5px;
  min-width: 17px;
  height: 17px;
  padding: 0 4px;
  display: grid;
  place-items: center;
  border: 2px solid white;
  border-radius: 999px;
  background: #ef4444;
  color: white;
  font-size: 8px;
  font-weight: 900;
  line-height: 1;
  pointer-events: none;
}


/* =========================================================
   CAMERA SCANNER - MANUAL TRANSACTION
   ========================================================= */

.admin-manage-loan-scan-input {
  display: flex;
  gap: 8px;
  width: 100%;
}

.admin-manage-loan-scan-input input {
  flex: 1;
  min-width: 0;
}

.admin-manage-loan-camera-button {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-width: 82px;
  padding: 0 15px;
  border: 1px solid rgba(37, 99, 235, 0.18);
  border-radius: 12px;
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    background 0.2s ease,
    border-color 0.2s ease;
}

.admin-manage-loan-camera-button:hover {
  transform: translateY(-1px);
  background: rgba(37, 99, 235, 0.14);
  border-color: rgba(37, 99, 235, 0.3);
}

/* Scanner overlay */

.admin-manage-loan-scanner-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background: rgba(15, 23, 42, 0.68);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.admin-manage-loan-scanner-modal {
  width: min(680px, 100%);
  max-height: calc(100vh - 48px);
  overflow-y: auto;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 24px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(246, 249, 255, 0.96)
    );
  box-shadow:
    0 30px 80px rgba(15, 23, 42, 0.28),
    0 8px 24px rgba(37, 99, 235, 0.12);
  padding: 24px;
}

.admin-manage-loan-scanner-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
  margin-bottom: 20px;
}

.admin-manage-loan-scanner-header h2 {
  margin: 5px 0 5px;
  color: #172033;
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.admin-manage-loan-scanner-header p {
  margin: 0;
  color: #758093;
  font-size: 13px;
  line-height: 1.5;
}

.admin-manage-loan-scanner-close {
  flex-shrink: 0;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(15, 23, 42, 0.08);
  border-radius: 12px;
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  font-size: 26px;
  line-height: 1;
  cursor: pointer;
  transition:
    background 0.2s ease,
    color 0.2s ease,
    transform 0.2s ease;
}

.admin-manage-loan-scanner-close:hover {
  background: #ffffff;
  color: #172033;
  transform: scale(1.03);
}

.admin-manage-loan-scanner-camera-select {
  margin-bottom: 16px;
}

.admin-manage-loan-scanner-camera-select label {
  display: block;
  margin-bottom: 7px;
  color: #475569;
  font-size: 12px;
  font-weight: 700;
}

.admin-manage-loan-scanner-camera-select select {
  width: 100%;
  min-height: 44px;
  padding: 0 13px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  border-radius: 12px;
  outline: none;
  background: #ffffff;
  color: #334155;
  font-size: 13px;
  cursor: pointer;
}

.admin-manage-loan-scanner-camera-select select:focus {
  border-color: rgba(37, 99, 235, 0.5);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.admin-manage-loan-scanner-video-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  border-radius: 18px;
  background: #0f172a;
  box-shadow:
    inset 0 0 0 1px rgba(255, 255, 255, 0.08),
    0 12px 30px rgba(15, 23, 42, 0.16);
}

.admin-manage-loan-scanner-video {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.admin-manage-loan-scanner-frame {
  position: absolute;
  inset: 15% 18%;
  border: 2px solid rgba(255, 255, 255, 0.88);
  border-radius: 18px;
  pointer-events: none;
  box-shadow:
    0 0 0 999px rgba(15, 23, 42, 0.12);
}

.admin-manage-loan-scanner-frame::before,
.admin-manage-loan-scanner-frame::after,
.admin-manage-loan-scanner-frame span::before,
.admin-manage-loan-scanner-frame span::after {
  content: "";
  position: absolute;
  width: 24px;
  height: 24px;
  border-color: #ffffff;
  border-style: solid;
}

.admin-manage-loan-scanner-frame::before {
  top: -2px;
  left: -2px;
  border-width: 3px 0 0 3px;
  border-radius: 7px 0 0 0;
}

.admin-manage-loan-scanner-frame::after {
  top: -2px;
  right: -2px;
  border-width: 3px 3px 0 0;
  border-radius: 0 7px 0 0;
}

.admin-manage-loan-scanner-frame span::before {
  bottom: -2px;
  left: -2px;
  border-width: 0 0 3px 3px;
  border-radius: 0 0 0 7px;
}

.admin-manage-loan-scanner-frame span::after {
  right: -2px;
  bottom: -2px;
  border-width: 0 3px 3px 0;
  border-radius: 0 0 7px 0;
}

.admin-manage-loan-scanner-error {
  margin-top: 12px;
  padding: 11px 13px;
  border: 1px solid rgba(220, 38, 38, 0.14);
  border-radius: 12px;
  background: rgba(254, 226, 226, 0.7);
  color: #b91c1c;
  font-size: 12px;
  line-height: 1.5;
}

.admin-manage-loan-scanner-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-top: 18px;
}

.admin-manage-loan-scanner-footer span {
  color: #64748b;
  font-size: 12px;
  font-weight: 700;
}

.admin-manage-loan-scanner-cancel {
  min-height: 42px;
  padding: 0 18px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  border-radius: 12px;
  background: #ffffff;
  color: #475569;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition:
    background 0.2s ease,
    transform 0.2s ease;
}

.admin-manage-loan-scanner-cancel:hover {
  background: #f8fafc;
  transform: translateY(-1px);
}

@media (max-width: 760px) {
  .admin-manage-loan-scanner-overlay {
    align-items: flex-end;
    padding: 12px;
  }

  .admin-manage-loan-scanner-modal {
    max-height: calc(100vh - 24px);
    padding: 18px;
    border-radius: 20px;
  }

  .admin-manage-loan-scanner-video-wrap {
    aspect-ratio: 4 / 3;
  }

  .admin-manage-loan-scanner-frame {
    inset: 16% 10%;
  }

  .admin-manage-loan-scanner-footer {
    align-items: stretch;
    flex-direction: column;
  }

  .admin-manage-loan-scanner-cancel {
    width: 100%;
  }

  .admin-manage-loan-camera-button {
    min-width: 72px;
    padding: 0 11px;
  }
}


/* =========================================================
   RETURN TRANSACTION
   ========================================================= */

.admin-manage-loan-return-section {
  margin-top: 24px;
}

.admin-manage-loan-return-preview {
  margin-top: 20px;
  padding: 20px;
  border: 1px solid rgba(31, 63, 114, 0.1);
  border-radius: 18px;
  background: rgba(248, 250, 253, 0.72);
}

.admin-manage-loan-return-info {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.admin-manage-loan-return-info > div {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 14px;
  border-radius: 14px;
  background: #ffffff;
  border: 1px solid rgba(31, 63, 114, 0.08);
}

.admin-manage-loan-return-info span,
.admin-manage-loan-return-shelf span {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #8a94a6;
}

.admin-manage-loan-return-info strong {
  font-size: 13px;
  line-height: 1.45;
  color: #26344a;
}

.admin-manage-loan-return-shelf {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  margin-top: 16px;
  padding: 16px 18px;
  border-radius: 14px;
  background: rgba(28, 74, 140, 0.06);
  border: 1px solid rgba(28, 74, 140, 0.1);
}

.admin-manage-loan-return-shelf strong {
  color: #174b91;
  font-size: 15px;
}

.admin-manage-loan-return-condition {
  margin-top: 20px;
}

.admin-manage-loan-return-condition > label {
  display: block;
  margin-bottom: 10px;
  font-size: 12px;
  font-weight: 700;
  color: #475569;
}

.admin-manage-loan-return-condition-buttons {
  display: flex;
  gap: 10px;
}

.admin-manage-loan-return-condition-buttons button {
  min-width: 100px;
  padding: 10px 16px;
  border: 1px solid rgba(31, 63, 114, 0.12);
  border-radius: 10px;
  background: #ffffff;
  color: #536176;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-manage-loan-return-condition-buttons button:hover {
  transform: translateY(-1px);
}

.admin-manage-loan-return-condition-buttons button.active {
  border-color: rgba(28, 74, 140, 0.35);
  background: rgba(28, 74, 140, 0.09);
  color: #174b91;
}

.admin-manage-loan-return-confirm {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 18px;
  padding: 13px 15px;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid rgba(31, 63, 114, 0.08);
  cursor: pointer;
}

.admin-manage-loan-return-confirm input {
  width: 17px;
  height: 17px;
  accent-color: #174b91;
}

.admin-manage-loan-return-confirm span {
  font-size: 12px;
  font-weight: 600;
  color: #475569;
}

@media (max-width: 900px) {
  .admin-manage-loan-return-info {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 600px) {
  .admin-manage-loan-return-info {
    grid-template-columns: 1fr;
  }

  .admin-manage-loan-return-shelf {
    align-items: flex-start;
    flex-direction: column;
    gap: 8px;
  }

  .admin-manage-loan-return-condition-buttons {
    flex-direction: column;
  }

  .admin-manage-loan-return-condition-buttons button {
    width: 100%;
  }
}


/* ================= USEFECT BRAND ================= */

.usefect-brand {
  display: flex;
  align-items: center;
  gap: 13px;
  height: 64px;
  padding: 0;
  margin: 0;
  background: transparent;
  border: 0;
  box-shadow: none;
}

.usefect-logo {
  width: 58px;
  height: 58px;
  flex: 0 0 58px;
  display: block;
}

.usefect-wordmark {
  display: flex;
  flex-direction: column;
  justify-content: center;
  white-space: nowrap;
  line-height: 1;
}

.usefect-wordmark strong {
  display: block;
  color: #0a285f;
  font-size: 27px;
  line-height: .95;
  font-weight: 900;
  letter-spacing: 4px;
}

.usefect-wordmark small {
  display: block;
  margin-top: 7px;
  color: #7182a2;
  font-size: 7px;
  line-height: 1;
  font-weight: 700;
  letter-spacing: 2.4px;
}

@media (max-width: 1100px) {
  .usefect-brand {
    gap: 10px;
    height: 56px;
  }

  .usefect-logo {
    width: 50px;
    height: 50px;
    flex-basis: 50px;
  }

  .usefect-wordmark strong {
    font-size: 23px;
    letter-spacing: 3px;
  }

  .usefect-wordmark small {
    margin-top: 6px;
    font-size: 6px;
    letter-spacing: 1.8px;
  }
}


/* =========================
   SOFT 3D HERO DEPTH
========================= */

.hero {
  perspective: 1400px;
  transform-style: preserve-3d;
  overflow: hidden;
}

.hero-background {
  transform: translateZ(-18px) scale(1.015);
  transform-origin: center center;
  transform-style: preserve-3d;
}

.hero-background::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(
      circle at 72% 42%,
      rgba(255, 255, 255, 0.18),
      transparent 34%
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.08),
      transparent 52%
    );
  pointer-events: none;
}

.hero-content {
  transform: translate3d(0, -2px, 18px);
  transform-style: preserve-3d;
}

.hero-copy {
  transform: translateZ(22px);
  text-shadow:
    0 2px 8px rgba(15, 39, 91, 0.08);
}

.hero h1 {
  text-shadow:
    0 3px 14px rgba(15, 39, 91, 0.10);
}

.hero-copy > p {
  text-shadow:
    0 1px 5px rgba(15, 39, 91, 0.06);
}

.hero-stats {
  transform: translateZ(10px);
}

.hero-stats div {
  transition:
    transform 0.35s ease,
    filter 0.35s ease;
}

.hero-stats div:hover {
  transform: translateY(-3px) translateZ(8px);
  filter: brightness(1.02);
}

@media (prefers-reduced-motion: reduce) {
  .hero,
  .hero-background,
  .hero-content,
  .hero-copy,
  .hero-stats,
  .hero-stats div {
    transform: none;
    transition: none;
  }
}


/* =========================
   CATALOG HERO SOFT 3D
========================= */

.catalog-hero {
  transform-style: preserve-3d;
}

.catalog-hero > div {
  transition:
    transform 0.45s ease,
    filter 0.45s ease;
}

.catalog-hero:hover > div {
  transform: translate3d(0, -2px, 16px);
}

@media (prefers-reduced-motion: reduce) {
  .catalog-hero,
  .catalog-hero > div {
    transform: none;
    transition: none;
  }
}

@media (max-width: 700px) {
  .catalog-hero {
    padding: 48px 20px 55px;
  }

  .catalog-hero h1 {
    font-size: 42px;
    line-height: 1;
    letter-spacing: -1.8px;
  }

  .catalog-hero p {
    font-size: 14px;
    line-height: 1.5;
  }
}

/* =========================================================
   USEFECT GUIDE / PANDUAN
   ========================================================= */

.usefect-guide-page {
  min-height: 100vh;
  background: #fff;
  color: #10233f;
}

.usefect-guide-hero {
  position: relative;
  overflow: hidden;
  min-height: 690px;
  padding: 105px 7% 90px;
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(390px, .72fr);
  align-items: center;
  gap: 70px;
  background:
    radial-gradient(circle at 76% 20%, rgba(57,213,255,.11), transparent 30%),
    radial-gradient(circle at 88% 82%, rgba(244,181,63,.09), transparent 25%),
    linear-gradient(135deg,#ffffff 0%,#f7faff 58%,#eef5ff 100%);
  border-bottom: 1px solid rgba(229,234,241,.9);
  perspective: 1400px;
}

.guide-orb {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  filter: blur(1px);
}

.guide-orb-one {
  width: 360px;
  height: 360px;
  right: -120px;
  top: -120px;
  background: radial-gradient(circle,rgba(7,94,234,.08),transparent 68%);
}

.guide-orb-two {
  width: 260px;
  height: 260px;
  left: -100px;
  bottom: -110px;
  background: radial-gradient(circle,rgba(244,181,63,.08),transparent 68%);
}

.usefect-guide-hero-inner,
.guide-hero-card {
  position: relative;
  z-index: 1;
}

.guide-eyebrow,
.guide-section-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  color: #64748b;
  font-size: 10px;
  line-height: 1.2;
  font-weight: 900;
  letter-spacing: .22em;
  text-transform: uppercase;
}

.guide-eyebrow-line {
  width: 28px;
  height: 2px;
  border-radius: 99px;
  background: linear-gradient(90deg,#075eea,#39d5ff);
}

.usefect-guide-hero h1 {
  max-width: 760px;
  margin: 18px 0 20px;
  color: #06184d;
  font-size: clamp(48px,6vw,78px);
  line-height: .96;
  letter-spacing: -.065em;
  font-weight: 900;
  text-shadow:
    0 2px 0 rgba(255,255,255,.95),
    0 5px 18px rgba(15,39,91,.10);
  transform: translateZ(24px);
}

.usefect-guide-hero h1 em,
.guide-flow-heading h2 em,
.guide-account-section h2 em,
.guide-cta-section h2 em {
  color: #075eea;
  font-style: normal;
}

.usefect-guide-hero-inner > p {
  max-width: 650px;
  margin: 0;
  color: #405782;
  font-size: 16px;
  line-height: 1.65;
  font-weight: 500;
}

.guide-hero-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 30px;
}

.guide-primary-button,
.guide-secondary-button,
.guide-cta-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  text-decoration: none;
  transition: transform .2s ease, box-shadow .2s ease;
}

.guide-primary-button {
  padding: 13px 19px;
  border-radius: 12px;
  color: #fff;
  background: linear-gradient(135deg,#075eea,#0b8ff5);
  box-shadow: 0 12px 28px rgba(7,94,234,.22);
  font-size: 13px;
  font-weight: 800;
}

.guide-secondary-button {
  padding: 12px 17px;
  border: 1px solid rgba(7,94,234,.14);
  border-radius: 12px;
  color: #17365d;
  background: rgba(255,255,255,.72);
  font-size: 13px;
  font-weight: 700;
}

.guide-primary-button:hover,
.guide-secondary-button:hover,
.guide-cta-button:hover {
  transform: translateY(-2px);
}

.guide-hero-card {
  padding: 27px;
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 28px;
  background: rgba(255,255,255,.78);
  box-shadow:
    0 30px 70px rgba(15,39,91,.12),
    inset 0 1px 0 rgba(255,255,255,.95);
  backdrop-filter: blur(18px);
  transform: rotateY(-5deg) rotateX(2deg) translateZ(18px);
}

.guide-hero-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 22px;
  border-bottom: 1px solid #e9eef5;
  color: #7a8799;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .18em;
}

.guide-live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #35c98b;
  box-shadow: 0 0 0 5px rgba(53,201,139,.10);
}

.guide-journey {
  display: flex;
  flex-direction: column;
  gap: 0;
  padding-top: 25px;
}

.journey-step {
  display: flex;
  align-items: center;
  gap: 15px;
}

.journey-icon {
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  flex: 0 0 48px;
  border: 1px solid rgba(7,94,234,.10);
  border-radius: 15px;
  color: #075eea;
  background: linear-gradient(145deg,#f4f9ff,#fff);
  box-shadow: 0 8px 20px rgba(15,39,91,.07);
}

.journey-step div:last-child {
  display: flex;
  flex-direction: column;
}

.journey-step span {
  margin-bottom: 2px;
  color: #b08a45;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.journey-step strong {
  color: #10233f;
  font-size: 15px;
}

.journey-step small {
  margin-top: 2px;
  color: #7a8799;
  font-size: 11px;
}

.journey-line {
  width: 1px;
  height: 34px;
  margin: 5px 0 5px 24px;
  background: linear-gradient(#cbd8e8,transparent);
}

.guide-section {
  padding: 95px 7%;
}

.guide-section-heading {
  max-width: 1180px;
  margin: 0 auto 45px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 50px;
}

.guide-section-heading h2,
.guide-flow-heading h2,
.guide-account-section h2 {
  margin: 12px 0 0;
  color: #06184d;
  font-size: clamp(34px,4vw,52px);
  line-height: 1;
  letter-spacing: -.055em;
  font-weight: 900;
}

.guide-section-heading > p {
  max-width: 480px;
  margin: 0;
  color: #65758b;
  font-size: 14px;
  line-height: 1.7;
}

.guide-card-grid {
  max-width: 1180px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 18px;
}

.guide-card {
  position: relative;
  overflow: hidden;
  min-height: 255px;
  padding: 25px;
  border: 1px solid #e4eaf2;
  border-radius: 22px;
  background: #fff;
  box-shadow: 0 12px 32px rgba(15,39,91,.045);
  transition: transform .2s ease, box-shadow .2s ease;
}

.guide-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 22px 42px rgba(15,39,91,.10);
}

.guide-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.guide-card-top > span {
  color: #b08a45;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .14em;
}

.guide-card-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  color: #075eea;
  background: #f1f6ff;
}

.guide-card h3 {
  margin: 35px 0 10px;
  color: #122747;
  font-size: 20px;
  letter-spacing: -.025em;
}

.guide-card p {
  margin: 0;
  color: #718096;
  font-size: 13px;
  line-height: 1.7;
}

.guide-card-line {
  position: absolute;
  left: 25px;
  right: 25px;
  bottom: 0;
  height: 3px;
  border-radius: 99px 99px 0 0;
  background: linear-gradient(90deg,#075eea,#39d5ff,#f4b53f);
  opacity: .65;
}

.guide-flow-section {
  padding: 100px 7%;
  background:
    radial-gradient(circle at 20% 20%,rgba(57,213,255,.08),transparent 28%),
    linear-gradient(145deg,#f6f9fd,#eef4fb);
  border-top: 1px solid #e5ebf3;
  border-bottom: 1px solid #e5ebf3;
}

.guide-flow-inner {
  max-width: 1180px;
  margin: 0 auto;
}

.guide-flow-heading {
  margin-bottom: 45px;
}

.guide-flow-grid {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 15px;
}

.flow-card {
  position: relative;
  min-height: 285px;
  padding: 27px;
  border: 1px solid rgba(211,222,236,.85);
  border-radius: 22px;
  background: rgba(255,255,255,.78);
  box-shadow: 0 18px 42px rgba(15,39,91,.055);
}

.flow-card-number {
  position: absolute;
  top: 22px;
  right: 23px;
  color: #c1cad6;
  font-size: 11px;
  font-weight: 900;
}

.flow-card-icon {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  margin-bottom: 35px;
  border-radius: 15px;
  color: #075eea;
  background: #fff;
  box-shadow: 0 10px 24px rgba(15,39,91,.08);
}

.flow-card > span {
  color: #b08a45;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .18em;
  text-transform: uppercase;
}

.flow-card h3 {
  margin: 7px 0 9px;
  color: #10233f;
  font-size: 22px;
}

.flow-card p {
  margin: 0;
  color: #718096;
  font-size: 13px;
  line-height: 1.7;
}

.guide-qr-section {
  padding-top: 100px;
  padding-bottom: 100px;
}

.guide-qr-card {
  max-width: 1180px;
  min-height: 420px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: .85fr 1.15fr;
  align-items: center;
  overflow: hidden;
  border: 1px solid #e3eaf2;
  border-radius: 30px;
  background:
    radial-gradient(circle at 15% 30%,rgba(57,213,255,.10),transparent 32%),
    linear-gradient(135deg,#f5f9ff,#fff);
  box-shadow: 0 25px 60px rgba(15,39,91,.08);
}

.guide-qr-visual {
  min-height: 420px;
  display: grid;
  place-items: center;
  position: relative;
  background:
    linear-gradient(145deg,rgba(7,94,234,.04),rgba(244,181,63,.06));
}

.qr-icon-shell {
  width: 160px;
  height: 160px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(7,94,234,.12);
  border-radius: 36px;
  color: #075eea;
  background: rgba(255,255,255,.9);
  box-shadow:
    0 25px 55px rgba(7,94,234,.12),
    0 0 0 15px rgba(7,94,234,.025);
}

.qr-mini-card {
  position: absolute;
  right: 16%;
  bottom: 55px;
  padding: 13px 17px;
  border: 1px solid rgba(255,255,255,.9);
  border-radius: 14px;
  background: rgba(255,255,255,.9);
  box-shadow: 0 15px 30px rgba(15,39,91,.10);
}

.qr-mini-card span {
  display: block;
  margin-bottom: 3px;
  color: #94a0af;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .16em;
}

.qr-mini-card strong {
  color: #075eea;
  font-size: 14px;
}

.guide-qr-content {
  padding: 55px 65px;
}

.guide-qr-content h2 {
  margin: 12px 0 16px;
  color: #06184d;
  font-size: clamp(34px,4vw,48px);
  line-height: 1;
  letter-spacing: -.055em;
}

.guide-qr-content > p {
  max-width: 510px;
  margin: 0 0 23px;
  color: #65758b;
  font-size: 14px;
  line-height: 1.7;
}

.guide-check-list {
  display: grid;
  gap: 10px;
  margin-bottom: 25px;
}

.guide-check-item {
  display: flex;
  align-items: center;
  gap: 9px;
  color: #40536e;
  font-size: 13px;
}

.guide-check-item svg {
  flex: 0 0 auto;
  color: #0b8ff5;
}

.guide-text-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  color: #075eea;
  text-decoration: none;
  font-size: 13px;
  font-weight: 800;
}

.guide-account-section {
  padding: 95px 7%;
  background: #fff;
}

.guide-account-inner {
  max-width: 1180px;
  margin: 0 auto;
}

.guide-account-grid {
  display: grid;
  grid-template-columns: repeat(3,1fr);
  gap: 16px;
}

.account-card {
  display: flex;
  align-items: center;
  gap: 15px;
  padding: 21px;
  border: 1px solid #e4eaf1;
  border-radius: 18px;
  background: #fff;
  box-shadow: 0 10px 26px rgba(15,39,91,.045);
}

.account-card-icon {
  width: 45px;
  height: 45px;
  display: grid;
  place-items: center;
  flex: 0 0 45px;
  border-radius: 13px;
  color: #075eea;
  background: #f2f6ff;
}

.account-card div:nth-child(2) {
  flex: 1;
}

.account-card h3 {
  margin: 0 0 4px;
  color: #172d4c;
  font-size: 15px;
}

.account-card p {
  margin: 0;
  color: #7a8798;
  font-size: 12px;
  line-height: 1.55;
}

.account-card > svg {
  color: #b3bfce;
}

.guide-important-section {
  padding: 75px 7%;
  background: #06184d;
  color: #fff;
}

.guide-important-inner {
  max-width: 1180px;
  margin: 0 auto;
  display: flex;
  align-items: flex-start;
  gap: 22px;
}

.guide-important-icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  flex: 0 0 54px;
  border: 1px solid rgba(255,255,255,.14);
  border-radius: 16px;
  color: #f4c765;
  background: rgba(255,255,255,.06);
}

.guide-important-inner > div:last-child > span {
  color: #f4c765;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .18em;
}

.guide-important-inner h2 {
  max-width: 700px;
  margin: 10px 0 12px;
  color: #fff;
  font-size: clamp(27px,3vw,40px);
  line-height: 1.05;
  letter-spacing: -.04em;
}

.guide-important-inner p {
  max-width: 760px;
  margin: 0;
  color: #b9c6da;
  font-size: 13px;
  line-height: 1.75;
}

.guide-cta-section {
  position: relative;
  overflow: hidden;
  padding: 105px 7%;
  text-align: center;
  background:
    radial-gradient(circle at 50% 35%,rgba(57,213,255,.13),transparent 35%),
    linear-gradient(145deg,#f8fbff,#eef5ff);
}

.guide-cta-inner {
  position: relative;
  z-index: 1;
  max-width: 750px;
  margin: 0 auto;
}

.guide-cta-section h2 {
  margin: 13px 0 15px;
  color: #06184d;
  font-size: clamp(42px,5vw,64px);
  line-height: .98;
  letter-spacing: -.06em;
}

.guide-cta-section p {
  max-width: 540px;
  margin: 0 auto;
  color: #64758d;
  font-size: 14px;
  line-height: 1.7;
}

.guide-cta-button {
  margin-top: 28px;
  padding: 14px 21px;
  border-radius: 12px;
  color: #fff;
  background: linear-gradient(135deg,#075eea,#0b8ff5);
  box-shadow: 0 14px 32px rgba(7,94,234,.22);
  font-size: 13px;
  font-weight: 800;
}

@media (max-width: 980px) {
  .usefect-guide-hero {
    grid-template-columns: 1fr;
    gap: 45px;
  }

  .guide-hero-card {
    max-width: 650px;
    width: 100%;
    transform: none;
  }

  .guide-card-grid,
  .guide-flow-grid {
    grid-template-columns: repeat(2,1fr);
  }

  .guide-qr-card {
    grid-template-columns: 1fr;
  }

  .guide-qr-visual {
    min-height: 320px;
  }
}

@media (max-width: 700px) {
  .usefect-guide-hero,
  .guide-section,
  .guide-flow-section,
  .guide-account-section,
  .guide-important-section,
  .guide-cta-section {
    padding-left: 20px;
    padding-right: 20px;
  }

  .usefect-guide-hero {
    padding-top: 70px;
    padding-bottom: 70px;
  }

  .usefect-guide-hero h1 {
    font-size: clamp(43px,13vw,62px);
  }

  .guide-hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .guide-primary-button,
  .guide-secondary-button {
    width: 100%;
  }

  .guide-section-heading {
    display: block;
  }

  .guide-section-heading > p {
    margin-top: 20px;
  }

  .guide-card-grid,
  .guide-flow-grid,
  .guide-account-grid {
    grid-template-columns: 1fr;
  }

  .guide-card {
    min-height: auto;
  }

  .guide-qr-content {
    padding: 40px 25px;
  }

  .guide-qr-visual {
    min-height: 280px;
  }

  .qr-mini-card {
    right: 8%;
  }

  .guide-important-inner {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  .guide-primary-button,
  .guide-secondary-button,
  .guide-cta-button,
  .guide-card {
    transition: none;
  }
}

/* =========================================================
   USEFECT GUIDE — HERO VISUAL POLISH
   ========================================================= */

.usefect-guide-hero {
  min-height: 720px;
  padding-top: 95px;
  padding-bottom: 100px;
  background:
    radial-gradient(
      circle at 76% 24%,
      rgba(7, 94, 234, .13),
      transparent 30%
    ),
    radial-gradient(
      circle at 88% 80%,
      rgba(244, 181, 63, .10),
      transparent 25%
    ),
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f7faff 52%,
      #edf5ff 100%
    );
}

.usefect-guide-hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 150px;
  pointer-events: none;
  background:
    linear-gradient(
      to bottom,
      transparent,
      rgba(255,255,255,.72)
    );
}

.usefect-guide-hero-inner {
  transform: translateZ(30px);
}

.usefect-guide-hero h1 {
  max-width: 780px;
  margin-top: 22px;
  font-size: clamp(50px, 6.2vw, 82px);
  line-height: .93;
  letter-spacing: -4.5px;
  text-shadow:
    0 1px 0 rgba(255,255,255,.98),
    0 3px 0 rgba(7,31,82,.08),
    0 8px 22px rgba(7,31,82,.13);
}

.usefect-guide-hero h1 em {
  text-shadow:
    0 1px 0 rgba(255,255,255,.98),
    0 3px 0 rgba(5,73,180,.12),
    0 9px 22px rgba(7,94,234,.18);
}

.usefect-guide-hero-inner > p {
  max-width: 610px;
  color: #405782;
  font-size: 16px;
  line-height: 1.58;
  text-shadow:
    0 1px 0 rgba(255,255,255,.8),
    0 3px 8px rgba(15,39,91,.08);
}

.guide-eyebrow {
  color: #526782;
  text-shadow: 0 2px 7px rgba(15,39,91,.08);
}

.guide-eyebrow-line {
  width: 34px;
  box-shadow: 0 2px 8px rgba(7,94,234,.25);
}

.guide-hero-actions {
  margin-top: 34px;
}

.guide-primary-button {
  padding: 14px 21px;
  border-radius: 13px;
  box-shadow:
    0 10px 22px rgba(7,94,234,.20),
    0 2px 0 rgba(255,255,255,.25) inset;
}

.guide-secondary-button {
  padding: 13px 18px;
  background: rgba(255,255,255,.82);
  box-shadow:
    0 8px 20px rgba(15,39,91,.06),
    inset 0 1px 0 rgba(255,255,255,.95);
}

.guide-hero-card {
  min-height: 350px;
  padding: 30px;
  border-radius: 30px;
  background:
    linear-gradient(
      145deg,
      rgba(255,255,255,.92),
      rgba(248,251,255,.72)
    );
  box-shadow:
    0 35px 80px rgba(15,39,91,.14),
    0 8px 22px rgba(7,94,234,.06),
    inset 0 1px 0 rgba(255,255,255,.98);
  transform:
    perspective(1200px)
    rotateY(-7deg)
    rotateX(3deg)
    translateZ(25px);
}

.guide-hero-card::before {
  content: "";
  position: absolute;
  inset: 1px;
  border-radius: 29px;
  pointer-events: none;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.72),
      transparent 40%
    );
}

.guide-hero-card-top {
  position: relative;
  z-index: 1;
  padding-bottom: 25px;
}

.guide-journey {
  position: relative;
  z-index: 1;
  padding-top: 28px;
}

.journey-step {
  padding: 4px 0;
}

.journey-icon {
  width: 52px;
  height: 52px;
  flex-basis: 52px;
  border-radius: 16px;
  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eef5ff
    );
  box-shadow:
    0 10px 24px rgba(15,39,91,.08),
    inset 0 1px 0 rgba(255,255,255,.95);
}

.journey-step strong {
  font-size: 16px;
  letter-spacing: -.02em;
}

.journey-step small {
  font-size: 11px;
}

.journey-line {
  height: 38px;
  margin-left: 25px;
  background:
    linear-gradient(
      to bottom,
      rgba(7,94,234,.25),
      rgba(7,94,234,.03)
    );
}

.guide-live-dot {
  box-shadow:
    0 0 0 5px rgba(53,201,139,.10),
    0 0 14px rgba(53,201,139,.18);
}

/* First content section */
.guide-start-section {
  position: relative;
  padding-top: 105px;
}

.guide-start-section::before {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  right: -220px;
  top: 20px;
  border-radius: 50%;
  pointer-events: none;
  background:
    radial-gradient(
      circle,
      rgba(57,213,255,.055),
      transparent 68%
    );
}

.guide-section-heading h2 {
  text-shadow:
    0 2px 10px rgba(15,39,91,.07);
}

.guide-card {
  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #fbfdff 100%
    );
  box-shadow:
    0 14px 34px rgba(15,39,91,.055),
    inset 0 1px 0 rgba(255,255,255,.95);
}

.guide-card-icon {
  box-shadow:
    0 8px 18px rgba(7,94,234,.07);
}

/* Flow section */
.guide-flow-section {
  position: relative;
  overflow: hidden;
}

.guide-flow-section::before {
  content: "";
  position: absolute;
  width: 500px;
  height: 500px;
  right: -230px;
  bottom: -260px;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(7,94,234,.07),
      transparent 68%
    );
  pointer-events: none;
}

.flow-card {
  transition:
    transform .22s ease,
    box-shadow .22s ease;
}

.flow-card:hover {
  transform: translateY(-5px);
  box-shadow:
    0 25px 50px rgba(15,39,91,.10);
}

.flow-card-icon {
  box-shadow:
    0 12px 28px rgba(15,39,91,.09),
    inset 0 1px 0 rgba(255,255,255,.95);
}

/* QR section */
.guide-qr-card {
  box-shadow:
    0 30px 70px rgba(15,39,91,.09),
    inset 0 1px 0 rgba(255,255,255,.95);
}

.qr-icon-shell {
  transform:
    perspective(700px)
    rotateX(4deg)
    rotateY(-5deg);
  box-shadow:
    0 28px 60px rgba(7,94,234,.14),
    0 0 0 16px rgba(7,94,234,.025),
    inset 0 1px 0 rgba(255,255,255,.98);
}

.qr-mini-card {
  box-shadow:
    0 18px 36px rgba(15,39,91,.11),
    inset 0 1px 0 rgba(255,255,255,.95);
}

/* Account */
.account-card {
  transition:
    transform .2s ease,
    box-shadow .2s ease;
}

.account-card:hover {
  transform: translateY(-3px);
  box-shadow:
    0 18px 36px rgba(15,39,91,.08);
}

/* Important */
.guide-important-section {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 82% 30%,
      rgba(7,94,234,.20),
      transparent 28%
    ),
    linear-gradient(
      135deg,
      #06184d,
      #08245f
    );
}

.guide-important-section::after {
  content: "";
  position: absolute;
  width: 380px;
  height: 380px;
  right: -180px;
  top: -180px;
  border: 1px solid rgba(255,255,255,.06);
  border-radius: 50%;
  box-shadow:
    0 0 0 45px rgba(255,255,255,.015),
    0 0 0 90px rgba(255,255,255,.012);
  pointer-events: none;
}

/* Final CTA */
.guide-cta-section {
  min-height: 450px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-cta-section h2 {
  text-shadow:
    0 2px 0 rgba(255,255,255,.9),
    0 8px 22px rgba(15,39,91,.10);
}

.guide-cta-button {
  box-shadow:
    0 14px 32px rgba(7,94,234,.22),
    inset 0 1px 0 rgba(255,255,255,.22);
}

@media (max-width: 980px) {
  .usefect-guide-hero {
    min-height: auto;
  }

  .guide-hero-card {
    transform: none;
  }
}

@media (max-width: 700px) {
  .usefect-guide-hero h1 {
    letter-spacing: -3px;
  }

  .guide-hero-card {
    min-height: 0;
    padding: 23px;
  }

  .guide-start-section {
    padding-top: 75px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .guide-card,
  .flow-card,
  .account-card {
    transition: none;
  }

  .guide-hero-card,
  .qr-icon-shell {
    transform: none;
  }
}

/* =========================================================
   ADMIN BOOK — CATEGORY CREATOR
   ========================================================= */

.admin-book-create-category-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  margin-top: 10px;
  padding: 0;
  border: 0;
  background: transparent;
  color: #075eea;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.admin-book-create-category-button:hover {
  text-decoration: underline;
}

.admin-book-category-creator {
  margin-top: 13px;
  padding: 17px;
  border: 1px solid rgba(7,94,234,.13);
  border-radius: 14px;
  background: linear-gradient(
    145deg,
    #f8fbff,
    #ffffff
  );
  box-shadow: 0 10px 24px rgba(15,39,91,.055);
}

.admin-book-category-creator-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 13px;
}

.admin-book-category-creator-header > div {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.admin-book-category-creator-header strong {
  color: #10233f;
  font-size: 13px;
}

.admin-book-category-creator-header small {
  color: #7a8798;
  font-size: 11px;
  line-height: 1.5;
}

.admin-book-category-creator-header > button {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  flex: 0 0 28px;
  padding: 0;
  border: 1px solid #e4eaf1;
  border-radius: 8px;
  background: #fff;
  color: #718096;
  cursor: pointer;
}

.admin-book-category-creator input,
.admin-book-category-creator textarea {
  width: 100%;
  box-sizing: border-box;
  margin-top: 8px;
  padding: 10px 12px;
  border: 1px solid #dfe6ef;
  border-radius: 10px;
  outline: none;
  background: #fff;
  color: #172033;
  font-family: inherit;
  font-size: 12px;
  transition:
    border-color .2s ease,
    box-shadow .2s ease;
}

.admin-book-category-creator input:focus,
.admin-book-category-creator textarea:focus {
  border-color: rgba(7,94,234,.45);
  box-shadow: 0 0 0 3px rgba(7,94,234,.08);
}

.admin-book-category-creator textarea {
  resize: vertical;
  min-height: 72px;
}

.admin-book-category-error {
  display: block;
  margin-top: 9px;
  color: #c0392b;
  font-size: 11px;
  line-height: 1.5;
}

.admin-book-save-category-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  margin-top: 11px;
  padding: 10px 14px;
  border: 0;
  border-radius: 10px;
  color: #fff;
  background: linear-gradient(
    135deg,
    #075eea,
    #0b8ff5
  );
  box-shadow: 0 8px 18px rgba(7,94,234,.18);
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
}

.admin-book-save-category-button:disabled {
  opacity: .65;
  cursor: not-allowed;
}


/* =========================================================
   USEFECT ADMIN — CATEGORY MANAGEMENT
   ========================================================= */

.category-admin-page {
  min-height: calc(100vh - 76px);
  background:
    radial-gradient(
      circle at 85% 10%,
      rgba(7, 94, 234, 0.055),
      transparent 28%
    ),
    #f7f9fc;
  color: #0b1b3f;
}

.category-admin-hero {
  position: relative;
  overflow: hidden;
  padding: 34px 7.5% 42px;
  background:
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f8fbff 55%,
      #eef5ff 100%
    );
  border-bottom: 1px solid rgba(220, 228, 240, 0.9);
}

.category-admin-hero::after {
  content: "";
  position: absolute;
  width: 420px;
  height: 420px;
  right: -180px;
  top: -230px;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(7, 94, 234, 0.1),
      transparent 68%
    );
  pointer-events: none;
}

.category-admin-hero-glow {
  position: absolute;
  width: 260px;
  height: 260px;
  right: 18%;
  bottom: -230px;
  border-radius: 50%;
  background: rgba(57, 213, 255, 0.06);
  filter: blur(10px);
}

.category-admin-hero-content {
  position: relative;
  z-index: 1;
  max-width: 1380px;
  margin: 0 auto;
}

.category-admin-breadcrumb {
  display: flex;
  align-items: center;
  gap: 7px;
  margin-bottom: 28px;
  color: #8a98ad;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 2px;
}

.category-admin-breadcrumb svg {
  color: #b2bdcc;
}

.category-admin-breadcrumb strong {
  color: #075eea;
}

.category-admin-title-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 40px;
}

.category-admin-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 11px;
  color: #075eea;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2.6px;
}

.category-admin-eyebrow svg {
  filter: drop-shadow(
    0 3px 7px rgba(7, 94, 234, 0.18)
  );
}

.category-admin-title-row h1 {
  margin: 0;
  color: #06184d;
  font-size: clamp(40px, 4.4vw, 58px);
  line-height: 0.98;
  letter-spacing: -2.8px;
  font-weight: 900;
  text-shadow:
    0 1px 0 #fff,
    0 4px 14px rgba(15, 39, 91, 0.08);
}

.category-admin-title-row h1 em {
  display: inline;
  margin-left: 10px;
  color: #075eea;
  font-style: normal;
}

.category-admin-title-row p {
  max-width: 650px;
  margin: 16px 0 0;
  color: #61718c;
  font-size: 15px;
  line-height: 1.65;
}

.category-admin-primary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  flex: 0 0 auto;
  min-height: 48px;
  padding: 0 19px;
  border: 1px solid #075eea;
  border-radius: 13px;
  background: linear-gradient(
    135deg,
    #075eea,
    #054bbd
  );
  color: #fff;
  font-size: 13px;
  font-weight: 800;
  box-shadow:
    0 10px 24px rgba(7, 94, 234, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.22);
  cursor: pointer;
  transition:
    transform 0.18s ease,
    box-shadow 0.18s ease;
}

.category-admin-primary-button:hover {
  transform: translateY(-2px);
  box-shadow:
    0 14px 30px rgba(7, 94, 234, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.22);
}

.category-admin-content {
  position: relative;
  max-width: 1380px;
  margin: 0 auto;
  padding: 28px 7.5% 70px;
}

.category-admin-alert {
  display: flex;
  align-items: center;
  gap: 10px;
  min-height: 46px;
  margin-bottom: 16px;
  padding: 10px 13px;
  border-radius: 12px;
  font-size: 12px;
  font-weight: 650;
}

.category-admin-alert button {
  display: grid;
  place-items: center;
  margin-left: auto;
  padding: 4px;
  border: 0;
  background: transparent;
  color: inherit;
  cursor: pointer;
}

.category-admin-alert.success {
  border: 1px solid rgba(24, 164, 104, 0.16);
  background: rgba(236, 252, 245, 0.9);
  color: #137c51;
}

.category-admin-alert.error {
  border: 1px solid rgba(220, 65, 65, 0.16);
  background: rgba(255, 244, 244, 0.95);
  color: #b52c2c;
}

.category-admin-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin-bottom: 18px;
}

.category-admin-stat-card {
  display: flex;
  align-items: center;
  gap: 13px;
  min-height: 88px;
  padding: 16px 18px;
  border: 1px solid rgba(222, 229, 239, 0.95);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.9);
  box-shadow:
    0 8px 25px rgba(20, 44, 88, 0.045),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.category-admin-stat-icon {
  display: grid;
  place-items: center;
  width: 44px;
  height: 44px;
  flex: 0 0 44px;
  border-radius: 13px;
}

.category-admin-stat-icon.blue {
  color: #075eea;
  background: #edf4ff;
}

.category-admin-stat-icon.gold {
  color: #b47b00;
  background: #fff7df;
}

.category-admin-stat-icon.cyan {
  color: #008ca8;
  background: #eafcff;
}

.category-admin-stat-card span {
  display: block;
  margin-bottom: 4px;
  color: #8794a8;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.7px;
  text-transform: uppercase;
}

.category-admin-stat-card strong {
  display: block;
  color: #102653;
  font-size: 21px;
  line-height: 1;
  font-weight: 900;
}

.category-admin-panel {
  overflow: hidden;
  border: 1px solid rgba(220, 228, 239, 0.95);
  border-radius: 20px;
  background: #fff;
  box-shadow:
    0 15px 45px rgba(19, 42, 81, 0.055),
    0 2px 5px rgba(19, 42, 81, 0.025);
}

.category-admin-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 23px 24px 19px;
  border-bottom: 1px solid #edf1f6;
}

.category-admin-section-label {
  margin-bottom: 5px;
  color: #075eea;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 2px;
}

.category-admin-panel-header h2 {
  margin: 0;
  color: #102653;
  font-size: 20px;
  font-weight: 850;
  letter-spacing: -0.5px;
}

.category-admin-panel-header p {
  margin: 5px 0 0;
  color: #8794a8;
  font-size: 12px;
}

.category-admin-refresh {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 35px;
  padding: 0 11px;
  border: 1px solid #e1e7ef;
  border-radius: 9px;
  background: #fff;
  color: #53647e;
  font-size: 11px;
  font-weight: 750;
  cursor: pointer;
}

.category-admin-refresh:hover {
  border-color: #cdd9ea;
  color: #075eea;
  background: #f8fbff;
}

.category-admin-refresh:disabled {
  opacity: 0.55;
  cursor: default;
}

.category-admin-refresh .spin {
  animation: categoryAdminSpin 0.9s linear infinite;
}

@keyframes categoryAdminSpin {
  to {
    transform: rotate(360deg);
  }
}

.category-admin-toolbar {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 24px;
  background: #fbfcfe;
  border-bottom: 1px solid #edf1f6;
}

.category-admin-search {
  display: flex;
  align-items: center;
  gap: 9px;
  width: min(500px, 100%);
  min-height: 42px;
  padding: 0 12px;
  border: 1px solid #dfe6ef;
  border-radius: 11px;
  background: #fff;
  color: #91a0b5;
  transition:
    border-color 0.18s ease,
    box-shadow 0.18s ease;
}

.category-admin-search:focus-within {
  border-color: rgba(7, 94, 234, 0.45);
  box-shadow: 0 0 0 4px rgba(7, 94, 234, 0.07);
}

.category-admin-search input {
  width: 100%;
  min-width: 0;
  border: 0;
  outline: 0;
  background: transparent;
  color: #24385e;
  font: inherit;
  font-size: 12px;
}

.category-admin-search input::placeholder {
  color: #a5b0c0;
}

.category-admin-search button {
  display: grid;
  place-items: center;
  padding: 3px;
  border: 0;
  background: transparent;
  color: #8b98aa;
  cursor: pointer;
}

.category-admin-result-count {
  margin-left: auto;
  color: #8b98aa;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.category-admin-list-head,
.category-admin-item {
  display: grid;
  grid-template-columns:
    minmax(270px, 1.3fr)
    minmax(240px, 1.6fr)
    150px
    170px;
  align-items: center;
}

.category-admin-list-head {
  min-height: 40px;
  padding: 0 24px;
  background: #f8fafc;
  border-bottom: 1px solid #edf1f6;
  color: #96a1b1;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 1.4px;
}

.category-admin-list-head span:last-child {
  text-align: right;
}

.category-admin-item {
  min-height: 92px;
  padding: 13px 24px;
  border-bottom: 1px solid #edf1f6;
  transition:
    background 0.16s ease,
    transform 0.16s ease;
}

.category-admin-item:last-child {
  border-bottom: 0;
}

.category-admin-item:hover {
  background: #fbfdff;
}

.category-admin-name-cell {
  display: flex;
  align-items: center;
  gap: 11px;
  min-width: 0;
}

.category-admin-index {
  width: 25px;
  flex: 0 0 25px;
  color: #b0bac8;
  font-size: 9px;
  font-weight: 850;
}

.category-admin-folder {
  display: grid;
  place-items: center;
  width: 39px;
  height: 39px;
  flex: 0 0 39px;
  border: 1px solid #dce8fa;
  border-radius: 11px;
  background: #f1f6ff;
  color: #075eea;
}

.category-admin-name {
  min-width: 0;
}

.category-admin-name strong {
  display: block;
  overflow: hidden;
  color: #162b53;
  font-size: 13px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.category-admin-name span {
  display: block;
  margin-top: 4px;
  color: #9aa6b7;
  font-size: 10px;
}

.category-admin-description {
  min-width: 0;
  padding-right: 20px;
}

.category-admin-description span {
  display: -webkit-box;
  overflow: hidden;
  color: #61718a;
  font-size: 12px;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.category-admin-description .muted {
  color: #a7b1bf;
  font-style: italic;
}

.category-admin-date {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #78869b;
  font-size: 11px;
}

.category-admin-date svg {
  color: #9aa8bb;
}

.category-admin-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 7px;
}

.category-admin-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  min-height: 33px;
  padding: 0 10px;
  border-radius: 8px;
  font-size: 10px;
  font-weight: 800;
  cursor: pointer;
  transition: all 0.16s ease;
}

.category-admin-action.edit {
  border: 1px solid #dbe6f7;
  background: #f5f9ff;
  color: #075eea;
}

.category-admin-action.edit:hover {
  border-color: #bdd3f4;
  background: #eaf2ff;
}

.category-admin-action.delete {
  border: 1px solid #f1dcdc;
  background: #fff8f8;
  color: #c34b4b;
}

.category-admin-action.delete:hover {
  border-color: #e9bcbc;
  background: #fff0f0;
}

.category-admin-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 300px;
  gap: 12px;
  color: #8997ab;
  font-size: 12px;
}

.category-admin-spinner {
  width: 26px;
  height: 26px;
  border: 2px solid #dce6f5;
  border-top-color: #075eea;
  border-radius: 50%;
  animation: categoryAdminSpin 0.75s linear infinite;
}

.category-admin-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 330px;
  padding: 40px;
  text-align: center;
}

.category-admin-empty-icon {
  display: grid;
  place-items: center;
  width: 64px;
  height: 64px;
  margin-bottom: 15px;
  border-radius: 18px;
  background: #eef5ff;
  color: #075eea;
}

.category-admin-empty h3 {
  margin: 0;
  color: #162b53;
  font-size: 17px;
  font-weight: 850;
}

.category-admin-empty p {
  max-width: 430px;
  margin: 7px 0 18px;
  color: #8997ab;
  font-size: 12px;
  line-height: 1.55;
}

.category-admin-empty-button {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  min-height: 38px;
  padding: 0 14px;
  border: 1px solid #d9e5f7;
  border-radius: 10px;
  background: #f5f9ff;
  color: #075eea;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
}

/* ---------- MODALS ---------- */

.category-admin-modal-backdrop {
  position: fixed;
  z-index: 1000;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 22px;
  background: rgba(6, 20, 48, 0.46);
  backdrop-filter: blur(7px);
}

.category-admin-modal {
  width: min(520px, 100%);
  overflow: hidden;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 22px;
  background: #fff;
  box-shadow:
    0 30px 80px rgba(4, 23, 59, 0.24),
    0 8px 25px rgba(4, 23, 59, 0.12);
  animation: categoryModalIn 0.18s ease-out;
}

@keyframes categoryModalIn {
  from {
    opacity: 0;
    transform: translateY(10px) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.category-admin-modal-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 21px 22px 0;
}

.category-admin-modal-icon {
  display: grid;
  place-items: center;
  width: 43px;
  height: 43px;
  border-radius: 13px;
  background: #edf4ff;
  color: #075eea;
}

.category-admin-modal-close {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 9px;
  background: #f6f8fb;
  color: #7d8b9f;
  cursor: pointer;
}

.category-admin-modal-close:hover {
  background: #edf1f6;
  color: #233a61;
}

.category-admin-modal-heading {
  padding: 17px 22px 20px;
}

.category-admin-modal-heading > span,
.category-admin-modal-kicker {
  color: #075eea;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: 2px;
}

.category-admin-modal-heading h2 {
  margin: 6px 0 5px;
  color: #112650;
  font-size: 23px;
  letter-spacing: -0.7px;
  font-weight: 900;
}

.category-admin-modal-heading p {
  margin: 0;
  color: #8997ab;
  font-size: 12px;
  line-height: 1.5;
}

.category-admin-form {
  padding: 0 22px 22px;
}

.category-admin-form label {
  position: relative;
  display: block;
  margin-bottom: 17px;
}

.category-admin-form label > span {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 7px;
  color: #33486c;
  font-size: 11px;
  font-weight: 800;
}

.category-admin-form label > span b {
  color: #e25454;
}

.category-admin-form label > span i {
  color: #a0abb9;
  font-size: 9px;
  font-style: normal;
  font-weight: 650;
}

.category-admin-form input,
.category-admin-form textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #dce4ee;
  border-radius: 11px;
  outline: 0;
  background: #fbfcfe;
  color: #20365d;
  font-family: inherit;
  font-size: 12px;
  transition:
    border-color 0.16s ease,
    box-shadow 0.16s ease,
    background 0.16s ease;
}

.category-admin-form input {
  height: 44px;
  padding: 0 12px;
}

.category-admin-form textarea {
  min-height: 105px;
  padding: 11px 12px;
  line-height: 1.5;
  resize: vertical;
}

.category-admin-form input:focus,
.category-admin-form textarea:focus {
  border-color: rgba(7, 94, 234, 0.5);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(7, 94, 234, 0.07);
}

.category-admin-form input::placeholder,
.category-admin-form textarea::placeholder {
  color: #aab4c2;
}

.category-admin-form label > small {
  position: absolute;
  right: 2px;
  bottom: -14px;
  color: #a2adbc;
  font-size: 9px;
}

.category-admin-form-error {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: -3px 0 15px;
  padding: 9px 10px;
  border: 1px solid #f0d7d7;
  border-radius: 9px;
  background: #fff6f6;
  color: #b43a3a;
  font-size: 10px;
  font-weight: 700;
}

.category-admin-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  padding-top: 4px;
}

.category-admin-cancel-button,
.category-admin-save-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-height: 40px;
  padding: 0 14px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
}

.category-admin-cancel-button {
  border: 1px solid #dfe6ef;
  background: #fff;
  color: #68788f;
}

.category-admin-cancel-button:hover {
  background: #f8fafc;
}

.category-admin-save-button {
  border: 1px solid #075eea;
  background: linear-gradient(
    135deg,
    #075eea,
    #054bbd
  );
  color: #fff;
  box-shadow: 0 7px 17px rgba(7, 94, 234, 0.18);
}

.category-admin-save-button:hover {
  box-shadow: 0 10px 22px rgba(7, 94, 234, 0.23);
}

.category-admin-save-button:disabled,
.category-admin-cancel-button:disabled {
  opacity: 0.55;
  cursor: default;
}

.button-spinner {
  width: 13px;
  height: 13px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #fff;
  border-radius: 50%;
  animation: categoryAdminSpin 0.7s linear infinite;
}

/* ---------- DELETE MODAL ---------- */

.category-admin-delete-modal {
  width: min(430px, 100%);
  padding: 27px;
  border: 1px solid rgba(255, 255, 255, 0.75);
  border-radius: 21px;
  background: #fff;
  box-shadow: 0 30px 80px rgba(4, 23, 59, 0.24);
  text-align: center;
  animation: categoryModalIn 0.18s ease-out;
}

.category-admin-delete-icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  margin: 0 auto 14px;
  border-radius: 15px;
  background: #fff1f1;
  color: #c34b4b;
}

.category-admin-delete-modal h2 {
  margin: 7px 0 8px;
  color: #142952;
  font-size: 21px;
  font-weight: 900;
  letter-spacing: -0.5px;
}

.category-admin-delete-modal > p {
  margin: 0 auto;
  max-width: 350px;
  color: #78869b;
  font-size: 12px;
  line-height: 1.65;
}

.category-admin-delete-modal > p strong {
  color: #35496d;
}

.category-admin-delete-actions {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 22px;
}

.category-admin-delete-actions button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  min-width: 105px;
  min-height: 39px;
  padding: 0 13px;
  border: 1px solid #dfe6ef;
  border-radius: 10px;
  background: #fff;
  color: #68788f;
  font-size: 11px;
  font-weight: 800;
  cursor: pointer;
}

.category-admin-delete-actions button.danger {
  border-color: #c94e4e;
  background: #c94e4e;
  color: #fff;
  box-shadow: 0 7px 17px rgba(201, 78, 78, 0.16);
}

.category-admin-delete-actions button:disabled {
  opacity: 0.55;
  cursor: default;
}

/* ---------- RESPONSIVE ---------- */

@media (max-width: 1050px) {
  .category-admin-list-head,
  .category-admin-item {
    grid-template-columns:
      minmax(230px, 1.25fr)
      minmax(200px, 1.4fr)
      125px
      155px;
  }

  .category-admin-title-row {
    align-items: flex-start;
  }
}

@media (max-width: 850px) {
  .category-admin-hero,
  .category-admin-content {
    padding-left: 5%;
    padding-right: 5%;
  }

  .category-admin-title-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .category-admin-primary-button {
    width: 100%;
  }

  .category-admin-stats {
    grid-template-columns: 1fr;
  }

  .category-admin-list-head {
    display: none;
  }

  .category-admin-item {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 15px;
    padding: 18px;
  }

  .category-admin-description {
    grid-column: 1 / -1;
    padding: 0;
  }

  .category-admin-date {
    grid-column: 1;
  }

  .category-admin-actions {
    grid-column: 2;
    grid-row: 3;
  }
}

@media (max-width: 600px) {
  .category-admin-hero {
    padding-top: 24px;
    padding-bottom: 30px;
  }

  .category-admin-breadcrumb {
    margin-bottom: 20px;
  }

  .category-admin-title-row h1 {
    font-size: 40px;
    letter-spacing: -2px;
  }

  .category-admin-title-row h1 em {
    display: block;
    margin-left: 0;
    margin-top: 3px;
  }

  .category-admin-content {
    padding-top: 18px;
    padding-bottom: 45px;
  }

  .category-admin-panel-header,
  .category-admin-toolbar {
    padding-left: 16px;
    padding-right: 16px;
  }

  .category-admin-panel-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .category-admin-refresh {
    width: 100%;
    justify-content: center;
  }

  .category-admin-toolbar {
    align-items: stretch;
    flex-direction: column;
  }

  .category-admin-search {
    width: 100%;
  }

  .category-admin-result-count {
    margin-left: 0;
  }

  .category-admin-item {
    grid-template-columns: 1fr;
  }

  .category-admin-date,
  .category-admin-actions {
    grid-column: 1;
    grid-row: auto;
  }

  .category-admin-actions {
    justify-content: flex-start;
  }

  .category-admin-action {
    flex: 1;
  }

  .category-admin-modal-backdrop {
    padding: 14px;
  }

  .category-admin-modal,
  .category-admin-delete-modal {
    border-radius: 18px;
  }
}

/* =========================================================
   USEFECT ADMIN — LIBRARY SETTINGS
   ========================================================= */

.settings-admin-page {
  min-height: calc(100vh - 72px);
  background:
    radial-gradient(
      circle at 88% 8%,
      rgba(7, 94, 234, 0.07),
      transparent 30%
    ),
    #f7f9fc;
  color: #06184d;
}

.settings-admin-hero {
  position: relative;
  overflow: hidden;
  padding: 58px 8% 62px;
  background:
    radial-gradient(
      circle at 82% 35%,
      rgba(57, 213, 255, 0.09),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #ffffff 0%,
      #f7faff 58%,
      #eef5ff 100%
    );
  border-bottom: 1px solid rgba(225, 231, 240, 0.9);
  perspective: 1200px;
}

.settings-admin-hero::after {
  content: "";
  position: absolute;
  width: 460px;
  height: 460px;
  right: -180px;
  top: -220px;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(7, 94, 234, 0.08),
      transparent 68%
    );
  pointer-events: none;
}

.settings-admin-hero-content {
  position: relative;
  z-index: 1;
  max-width: 820px;
  transform: translateZ(12px);
}

.settings-admin-eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #64748b;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 2.8px;
  text-transform: uppercase;
}

.settings-admin-eyebrow svg {
  color: #075eea;
  filter:
    drop-shadow(
      0 2px 5px rgba(7, 94, 234, 0.18)
    );
}

.settings-admin-hero h1 {
  margin: 13px 0 14px;
  max-width: 700px;
  color: #06184d;
  font-size: clamp(42px, 5vw, 62px);
  line-height: 0.98;
  letter-spacing: -2.8px;
  font-weight: 900;
  text-shadow:
    0 2px 0 rgba(255, 255, 255, 0.95),
    0 6px 16px rgba(15, 39, 91, 0.08);
}

.settings-admin-hero h1 em {
  display: block;
  color: #075eea;
  font-style: normal;
}

.settings-admin-hero p {
  max-width: 610px;
  margin: 0;
  color: #405782;
  font-size: 15px;
  line-height: 1.6;
  font-weight: 500;
}

.settings-admin-content {
  width: min(1180px, 84%);
  margin: 0 auto;
  padding: 42px 0 72px;
}

.settings-admin-alert {
  margin-bottom: 22px;
  padding: 14px 17px;
  border-radius: 14px;
  font-size: 13px;
  font-weight: 700;
}

.settings-admin-alert.error {
  color: #a72c36;
  background: #fff1f2;
  border: 1px solid #ffd4d8;
}

.settings-admin-alert.success {
  color: #17653a;
  background: #effcf4;
  border: 1px solid #ccefd9;
}

.settings-admin-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28px;
  margin-bottom: 26px;
}

.settings-admin-section-label {
  color: #075eea;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: 2.5px;
}

.settings-admin-toolbar h2 {
  margin: 7px 0 5px;
  color: #06184d;
  font-size: 25px;
  line-height: 1.1;
  letter-spacing: -0.8px;
  font-weight: 850;
}

.settings-admin-toolbar p {
  margin: 0;
  color: #71809a;
  font-size: 13px;
  line-height: 1.5;
}

.settings-admin-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.settings-admin-reset,
.settings-admin-save {
  min-height: 42px;
  padding: 0 16px;
  border-radius: 12px;
  border: 1px solid #dce3ee;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  font-size: 12px;
  font-weight: 800;
  cursor: pointer;
  transition:
    transform 0.2s ease,
    box-shadow 0.2s ease,
    border-color 0.2s ease;
}

.settings-admin-reset {
  color: #405782;
  background: #ffffff;
}

.settings-admin-save {
  color: #ffffff;
  background: linear-gradient(
    135deg,
    #075eea,
    #0a79f5
  );
  border-color: #075eea;
  box-shadow:
    0 8px 20px rgba(7, 94, 234, 0.18);
}

.settings-admin-reset:hover,
.settings-admin-save:hover {
  transform: translateY(-1px);
}

.settings-admin-reset:hover {
  border-color: #c7d2e2;
}

.settings-admin-save:hover {
  box-shadow:
    0 11px 25px rgba(7, 94, 234, 0.24);
}

.settings-admin-reset:disabled,
.settings-admin-save:disabled {
  opacity: 0.55;
  cursor: not-allowed;
  transform: none;
}

.settings-admin-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.settings-admin-card {
  padding: 21px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.98),
      rgba(249, 251, 255, 0.98)
    );
  border: 1px solid #e2e8f1;
  border-radius: 18px;
  box-shadow:
    0 10px 28px rgba(15, 39, 91, 0.055);
}

.settings-admin-card-top {
  display: flex;
  align-items: flex-start;
  gap: 13px;
}

.settings-admin-card-icon {
  width: 40px;
  height: 40px;
  flex: 0 0 40px;
  display: grid;
  place-items: center;
  color: #075eea;
  background:
    linear-gradient(
      145deg,
      #edf5ff,
      #f6fbff
    );
  border: 1px solid #dbeaff;
  border-radius: 12px;
  box-shadow:
    0 6px 14px rgba(7, 94, 234, 0.08);
}

.settings-admin-card h3 {
  margin: 1px 0 5px;
  color: #122451;
  font-size: 15px;
  font-weight: 850;
}

.settings-admin-card p {
  max-width: 430px;
  margin: 0;
  color: #75839a;
  font-size: 12px;
  line-height: 1.5;
}

.settings-admin-field {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 19px;
}

.settings-admin-field input {
  width: 150px;
  height: 43px;
  padding: 0 13px;
  color: #06184d;
  background: #ffffff;
  border: 1px solid #dce4ef;
  border-radius: 11px;
  outline: none;
  font-size: 15px;
  font-weight: 800;
  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.settings-admin-field input:focus {
  border-color: #075eea;
  box-shadow:
    0 0 0 3px rgba(7, 94, 234, 0.09);
}

.settings-admin-field span {
  color: #6d7c94;
  font-size: 12px;
  font-weight: 750;
}

.settings-admin-loading {
  min-height: 240px;
  display: grid;
  place-items: center;
  color: #71809a;
  background: #ffffff;
  border: 1px solid #e2e8f1;
  border-radius: 18px;
  font-size: 13px;
}

.settings-admin-note {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-top: 20px;
  padding: 17px 18px;
  background: rgba(235, 244, 255, 0.72);
  border: 1px solid #d8e8ff;
  border-radius: 15px;
}

.settings-admin-note-icon {
  width: 34px;
  height: 34px;
  flex: 0 0 34px;
  display: grid;
  place-items: center;
  color: #075eea;
  background: #ffffff;
  border: 1px solid #dceaff;
  border-radius: 10px;
}

.settings-admin-note strong {
  display: block;
  margin: 1px 0 4px;
  color: #17336c;
  font-size: 12px;
  font-weight: 850;
}

.settings-admin-note p {
  margin: 0;
  color: #64789d;
  font-size: 12px;
  line-height: 1.5;
}

@media (max-width: 800px) {
  .settings-admin-hero {
    padding: 46px 6% 50px;
  }

  .settings-admin-content {
    width: 88%;
    padding-top: 32px;
  }

  .settings-admin-toolbar {
    align-items: flex-start;
    flex-direction: column;
  }

  .settings-admin-actions {
    width: 100%;
  }

  .settings-admin-reset,
  .settings-admin-save {
    flex: 1;
  }

  .settings-admin-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 520px) {
  .settings-admin-hero h1 {
    font-size: 43px;
  }

  .settings-admin-actions {
    flex-direction: column;
  }

  .settings-admin-reset,
  .settings-admin-save {
    width: 100%;
  }

  .settings-admin-card {
    padding: 18px;
  }
}


/* ===== TAMBAH BUKU — JUMLAH EKSEMPLAR ===== */
.quantity-control {
  display: flex;
  align-items: center;
  width: 180px;
  height: 46px;
  border: 1px solid #dce3ee;
  border-radius: 12px;
  background: #fff;
  overflow: hidden;
}

.quantity-button {
  width: 46px;
  height: 100%;
  border: 0;
  background: #f5f8fc;
  color: #1769d2;
  font-size: 22px;
  font-weight: 600;
  cursor: pointer;
  transition: background .2s ease, color .2s ease;
}

.quantity-button:hover {
  background: #eaf2ff;
  color: #0d56b3;
}

.quantity-input {
  flex: 1;
  min-width: 0;
  height: 100%;
  border: 0;
  outline: 0;
  background: #fff;
  color: #172033;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
}

.form-hint {
  margin: 7px 0 0;
  color: #7b8798;
  font-size: 12px;
  line-height: 1.5;
}

/* ===== TAMBAH BUKU — JUMLAH EKSEMPLAR ===== */
.admin-book-quantity-control {
  display: flex;
  align-items: center;
  width: 180px;
  height: 46px;
  border: 1px solid #dce3ee;
  border-radius: 12px;
  background: #ffffff;
  overflow: hidden;
}

.admin-book-quantity-control input {
  flex: 1;
  min-width: 0;
  width: 70px;
  height: 100%;
  border: 0;
  outline: 0;
  background: #ffffff;
  color: #172033;
  text-align: center;
  font-size: 16px;
  font-weight: 600;
  appearance: textfield;
}

.admin-book-quantity-control input::-webkit-inner-spin-button,
.admin-book-quantity-control input::-webkit-outer-spin-button {
  appearance: none;
  margin: 0;
}

.admin-book-quantity-button {
  width: 46px;
  height: 100%;
  border: 0;
  background: #f5f8fc;
  color: #1769d2;
  font-size: 22px;
  font-weight: 600;
  cursor: pointer;
  transition: background 0.2s ease;
}

.admin-book-quantity-button:hover {
  background: #eaf2ff;
}

.admin-book-form-hint {
  display: block;
  margin-top: 7px;
  color: #7b8798;
  font-size: 12px;
  line-height: 1.5;
}

/* =========================================================
   USEFECT ADMIN WORKSPACE
   ========================================================= */

.admin-workspace {
  min-height: calc(100vh - 76px);
  padding: 42px 5vw 70px;
  background:
    radial-gradient(circle at 85% 5%, rgba(37, 99, 235, 0.08), transparent 28%),
    linear-gradient(180deg, #f8fbff 0%, #ffffff 55%, #f7faff 100%);
}

.admin-workspace-hero {
  max-width: 1240px;
  margin: 0 auto 34px;
  padding: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
  border: 1px solid rgba(30, 64, 175, 0.09);
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 20px 55px rgba(30, 64, 175, 0.08);
  backdrop-filter: blur(18px);
}

.admin-workspace-eyebrow {
  margin-bottom: 10px;
  color: #2563eb;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.admin-workspace-hero h1 {
  margin: 0;
  color: #10213f;
  font-size: clamp(32px, 4vw, 48px);
  line-height: 1.05;
  letter-spacing: -0.04em;
}

.admin-workspace-hero h1 span {
  display: block;
  color: #2563eb;
}

.admin-workspace-hero p {
  max-width: 650px;
  margin: 16px 0 0;
  color: #68768c;
  font-size: 15px;
  line-height: 1.7;
}

.admin-workspace-shield {
  width: 86px;
  height: 86px;
  flex: 0 0 86px;
  display: grid;
  place-items: center;
  color: #2563eb;
  border: 1px solid rgba(37, 99, 235, 0.14);
  border-radius: 24px;
  background: linear-gradient(145deg, #ffffff, #edf4ff);
  box-shadow:
    0 18px 35px rgba(37, 99, 235, 0.12),
    inset 0 1px 0 rgba(255, 255, 255, 0.9);
}

.admin-workspace-grid {
  max-width: 1240px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18px;
}

.admin-workspace-card {
  position: relative;
  min-height: 150px;
  padding: 24px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 22px;
  overflow: hidden;
  text-decoration: none;
  border: 1px solid rgba(30, 64, 175, 0.08);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 0 12px 32px rgba(30, 64, 175, 0.06);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.admin-workspace-card:hover {
  transform: translateY(-3px);
  border-color: rgba(37, 99, 235, 0.2);
  box-shadow: 0 20px 42px rgba(30, 64, 175, 0.11);
}

.admin-workspace-card-icon {
  width: 46px;
  height: 46px;
  display: grid;
  place-items: center;
  color: #2563eb;
  border-radius: 14px;
  background: #edf4ff;
}

.admin-workspace-card h2 {
  margin: 0;
  color: #172b4d;
  font-size: 17px;
  font-weight: 750;
}

.admin-workspace-card p {
  margin: 6px 0 0;
  color: #7a8799;
  font-size: 13px;
  line-height: 1.5;
}

.admin-workspace-card-arrow {
  position: absolute;
  right: 22px;
  bottom: 20px;
  color: #9aa8bb;
  font-size: 20px;
  transition: transform 180ms ease;
}

.admin-workspace-card:hover .admin-workspace-card-arrow {
  transform: translateX(4px);
  color: #2563eb;
}

@media (max-width: 900px) {
  .admin-workspace-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .admin-workspace {
    padding: 26px 18px 50px;
  }

  .admin-workspace-hero {
    padding: 26px;
  }

  .admin-workspace-shield {
    display: none;
  }

  .admin-workspace-grid {
    grid-template-columns: 1fr;
  }
}

/* =========================================================
   USEFECT ADMIN SIDEBAR
   ========================================================= */

.admin-dashboard-shell {
  display: flex;
  min-height: calc(100vh - 76px);
  background: #f7faff;
}

.admin-sidebar {
  width: 258px;
  flex: 0 0 258px;
  min-height: calc(100vh - 76px);
  padding: 24px 14px;
  display: flex;
  flex-direction: column;
  border-right: 1px solid rgba(30, 64, 175, 0.08);
  background: rgba(255, 255, 255, 0.92);
}

.admin-sidebar-heading {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 4px 10px 22px;
  border-bottom: 1px solid rgba(30, 64, 175, 0.07);
}

.admin-sidebar-heading-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  flex: 0 0 36px;
  color: #2563eb;
  border-radius: 11px;
  background: #edf4ff;
}

.admin-sidebar-heading strong,
.admin-sidebar-heading span {
  display: block;
}

.admin-sidebar-heading strong {
  color: #172b4d;
  font-size: 11px;
  letter-spacing: 0.08em;
}

.admin-sidebar-heading span {
  margin-top: 3px;
  color: #8a98aa;
  font-size: 10px;
  letter-spacing: 0.12em;
}

.admin-sidebar-nav {
  flex: 1;
  padding-top: 18px;
}

.admin-sidebar-section {
  margin-bottom: 22px;
}

.admin-sidebar-section-label {
  padding: 0 11px 8px;
  color: #9aa7b8;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.16em;
}

.admin-sidebar-link {
  min-height: 42px;
  margin-bottom: 3px;
  padding: 0 11px;
  display: flex;
  align-items: center;
  gap: 11px;
  color: #6d7b8e;
  border-radius: 12px;
  text-decoration: none;
  font-size: 13px;
  font-weight: 600;
  transition:
    background 160ms ease,
    color 160ms ease,
    transform 160ms ease;
}

.admin-sidebar-link:hover {
  color: #2563eb;
  background: #f1f6ff;
}

.admin-sidebar-link.active {
  color: #2563eb;
  background: linear-gradient(90deg, #edf4ff, #f7faff);
  box-shadow: inset 3px 0 0 #2563eb;
}

.admin-sidebar-link-arrow {
  margin-left: auto;
  opacity: 0;
  transform: translateX(-3px);
  transition: 160ms ease;
}

.admin-sidebar-link:hover .admin-sidebar-link-arrow,
.admin-sidebar-link.active .admin-sidebar-link-arrow {
  opacity: 1;
  transform: translateX(0);
}

.admin-sidebar-user {
  margin-top: auto;
  padding: 14px 10px 4px;
  display: flex;
  align-items: center;
  gap: 10px;
  border-top: 1px solid rgba(30, 64, 175, 0.07);
}

.admin-sidebar-avatar {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  flex: 0 0 36px;
  color: white;
  border-radius: 11px;
  background: linear-gradient(145deg, #2563eb, #1645a3);
  font-size: 13px;
  font-weight: 800;
}

.admin-sidebar-user-info {
  min-width: 0;
}

.admin-sidebar-user-info strong,
.admin-sidebar-user-info span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-sidebar-user-info strong {
  color: #263750;
  font-size: 12px;
}

.admin-sidebar-user-info span {
  margin-top: 3px;
  color: #8795a8;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.admin-dashboard-main {
  min-width: 0;
  flex: 1;
  padding: 34px 34px 70px;
}

.admin-workspace-overview {
  max-width: 1240px;
  margin: 0 auto;
}

.admin-workspace-overview-title {
  margin: 0 0 15px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #52647d;
  font-size: 13px;
  font-weight: 750;
}

.admin-workspace-overview-title svg {
  color: #2563eb;
}

.admin-workspace-main-grid {
  display: grid;
}

@media (max-width: 1050px) {
  .admin-sidebar {
    width: 220px;
    flex-basis: 220px;
  }

  .admin-dashboard-main {
    padding: 28px 22px 60px;
  }
}

@media (max-width: 800px) {
  .admin-dashboard-shell {
    display: block;
  }

  .admin-sidebar {
    width: 100%;
    min-height: auto;
    padding: 12px 14px;
    border-right: 0;
    border-bottom: 1px solid rgba(30, 64, 175, 0.08);
  }

  .admin-sidebar-nav {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 12px 0 4px;
  }

  .admin-sidebar-section {
    display: contents;
  }

  .admin-sidebar-section-label {
    display: none;
  }

  .admin-sidebar-link {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  .admin-sidebar-link-arrow,
  .admin-sidebar-user {
    display: none;
  }

  .admin-sidebar-heading {
    padding-bottom: 10px;
    border-bottom: 0;
  }

  .admin-dashboard-main {
    padding: 24px 18px 50px;
  }
}

/* =========================================================
   USEFECT ADMIN MANAGEMENT
   ========================================================= */

.admin-management-page {
  background:
    radial-gradient(circle at 85% 0%, rgba(37, 99, 235, 0.06), transparent 30%);
}

.admin-management-header {
  max-width: 1240px;
  margin: 0 auto 24px;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
}

.admin-management-header h1 {
  margin: 0;
  color: #172b4d;
  font-size: 34px;
  letter-spacing: -0.035em;
}

.admin-management-header p {
  max-width: 680px;
  margin: 10px 0 0;
  color: #78869a;
  font-size: 14px;
  line-height: 1.65;
}

.admin-management-primary-button,
.admin-management-secondary-button,
.admin-management-refresh {
  min-height: 42px;
  padding: 0 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  border-radius: 12px;
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
  transition: 160ms ease;
}

.admin-management-primary-button {
  color: #fff;
  border: 1px solid #2563eb;
  background: linear-gradient(145deg, #2563eb, #1747aa);
  box-shadow: 0 10px 24px rgba(37, 99, 235, 0.2);
}

.admin-management-primary-button:hover {
  transform: translateY(-1px);
  box-shadow: 0 14px 30px rgba(37, 99, 235, 0.25);
}

.admin-management-primary-button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
  transform: none;
}

.admin-management-secondary-button {
  color: #52647d;
  border: 1px solid #dce4ef;
  background: #fff;
}

.admin-management-refresh {
  color: #52647d;
  border: 1px solid #dce4ef;
  background: rgba(255, 255, 255, 0.8);
}

.admin-management-refresh:hover,
.admin-management-secondary-button:hover {
  border-color: #b9c8dc;
  background: #f8fbff;
}

.admin-management-summary {
  max-width: 1240px;
  margin: 0 auto 18px;
  display: flex;
  align-items: stretch;
  gap: 14px;
}

.admin-management-summary-card {
  min-width: 190px;
  padding: 16px 18px;
  display: flex;
  align-items: center;
  gap: 12px;
  border: 1px solid rgba(30, 64, 175, 0.08);
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.82);
}

.admin-management-summary-card svg {
  color: #2563eb;
}

.admin-management-summary-card strong,
.admin-management-summary-card span {
  display: block;
}

.admin-management-summary-card strong {
  color: #1d3150;
  font-size: 20px;
}

.admin-management-summary-card span {
  margin-top: 2px;
  color: #8996a8;
  font-size: 11px;
}

.admin-management-summary .admin-management-refresh {
  margin-left: auto;
}

.admin-management-table-card {
  max-width: 1240px;
  margin: 0 auto;
  overflow: hidden;
  border: 1px solid rgba(30, 64, 175, 0.08);
  border-radius: 22px;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 0 14px 40px rgba(30, 64, 175, 0.06);
}

.admin-management-table-heading {
  padding: 22px 24px;
  border-bottom: 1px solid #edf1f6;
}

.admin-management-table-heading h2 {
  margin: 0;
  color: #263750;
  font-size: 16px;
}

.admin-management-table-heading p {
  margin: 5px 0 0;
  color: #8a97a9;
  font-size: 12px;
}

.admin-management-list {
  display: flex;
  flex-direction: column;
}

.admin-management-row {
  min-height: 78px;
  padding: 14px 24px;
  display: grid;
  grid-template-columns: 42px minmax(0, 1fr) 120px 90px;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid #f0f3f7;
}

.admin-management-row:last-child {
  border-bottom: 0;
}

.admin-management-avatar {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  color: #2563eb;
  border-radius: 13px;
  background: #edf4ff;
  font-size: 14px;
  font-weight: 800;
}

.admin-management-identity {
  min-width: 0;
}

.admin-management-identity strong,
.admin-management-identity span {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.admin-management-identity strong {
  color: #263750;
  font-size: 13px;
}

.admin-management-identity span {
  margin-top: 4px;
  color: #8a97a9;
  font-size: 11px;
}

.admin-role-badge,
.admin-status-badge {
  width: fit-content;
  padding: 6px 9px;
  border-radius: 8px;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.06em;
}

.admin-role-super_admin {
  color: #8a6410;
  background: #fff7df;
}

.admin-role-admin {
  color: #1d5ac7;
  background: #edf4ff;
}

.admin-role-librarian {
  color: #26714d;
  background: #eaf8f0;
}

.admin-status-badge.active {
  color: #27704e;
  background: #eaf8f0;
}

.admin-status-badge.inactive {
  color: #8b5b5b;
  background: #faeeee;
}

.admin-management-empty {
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10px;
  color: #8b98aa;
  font-size: 13px;
}

.admin-management-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 100;
  padding: 24px;
  display: grid;
  place-items: center;
  background: rgba(12, 25, 48, 0.42);
  backdrop-filter: blur(8px);
}

.admin-management-modal {
  width: min(560px, 100%);
  max-height: calc(100vh - 48px);
  overflow: auto;
  border: 1px solid rgba(255, 255, 255, 0.7);
  border-radius: 24px;
  background: #fff;
  box-shadow: 0 30px 80px rgba(12, 30, 60, 0.22);
}

.admin-management-modal-header {
  padding: 25px 26px 18px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-bottom: 1px solid #edf1f6;
}

.admin-management-modal-header h2 {
  margin: 0;
  color: #1e3150;
  font-size: 22px;
}

.admin-management-modal-header p {
  margin: 7px 0 0;
  color: #8996a8;
  font-size: 12px;
}

.admin-management-close {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  flex: 0 0 36px;
  color: #758397;
  border: 1px solid #e3e9f1;
  border-radius: 10px;
  background: #fff;
  cursor: pointer;
}

.admin-management-form {
  padding: 24px 26px 26px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 17px;
}

.admin-management-form label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  color: #52647d;
  font-size: 11px;
  font-weight: 750;
}

.admin-management-form label:first-child {
  grid-column: 1 / -1;
}

.admin-management-form input,
.admin-management-form select {
  width: 100%;
  min-height: 43px;
  padding: 0 12px;
  box-sizing: border-box;
  color: #263750;
  border: 1px solid #dce4ef;
  border-radius: 11px;
  outline: none;
  background: #fbfcfe;
  font: inherit;
  font-size: 13px;
}

.admin-management-form input:focus,
.admin-management-form select:focus {
  border-color: #6c98e8;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.admin-management-form-actions {
  grid-column: 1 / -1;
  padding-top: 8px;
  display: flex;
  justify-content: flex-end;
  gap: 10px;
}

.admin-spin {
  animation: admin-spin 0.9s linear infinite;
}

@keyframes admin-spin {
  to {
    transform: rotate(360deg);
  }
}

@media (max-width: 760px) {
  .admin-management-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .admin-management-summary {
    flex-wrap: wrap;
  }

  .admin-management-summary .admin-management-refresh {
    margin-left: 0;
  }

  .admin-management-row {
    grid-template-columns: 42px minmax(0, 1fr);
  }

  .admin-role-badge,
  .admin-status-badge {
    grid-column: 2;
  }

  .admin-management-form {
    grid-template-columns: 1fr;
  }

  .admin-management-form label:first-child,
  .admin-management-form-actions {
    grid-column: auto;
  }
}

/* USEFECT Admin Management — action controls */
.admin-management-actions {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: auto;
}

.admin-management-actions button {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(31, 78, 121, 0.12);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  cursor: pointer;
  transition:
    transform 0.18s ease,
    background 0.18s ease,
    color 0.18s ease,
    border-color 0.18s ease;
}

.admin-management-actions button:hover {
  transform: translateY(-1px);
  background: #f4f8fc;
  color: #1557a6;
  border-color: rgba(21, 87, 166, 0.2);
}

.admin-management-actions button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

.admin-management-modal .admin-management-form > p {
  margin: 0;
  color: #64748b;
  line-height: 1.65;
}

@media (max-width: 900px) {
  .admin-management-actions {
    width: 100%;
    margin-left: 0;
    padding-top: 8px;
  }
}
